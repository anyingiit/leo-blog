}

.more-settings-cache-label {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 4px;
}

.more-settings-cache-size {
  color: #999999;
}

.more-settings-cache-clean-link {
  color: #ea4c89;
  text-decoration: none;
  white-space: nowrap;
}

.more-settings-cache-clean-link:hover {
  text-decoration: underline;
}

.more-settings-clean-cache-toast {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2147483647;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 112px;
  height: 32px;
  padding: 8px 16px;
  box-sizing: border-box;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.8);
  color: #ffffff;
  font-size: 14px;
  font-weight: 400;
  line-height: 18px;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.more-settings-clean-cache-toast-icon {
  position: relative;
  width: 16px;
  height: 16px;
  flex: 0 0 16px;
  border-radius: 50%;
  background: #1fc16b;
}

.more-settings-clean-cache-toast-icon::after {
  content: "";
  position: absolute;
  left: 4px;
  top: 4px;
  width: 7px;
  height: 4px;
  border-left: 1.5px solid #ffffff;
  border-bottom: 1.5px solid #ffffff;
  transform: rotate(-45deg);
}

.more-settings-clean-cache-toast-text {
  white-space: nowrap;
}

[data-theme="dark"] .more-settings-cache-size {
  color: #8a8a8a;
}

[data-theme="dark"] .more-settings-feature-card {
  background-color: #2a2a2a;
}

[data-theme="dark"] .more-settings-feature-card:hover {
  background-color: #333333;
}

[data-theme="dark"] .more-settings-feature-card:active {
  background-color: #3a3a3a;
}

[data-theme="dark"] .more-settings-feature-card-label {
  color: #e0e0e0;
}

/* &#21160;&#20316;&#25353;&#38062;&#26679;&#24335; */
.more-settings-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 40px;
  padding: 0 12px;
  color: #222222;
  background-color: #f3f5f6;
  border-radius: 12px;
