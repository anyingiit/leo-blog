    2px 2px 3.5px rgba(0, 0, 0, 0.4),
    inset 0.5px 0.7px 0.4px rgba(255, 255, 255, 0.5),
    inset -0.5px -0.5px 0.2px rgba(0, 0, 0, 0.6);
}

