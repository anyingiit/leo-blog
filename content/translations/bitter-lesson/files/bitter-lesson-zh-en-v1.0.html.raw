/* ========== &#26356;&#22810;&#35774;&#32622;&#25277;&#23625;&#26679;&#24335; ========== */
.more-settings-drawer {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.more-settings-quick-actions {
  display: flex;
  gap: 8px;
}

.more-settings-feature-card {
  flex: 1 1 0;
  min-width: 0;
  height: 40px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 12px;
  cursor: pointer;
  background-color: #f3f5f6;
  transition: background-color 0.2s ease;
}

.more-settings-feature-card:hover {
  background-color: #e8eaec;
}

.more-settings-feature-card:active {
  background-color: #dde0e2;
}

.more-settings-feature-card-label {
  font-size: 12px;
  font-weight: 400;
  line-height: 18px;
  color: #666666;
  white-space: nowrap;
}

.more-settings-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.more-settings-switch-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 21px;
