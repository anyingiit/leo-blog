}

.more-settings-switch-label {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  font-weight: 400;
  line-height: 21px;
  color: #222222;
  white-space: normal;
  word-break: break-word;
}

.more-settings-switch-row input[type="checkbox"] {
  flex-shrink: 0;
  margin-top: 2px;
}

[data-theme="dark"] .more-settings-switch-label {
