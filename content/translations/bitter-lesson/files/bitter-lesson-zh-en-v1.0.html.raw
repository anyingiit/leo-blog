/* dark use #18232c */
@media (prefers-color-scheme: dark) {
  .text-label {
    color: #9ca3af;
  }
}

.text-decoration-none {
  text-decoration: none;
}

.text-decoration-none:is([aria-current], :hover, :active, :focus),
[role="link"]:is([aria-current], :hover, :active, :focus) {
  --text-decoration: none !important;
  background-color: transparent !important;
}

.text-overflow-ellipsis {
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}

.max-w-20 {
  max-width: 180px;
  white-space: nowrap;
}

[data-theme="light"],
#mount:not([data-theme="dark"]) {
  --popup-footer-background-color: #e8eaeb;
  --popup-content-background-color: #ffffff;
  --popup-item-background-color: #f3f5f6;
  --popup-item-hover-background-color: #eaeced;
  --popup-trial-pro-background-color: #f9fbfc;
  --service-select-content-shadow: 0px 2px 12px 0px rgba(75, 76, 77, 0.2);
  --service-select-border-color: #fafafa;
  --service-select-selected-background-color: #f3f5f6;
  --download-app-background: #f3f5f6;
  --translate-language-background-color: #f3f5f6;
  --translate-language-icon-color: #666666;
  --translate-language-text-color: #222222;
  --translate-language-hover-background-color: #fdedf3;
  --translate-language-hover-icon-color: #e95d93;
  --popup-scrollbar-thumb-color: var(--c-c7);
  --popup-scrollbar-thumb-hover-color: var(--c-99);
  --popup-scrollbar-thumb-active-color: var(--p-main);
  --error-bg: #fdedf3;
  --error-text: #222;
  --error-link: #ea4c89;
  --membership-prompt-background-color: #ffffff;
  --membership-prompt-muted-background-color: #f3f5f6;
  --membership-prompt-text-color: #333333;
  --membership-prompt-secondary-text-color: #666666;
  --membership-prompt-banner-opacity: 1;
}

[data-theme="dark"] {
  --popup-footer-background-color: #0d0d0d;
  --popup-content-background-color: #191919;
  --popup-item-background-color: #272727;
  --popup-item-hover-background-color: #333333;
  --popup-trial-pro-background-color: #222222;
  --service-select-content-shadow: 0px 2px 12px 0px rgba(0, 0, 0, 0.9);
  --service-select-border-color: #2c2c2c;
  --service-select-selected-background-color: #333333;
  --download-app-background: #333;
  --translate-language-background-color: #2d2e2f;
  --translate-language-icon-color: #b3b3b3;
  --translate-language-text-color: #b3b3b3;
  --translate-language-hover-background-color: #a97b8c;
  --translate-language-hover-icon-color: rgba(255, 255, 255, 0.9);
  --popup-scrollbar-thumb-color: var(--c-c7);
  --popup-scrollbar-thumb-hover-color: var(--c-99);
  --popup-scrollbar-thumb-active-color: var(--p-main);
  --error-bg: #26171d;
  --error-text: #dbdbdb;
  --error-link: #ea4c89;
  --membership-prompt-background-color: #222222;
  --membership-prompt-muted-background-color: #222222;
  --membership-prompt-text-color: #dbdbdb;
  --membership-prompt-secondary-text-color: #b3b3b3;
  --membership-prompt-banner-opacity: 0.9;
}

#mount {
  min-width: 268px;
}

body {
  padding: 0;
  margin: 0 auto;
  min-width: 268px;
  border-radius: 10px;
}

/*
 * Chrome action popup &#21487;&#33021;&#22312; popup.js &#25346;&#36733; 316px &#19994;&#21153;&#26681;&#33410;&#28857;&#21069;&#27979;&#37327;&#25991;&#26723;&#12290;
 * &#35813;&#38745;&#24577;&#22771;&#21482;&#20316;&#29992;&#20110;&#21516;&#27493;&#35782;&#21035;&#20986;&#30340;&#26700;&#38754; Chrome&#65292;Safari &#21644;&#31227;&#21160;&#31471;&#32487;&#32493;&#27839;&#29992;&#21407;&#24067;&#23616;&#12290;
 */
html[data-popup-layout="chrome-desktop"],
html[data-popup-layout="chrome-desktop"] body,
html[data-popup-layout="chrome-desktop"] #mount {
  box-sizing: border-box;
  width: 316px;
  min-width: 316px;
  max-width: 316px;
}

html[data-popup-layout="chrome-desktop"] #mount:empty {
  min-height: 506px;
  border-radius: 10px;
  background: #f3f5f6;
}

@media (prefers-color-scheme: dark) {
  html[data-popup-layout="chrome-desktop"] #mount:empty {
    background: #191919;
  }
}

.popup-container {
  font-size: 16px;
  --font-size: 16px;
  color: #666;
  background-color: var(--popup-footer-background-color);
  width: 316px;
  min-width: 316px;
  position: relative;
  overflow: hidden;
}

.popup-content {
  background-color: var(--popup-content-background-color);
  border-radius: 0px 0px 12px 12px;
  padding: 14px 16px;
}

.popup-presentation--inert {
  max-height: 599px;
  color: var(--translate-language-text-color);
  pointer-events: none;
}

.popup-presentation--inert button {
  cursor: default;
  opacity: 1;
}

.popup-presentation--inert .main-button {
  color: #ffffff;
  background-color: var(--p-main, #ec4c8c);
}

.popup-presentation--inert .widget-item {
  cursor: default;
}

.popup-userscript-three-feature-layout {
  background-color: var(--popup-footer-background-color);
}

.popup-userscript-three-feature-layout .popup-content {
  padding-bottom: 20px;
  border-radius: 0 0 12px 12px;
}

.popup-userscript-three-feature-layout .popup-footer {
  border-radius: 0;
}

.immersive-translate-popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  touch-action: none;
}

.immersive-translate-popup-wrapper {
  background: var(--background-color);
  border-radius: 10px;
  border: 1px solid var(--muted-border-color);
}

.main-button {
  font-size: 16px;
  font-weight: 700;
  vertical-align: middle;
  border-radius: 12px;
  padding: unset;
  height: 48px;
  line-height: 48px;
  flex: 1;
}

select.translate-service,
select.min-select {
  --form-element-spacing-horizontal: 0;
  margin-bottom: 0px;
  max-width: unset;
  flex: 1;
  overflow: hidden;
  font-size: 13px;
  border: none;
  border-radius: 8px;
  padding-right: 30px;
  padding-left: 0px;
  background-position: center right 12px;
  background-size: 16px auto;
  background-image: var(--icon-xia);
  text-overflow: ellipsis;
  color: var(--text-gray-2);
  background-color: transparent;
  box-shadow: unset !important;
  cursor: pointer;
}

select.more {
  background-position: center right;
  padding-right: 20px;
}

select.translate-service {
  color: var(--text-black-2);
  background-image: url("data:image/svg+xml;base64,");
  background-size: 8px auto;
}

.min-select-container.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.popup-footer {
  background-color: var(--popup-footer-background-color);
  height: 40px;
  display: flex;
  align-items: center;
}

/* Footer &#19977;&#26639;&#24067;&#23616;&#26679;&#24335; */
.footer-link-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  min-width: 72px;
}

.footer-icon-btn {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.footer-icon-btn svg {
  color: #999999;
}

[data-theme="dark"] .footer-icon-btn svg {
  color: #707070;
}

.footer-link-text {
  font-size: 12px;
  line-height: 18px;
  color: #666666;
  white-space: nowrap;
}

[data-theme="dark"] .footer-link-text {
  color: #b3b3b3;
}

.footer-link-btn-right {
  justify-content: flex-end;
}

.footer-center-text {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #999999;
  line-height: 1;
  white-space: nowrap;
}

.footer-center-text.is-overflowing {
  justify-content: flex-start;
}

.footer-center-text.is-overflowing .footer-center-content {
  animation: footer-scroll-text 12s linear infinite;
}

@keyframes footer-scroll-text {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

.footer-center-content {
  display: inline-flex;
  align-items: center;
}

.footer-scroll-gap {
  display: inline-block;
  width: 80px;
  flex-shrink: 0;
}

[data-theme="dark"] .footer-center-text {
  color: #707070;
}

.footer-text-content {
  display: inline-block;
}

.footer-privacy-link {
  white-space: normal;
  text-align: center;
  line-height: 1.3;
  max-width: 100%;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: inherit;
  text-decoration: none;
}

.footer-version-inline-text {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  border: 0;
  background: transparent;
  font-family: inherit;
  font-size: 12px;
  color: #999999;
  line-height: 1;
  border-bottom: 1px solid transparent;
}

.footer-release-new-badge {
  width: 28px;
  height: 16px;
  flex-shrink: 0;
}

[data-theme="dark"] .footer-version-inline-text {
  color: #707070;
}

.footer-version-inline-text:hover {
  background-color: transparent;
}

.translate-language-row {
  gap: 4px;
}

.translate-language-exchange {
  width: 36px;
  height: 48px;
  background-color: var(--translate-language-background-color);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--translate-language-icon-color);
  flex-shrink: 0;
  cursor: pointer;
  margin-right: 8px;
}

.translate-language-exchange:hover {
  color: var(--translate-language-hover-icon-color);
}

.translate-language-exchange-active {
  background-color: var(--translate-language-hover-background-color);
  color: var(--translate-language-hover-icon-color);
}

.translate-language-exchange-active:hover {
  background-color: var(--translate-language-hover-background-color);
  color: var(--translate-language-hover-icon-color);
}

.translate-language-arrow {
  width: 24px;
  height: 24px;
  margin: 0;
}

.translation-service-container {
  background-color: var(--popup-item-background-color);
  border-radius: 12px;
}

/* &#22522;&#30784;&#32763;&#35793;&#27169;&#24335;&#20165;&#24369;&#21270;&#24050;&#36873;&#26381;&#21153;&#30340;&#22270;&#26631;&#12289;&#21517;&#31216;&#21644;&#31661;&#22836;&#65292;&#26631;&#31614;&#21450;&#22806;&#23618;&#21306;&#22495;&#20445;&#25345;&#27491;&#24120;&#12290; */
.translation-service-control--basic {
  filter: grayscale(0.65);
  opacity: 0.55;
}

.translation-service-primary-field {
  position: relative;
}

.translation-service-primary-field .custom-select-container {
  min-width: 0;
}

.translation-service-primary-field #translation-service-select > svg {
  flex-shrink: 0;
}

.translation-service-guide-hitbox {
  position: absolute;
  right: 46px;
  top: 0;
  width: 1px;
  height: 1px;
  pointer-events: auto;
}

.min-select-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 44px;
  background-color: var(--popup-item-background-color);
  padding-left: 16px;
}

.min-select-container:first-child {
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
}

.min-select-container:last-child {
  border-bottom-left-radius: 10px;
  border-bottom-right-radius: 10px;
}

.min-select-container:only-child {
  border-radius: 10px;
}

.popup-ai-context-label {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 60px;
  flex-shrink: 0;
  margin-bottom: 0;
}

.popup-ai-context-switch {
  align-self: center;
  margin: 0;
  margin-inline-end: 12px;
}

.translate-mode {
  width: 36px;
  height: 48px;
  border-radius: 12px;
  background-color: var(--translate-language-background-color);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
  color: var(--translate-language-text-color);
  margin-right: 8px;
}

.translate-mode[aria-disabled="true"] {
  cursor: default;
  opacity: 0.5;
}

/* &#24555;&#25463;&#25805;&#20316;&#35774;&#32622;&#26631;&#39064;&#26639; */
.widgets-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0 4px;
  margin-top: 20px;
  margin-bottom: 12px;
  font-size: 12px;
  line-height: 18px;
}

.widgets-header-title {
  color: #999999;
}

.widgets-header-action {
  color: #999999;
  text-decoration: underline;
  cursor: pointer;
}

.widgets-header-action:hover {
  color: #666666;
}

.widgets-container {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  width: 100%;
  gap: 8px;
  margin-top: 14px;
}

.popup-userscript-three-feature-layout .widgets-container-compact-monkey {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 12px;
}

.popup-userscript-three-feature-layout .widgets-container-compact-monkey.widgets-four-items {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.widgets-container.widgets-single-item {
  grid-template-columns: minmax(0, 1fr);
  margin-top: 12px;
}

.widgets-container.widgets-single-item .widget-item {
  max-width: none;
}

/* &#24403;&#21482;&#26377;&#20004;&#20010;&#23567;&#32452;&#20214;&#26102;&#30340;&#26679;&#24335;&#20248;&#21270; */
.widgets-container.widgets-two-items {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.widgets-container.widgets-two-items .widget-item {
  max-width: none;
}

.widgets-container.widgets-four-items .widget-item {
  justify-content: flex-start;
}

.widget-item {
  display: flex;
  width: 100%;
  min-height: 44px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  border: 1px solid #eef0f2;
  box-sizing: border-box;
  font-size: 14px;
  border-radius: 12px;
  cursor: pointer;
  padding: 0 14px;
  text-align: left;
  gap: 6px;
}

.widget-item.widget-item-single {
  flex: 1 1 auto;
  flex-direction: row;
  justify-content: center;
  border: 1px solid #eef0f2;
  border-radius: 16px;
  padding: 0 14px;
  background: transparent;
}

.popup-userscript-three-feature-layout .widget-item-compact {
  min-height: 44px;
  flex-direction: row;
  justify-content: center;
  gap: 6px;
  padding: 0 12px;
}

.widget-item svg {
  width: 24px;
  height: 24px;
  flex: 0 0 24px;
}

.widget-item > svg,
.widget-item > .widget-icon-text {
  opacity: 0.8;
  transition: opacity 160ms ease-out;
}

.widget-item:hover > svg,
.widget-item:hover > .widget-icon-text {
  opacity: 1;
}

@media (prefers-reduced-motion: reduce) {
  .widget-item > svg,
  .widget-item > .widget-icon-text {
    transition: none;
  }
}

.widget-icon-text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--c-66, #666666);
  font-size: 14px;
  line-height: 21px;
  text-align: left;
  word-break: keep-all;
}

.popup-userscript-three-feature-layout .widget-item-compact .widget-icon-text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 14px;
  line-height: 21px;
  text-align: left;
}

.widget-item.widget-item-single .widget-icon-text {
  white-space: nowrap;
  text-align: left;
  color: var(--c-66, #666666);
}

[data-theme="dark"] .widget-item,
[data-theme="dark"] .widget-item.widget-item-single {
  border-color: #2e2e2e;
}

[data-theme="dark"] .widget-icon-text,
[data-theme="dark"] .widget-item.widget-item-single .widget-icon-text {
  color: var(--c-66, #666666);
}

[data-theme="dark"] .more-settings-icon {
  fill: #191919;
}

.share-button-container {
  display: flex;
  align-items: center;
  cursor: pointer;
  padding: 2px 3px 0 8px;
}

.share-button-container svg {
  fill: var(--text-gray-9);
}

.min-select-container:hover {
  background-color: var(--popup-item-hover-background-color);
}

.widget-item:hover {
  background-color: color-mix(
    in srgb,
    var(--popup-item-hover-background-color) 60%,
    transparent
  );
}

.main-button:hover {
  background-color: #f5508f;
}

.share-button-container:hover {
  background-color: var(--popup-item-background-color);
  border-radius: 6px;
}

.error-boundary {
  background: #fff2f0;
  border: 1px solid #ffccc7;
  display: flex;
  padding: 12px;
  font-size: 14px;
  color: rgba(0, 0, 0, 0.88);
  word-break: break-all;
  margin: 12px;
  border-radius: 12px;
  flex-direction: column;
}

.upgrade-pro {
  border-radius: 11px;
  background: linear-gradient(57deg, #272727 19.8%, #696969 82.2%);
  padding: 2px 8px;
  transform: scale(0.85);
}

.upgrade-pro span {
  background: linear-gradient(180deg, #ffeab4 17.65%, #f8c235 85.29%);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-size: 12px;
  margin-left: 4px;
}

.upgrade-pro svg {
  margin-top: -2px;
}

.upgrade-pro:hover {
  background: linear-gradient(57deg, #3d3d3d 19.8%, #949494 82.2%);
}

.border-bottom-radius-0 {
  border-bottom-left-radius: 0 !important;
  border-bottom-right-radius: 0 !important;
}

.trial-pro-container {
  border-radius: 0px 0px 12px 12px;
  background: var(--popup-trial-pro-background-color);
  display: flex;
  align-items: center;
  height: 44px;
  padding-left: 16px;
  padding-right: 12px;
  font-size: 12px;
}

.trial-pro-container label {
  line-height: 13px;
  color: var(--text-black-2);
}

.trial-pro-container img {
  margin-left: 5px;
}

.cursor-pointer {
  cursor: pointer;
}

.upgrade-pro-discount-act {
  height: 25px;
  display: flex;
  padding: 0 4px;
  align-items: center;
  border-radius: 15px;
  background: linear-gradient(
    90deg,
    #cefbfa 11.33%,
    #d7f56f 63.75%,
    #fccd5e 100%
  );
  transform: scale(0.9);
  box-shadow: 0px 1.8px 3.6px 0px rgba(0, 0, 0, 0.1);
  cursor: pointer;
}

.upgrade-pro-discount-act span {
  font-size: 12px;
  font-weight: 700;
  margin-left: 4px;
  color: #222222;
}

.upgrade-pro-discount-act:hover {
  text-decoration: unset;
  background: linear-gradient(
    90deg,
    #e2fffe 11.33%,
    #e6ff91 63.75%,
    #ffdf93 100%
  );
}

.custom-select-container {
  width: 200px;
  position: relative;
  flex: 1;
}

#translation-service-select {
  padding-right: 12px;
}

.custom-select-content {
  border-radius: 12px;
  background: var(--popup-content-background-color);
  box-shadow: var(--service-select-content-shadow);
  border: 1px solid var(--service-select-border-color);
  padding: 8px;
  position: absolute;
  left: -68px;
  right: 0;
  z-index: 1000;
  overflow-y: auto;
}

.custom-select-item.default {
  width: 100%;
  padding: 0;
}

.custom-select-item {
  font-size: 14px;
  padding: 5px 8px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  cursor: pointer;
  color: var(--text-black-2);
  width: auto;
  overflow: hidden;
  height: 30px;
  line-height: 30px;
}

.custom-select-item-img {
  width: 24px;
  height: 24px;
  margin-right: 8px;
}

@media (prefers-color-scheme: dark) {
  .custom-select-item-img {
    margin-right: 6px;
  }
}

.custom-select-content .custom-select-item.selected,
.custom-select-content .custom-select-item:hover {
  background: var(--service-select-selected-background-color);
}

.custom-select-item > span {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.custom-select-item-pro {
  font-size: 12px;
  margin-left: 6px;
  display: flex;
}

.custom-select-item-pro img {
  margin: 0 3px;
  width: 20px;
  flex-shrink: 0;
}

.service-select-inline-sponsor-container {
  width: 50px;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.service-select-inline-sponsor-marquee {
  min-width: max-content;
  display: inline-flex;
  align-items: center;
  column-gap: 12px;
  animation: service-select-inline-sponsor-scroll 10s linear infinite;
}

.service-select-inline-sponsor-track {
  min-width: max-content;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

@keyframes service-select-inline-sponsor-scroll {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(calc(-50% - 6px));
  }
}

.custom-select-group-header {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-gray-9);
  padding: 8px 8px 6px;
  margin-top: 2px;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.custom-select-group-header--recommendation {
  padding-top: 4px;
}

.custom-select-group-header-tip {
  display: inline-flex;
  align-items: center;
  color: #bcbcbc;
  cursor: pointer;
  line-height: 0;
}

.more-container {
  position: relative;
}

.new-menu-indicator {
  position: absolute;
  width: 8px;
  height: 8px;
  background-color: #ef3434;
  border-radius: 50%;
  right: 18px;
  top: 4px;
}

.download-app {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border-radius: 8px;
  background: var(--download-app-background);
  padding: 4px 8px;
  color: var(--text-gray-6);
  font-size: 12px;
  cursor: pointer;
  transition: all 0.2s ease-in-out;
}

/* Popup &#21160;&#30011;&#25928;&#26524; */
@keyframes popup-fade-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes popup-fade-out {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  to {
    opacity: 0;
    transform: translateY(10px) scale(0.95);
  }
}

.popup-generic-content {
  animation: popup-fade-in 0.2s ease-out;
}

.popup-generic-content.hiding {
  animation: popup-fade-out 0.15s ease-in;
}

select.min-select {
  --form-element-spacing-horizontal: 0;
  max-width: 128px;
  overflow: hidden;
  color: var(--primary);
  font-size: 13px;
  border: none;
  padding: 0;
  padding-right: 20px;
  text-overflow: ellipsis;
  color: var(--color);
}
select.min-select-secondary {
  color: var(--color);
}
select.min-select:focus {
  outline: none;
  border: none;
  --box-shadow: none;
}

select.min-select-left {
  padding-right: 0px;
  /* padding-left: 24px; */
  /* background-position: center left 0; */
  text-overflow: ellipsis;
  text-align: left;
}

select.transform-padding-left {
  padding-left: 12px;
  transform: translateX(-12px);
  background-position: center right 0px;
}

select.text-gray-6 {
  color: var(--text-gray-6);
}

/* dark use black, for windows */
@media (prefers-color-scheme: dark) {
  select.translate-service option,
  select.min-select option {
    background-color: #666666;
  }
}

select.min-select-no-arrow {
  background-image: none;
  padding-right: 0;
}

.activity-tips {
  border-radius: 8px;
  padding: 0px 8px;
  height: 26px;
  background: linear-gradient(
    83deg,
    #faccde -0.87%,
    #fce7ef 43.13%,
    #fbd6e4 72.08%,
    #ffb3d1 96.34%
  );
  color: #333;
  cursor: pointer;
  gap: 4px;
  font-size: 12px;
}

.activity-tips-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.countdown-container {
  min-width: 50px;
  text-align: left;
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.01em;
}

.activity-tips-text {
  font-weight: 600;
  max-width: 100px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* &#38750;&#20250;&#21592;&#21319;&#32423;&#25552;&#31034; */
.upgrade-tips {
  padding: 0px 6px 0px 4px;
  height: 18px;
  color: #ea4c89;
  cursor: pointer;
  gap: 6px;
  font-size: 12px;
  line-height: 18px;
}

.upgrade-tips svg:first-child {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  filter: drop-shadow(0px 4px 4px rgba(236, 76, 140, 0.2));
}

.upgrade-tips-text {
  font-weight: 500;
  white-space: nowrap;
}

.upgrade-tips-switch {
  position: relative;
  width: 30px;
  height: 18px;
  border-radius: 24px;
  background: #cccccc;
  flex-shrink: 0;
}

.upgrade-tips-switch-thumb {
  position: absolute;
  width: 14px;
  height: 14px;
  top: 2px;
  left: 2px;
  border-radius: 50%;
  background: #ffffff;
}

/* &#25277;&#23625;&#32452;&#20214;&#26679;&#24335; */
.drawer-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition:
    opacity 0.25s ease,
    visibility 0.25s ease;
}

.drawer-overlay.drawer-visible {
  opacity: 1;
  visibility: visible;
}

.drawer-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 12px 12px 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.drawer-visible .drawer-panel {
  transform: translateY(0);
}

.select-drawer-overlay,
.more-settings-drawer-overlay {
  transition-duration: 0.15s;
}

.select-drawer-overlay .drawer-panel,
.more-settings-drawer-overlay .drawer-panel {
  transition-duration: 0.2s;
}

[data-theme="dark"] .drawer-panel {
  background: #222222;
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  flex-shrink: 0;
}

.drawer-title {
  font-size: 16px;
  font-weight: 700;
  color: #333333;
}

[data-theme="dark"] .drawer-title {
  color: #e0e0e0;
}

.drawer-close {
  width: 24px;
  height: 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  border-radius: 4px;
  transition: background-color 0.2s ease;
}

.drawer-close:hover {
  background-color: #f3f5f6;
}

[data-theme="dark"] .drawer-close:hover {
  background-color: #333333;
}

[data-theme="dark"] .membership-prompt-drawer .drawer-title {
  color: var(--membership-prompt-text-color);
}

[data-theme="dark"] .membership-prompt-drawer .drawer-close path {
  stroke: #666666;
}

.drawer-body {
  padding: 16px 20px;
  overflow-y: auto;
  min-height: 0;
  flex: 1;
}

.drawer-body-membership-prompt {
  padding: 0 16px 16px;
  overflow: hidden;
}

/*
 * Popup &#25277;&#23625;&#28378;&#21160;&#26465;&#65306;&#40664;&#35748;&#20445;&#25345;&#20302;&#23545;&#27604;&#65292;&#24748;&#20572;&#26102;&#22686;&#24378;&#21487;&#35265;&#24615;&#65292;&#25302;&#21160;&#26102;&#25165;&#20351;&#29992;&#21697;&#29260;&#33394;&#12290;
 * &#36712;&#36947;&#36879;&#26126;&#65292;&#36991;&#20813;&#22312; 316px &#30340;&#32039;&#20945;&#24037;&#20316;&#21306;&#20869;&#24418;&#25104;&#39069;&#22806;&#30340;&#35270;&#35273;&#20998;&#26639;&#12290;
 */
.drawer-body-hover > .popup-drawer-container,
.drawer-body-selection > .popup-drawer-container,
.drawer-body-more-settings > .more-settings-drawer,
.service-select-drawer-content {
  scrollbar-color: var(--popup-scrollbar-thumb-color) transparent;
  scrollbar-width: thin;
  overscroll-behavior-y: contain;
}

.drawer-body-hover > .popup-drawer-container::-webkit-scrollbar,
.drawer-body-selection > .popup-drawer-container::-webkit-scrollbar,
.drawer-body-more-settings > .more-settings-drawer::-webkit-scrollbar,
.service-select-drawer-content::-webkit-scrollbar {
  display: block;
  width: 6px;
  height: 6px;
}

.drawer-body-hover > .popup-drawer-container::-webkit-scrollbar-track,
.drawer-body-selection > .popup-drawer-container::-webkit-scrollbar-track,
.drawer-body-more-settings > .more-settings-drawer::-webkit-scrollbar-track,
.service-select-drawer-content::-webkit-scrollbar-track {
  background: transparent;
}

.drawer-body-hover > .popup-drawer-container::-webkit-scrollbar-thumb,
.drawer-body-selection > .popup-drawer-container::-webkit-scrollbar-thumb,
.drawer-body-more-settings > .more-settings-drawer::-webkit-scrollbar-thumb,
.service-select-drawer-content::-webkit-scrollbar-thumb {
  min-height: 32px;
  background-color: var(--popup-scrollbar-thumb-color);
  background-clip: padding-box;
  border: 1px solid transparent;
  border-radius: 999px;
}

.drawer-body-hover > .popup-drawer-container::-webkit-scrollbar-thumb:hover,
.drawer-body-selection > .popup-drawer-container::-webkit-scrollbar-thumb:hover,
.drawer-body-more-settings > .more-settings-drawer::-webkit-scrollbar-thumb:hover,
.service-select-drawer-content::-webkit-scrollbar-thumb:hover {
  background-color: var(--popup-scrollbar-thumb-hover-color);
}

.drawer-body-hover > .popup-drawer-container::-webkit-scrollbar-thumb:active,
.drawer-body-selection > .popup-drawer-container::-webkit-scrollbar-thumb:active,
.drawer-body-more-settings > .more-settings-drawer::-webkit-scrollbar-thumb:active,
.service-select-drawer-content::-webkit-scrollbar-thumb:active {
  background-color: var(--popup-scrollbar-thumb-active-color);
}

.drawer-body.drawer-body-hover {
  padding: 0 12px;
  display: flex;
  overflow: hidden;
  flex: 1;
}

.drawer-body.drawer-body-more-settings {
  padding: 0 12px;
  display: flex;
  overflow: hidden;
}

.drawer-body-hover > .popup-drawer-container,
.drawer-body-selection > .popup-drawer-container,
.drawer-body-more-settings > .more-settings-drawer {
  width: 100%;
  min-height: 0;
  padding-inline: 8px;
  flex: 1 1 auto;
  overflow-y: auto;
}

.drawer-body-hover > .popup-drawer-container,
.drawer-body-selection > .popup-drawer-container {
  padding-block-end: 20px;
}

.drawer-body-more-settings > .more-settings-drawer {
  padding-block-end: 16px;
}

.drawer-body-hover > .popup-drawer-container > *,
.drawer-body-selection > .popup-drawer-container > *,
.drawer-body-more-settings > .more-settings-drawer > * {
  flex-shrink: 0;
}

/* Popup &#26680;&#24515;&#36873;&#25321;&#22120;&#65306;&#27839;&#29992;&#36890;&#29992;&#24213;&#37096;&#25277;&#23625;&#65292;&#20165;&#26367;&#25442;&#23637;&#24320;&#23481;&#22120;&#12290; */
.drawer-panel.select-drawer-panel {
  max-height: 90%;
  background: var(--popup-content-background-color);
}

.select-drawer-panel .drawer-header {
  padding: 16px 16px 12px;
}

.service-select-drawer-panel .drawer-header {
  padding: 16px;
}

.drawer-body.select-drawer-body {
  min-height: 0;
  padding: 0 12px 12px;
  display: flex;
  overflow: hidden;
}

.drawer-body.service-select-drawer-body {
  padding: 4px 12px 12px;
}

.service-select-drawer-content {
  position: static;
  inset: auto;
  width: 100%;
  flex: 1 1 auto;
  min-height: 0;
  max-height: none;
  padding: 0;
  overflow-y: auto;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.service-select-drawer-content .custom-select-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.service-select-drawer-content .custom-select-group +
  .custom-select-group {
  margin-top: 12px;
}

.service-select-drawer-content .custom-select-group--recommendation {
  gap: 6px;
}

.service-select-drawer-content .custom-select-group-header {
  min-height: 18px;
  margin: 0;
  padding: 0 4px;
  gap: 4px;
  color: #999999;
  font-size: 12px;
  font-weight: 400;
  line-height: 18px;
  letter-spacing: 0;
}

.service-select-drawer-content
  .custom-select-group-header--recommendation {
  min-width: 0;
  padding: 0;
}

.service-select-drawer-content .custom-select-group-header-badge {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-width: 0;
  gap: var(--space-4);
  padding: 2px 8px 2px 6px;
  color: var(--p-main);
  font-size: 12px;
  font-weight: 400;
  line-height: 18px;
  background: var(--p-weak);
  border-radius: 100px;
}

.service-select-drawer-content .service-recommendation-badge-icon {
  display: block;
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

.service-select-drawer-content .custom-select-group-header-badge-text {
  flex-shrink: 0;
}

.service-select-drawer-content .custom-select-group-header-context {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-select-drawer-content
  .custom-select-group-header-tip--recommendation {
  flex-shrink: 0;
}

.service-select-drawer-content
  .service-recommendation-tip-icon {
  display: block;
  width: 16px;
  height: 16px;
}

.service-select-drawer-content .custom-select-item {
  width: 100%;
  min-height: 34px;
  height: auto;
  padding: 5px 8px;
  line-height: 20px;
}

.service-select-drawer-content .custom-select-item.selected {
  background: var(--p-weak);
}

.service-select-drawer-content .custom-select-item-membership-badge {
  margin-left: 2px;
}

.service-select-drawer-content .custom-select-item-membership-badge img {
  width: 24px;
  height: 12px;
  margin: 0;
}

.service-select-drawer-content .custom-select-item:focus-visible {
  outline: 2px solid var(--p-main);
  outline-offset: -2px;
}

@media (prefers-reduced-motion: reduce) {
  .select-drawer-overlay,
  .select-drawer-overlay .drawer-panel {
    transition-duration: 0.01ms;
  }
}

.drawer-footer {
  padding: 12px 20px;
  border-top: 1px solid #eef0f2;
  flex-shrink: 0;
  text-align: center;
}

[data-theme="dark"] .drawer-footer {
  border-top: 1px solid #2e2e2e;
}

.drawer-footer-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.drawer-footer-actions-single {
  justify-content: center;
}

.drawer-footer-text {
  font-size: 12px;
  cursor: pointer;
  color: #999999;
  text-decoration: none;
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.drawer-footer-actions .drawer-footer-text:first-child {
  text-align: left;
}

.drawer-footer-actions .drawer-footer-text:last-child {
  text-align: right;
}

.drawer-footer-actions-single .drawer-footer-text {
  flex: 0 1 auto;
  max-width: 100%;
  text-align: center;
}

.drawer-footer-text:hover {
  text-decoration: underline;
}

/* &#25277;&#23625;&#20869;&#23481;&#21306;&#22495;&#26679;&#24335; */
.drawer-section {
  margin-bottom: 16px;
}

.drawer-section:last-child {
  margin-bottom: 0;
}

.drawer-section-highlight {
  background-color: #f9f9f9;
  border-radius: 12px;
  padding: 16px;
}

[data-theme="dark"] .drawer-section-highlight {
  background-color: #2a2a2a;
}

.drawer-section-title {
  font-size: 14px;
  font-weight: 500;
  color: #666666;
  margin-bottom: 12px;
}

[data-theme="dark"] .drawer-section-title {
  color: #999999;
}

.drawer-section-divider {
  height: 1px;
  background-color: #eef0f2;
  margin: 16px 0;
}

/* ========== &#36890;&#29992;&#25277;&#23625;&#32452;&#20214;&#26679;&#24335; ========== */
.popup-drawer-container {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.popup-drawer-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 4px;
  padding: 6px;
  border-radius: 12px;
  background: #f3f5f6;
}

[data-theme="dark"] .popup-drawer-tabs {
  background: #2a2a2a;
}

.popup-drawer-tabs button {
  height: 44px;
  border: 0;
  border-radius: 8px;
  color: #666666;
  background: transparent;
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  cursor: pointer;
}

.popup-drawer-tabs button.active {
  color: #222222;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

[data-theme="dark"] .popup-drawer-tabs button {
  color: #b3b3b3;
}

[data-theme="dark"] .popup-drawer-tabs button.active {
  color: #f3f3f3;
  background: #1f1f1f;
}

.popup-drawer-card {
  background: #f3f5f6;
  border-radius: 12px;
  padding: 12px 12px 16px;
}

[data-theme="dark"] .popup-drawer-card {
  background: #2a2a2a;
}

.popup-drawer-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 21px;
  gap: 12px;
}

.popup-drawer-card-header input[type="checkbox"][role="switch"] {
  margin: 0;
  flex-shrink: 0;
}

.popup-drawer-card-title {
