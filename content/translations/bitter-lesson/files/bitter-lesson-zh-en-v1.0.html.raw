:root,
#mount[data-theme="light"],
#mount:not([data-theme="dark"]) {
  /* &#20013;&#24615;&#28784;&#38454;&#65288;light&#65289; */
  --c-00: #000000;
  --c-22: #222222;
  --c-33: #333333;
  --c-66: #666666;
  --c-83: #838383;
  --c-99: #999999;
  --c-c7: #c7c7c7;
  --c-cc: #cccccc;
  --c-e6: #e6e6e6;
  --c-f5: #f5f5f5;
  --c-ff: #ffffff;
  /* &#21697;&#29260;&#20027;&#33394;&#38454;&#65288;light&#65289; */
  --p-main: #ea4c89;
  --p-hover: #ec5e95;
  --p-active: #e34a85;
  --p-special: #ee71a2;
  --p-disabled: #f4a5c4;
