<style>
:root{--bg:#fff;--fg:#1a1a1a;--mut:#666;--line:#ddd;--code:#188038;--link:#1155cc;--th:#141413;--row:#f6f5f2;--accent:#c96442}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:"Noto Serif CJK SC","Noto Serif SC",Lora,Georgia,"Songti SC",serif;font-size:17px;line-height:1.85;-webkit-text-size-adjust:100%}
.wrap{max-width:46rem;margin:0 auto;padding:3rem 16px 6rem}
h1,h2,h3,h4{font-family:"Noto Sans CJK SC","Noto Sans SC",Poppins,-apple-system,sans-serif;font-weight:600;line-height:1.35;margin:2.2em 0 .7em}
h1{font-size:1.75rem;margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--line)}
h2{font-size:1.35rem}h3{font-size:1.13rem;color:var(--mut)}h4{font-size:1rem;color:var(--mut)}
h1:first-of-type{border:0;margin-top:0}
p{margin:0 0 1.1em}
a{color:var(--link);text-decoration:underline;text-underline-offset:2px}
code,.code{font-family:"Roboto Mono",ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.88em;color:var(--code);word-break:break-all}
.cap{font-size:.86rem;color:var(--mut);line-height:1.65;margin:-.4em 0 2em}
.fn{font-size:.82rem;color:var(--mut);line-height:1.6;border-top:1px solid var(--line);padding-top:.6em;margin-top:1.5em}
sup{font-size:.7em;vertical-align:super;line-height:0}
ul,ol{margin:0 0 1.2em;padding-left:1.6em}li{margin-bottom:.5em}
figure{margin:2em 0;text-align:center}
img{max-width:100%;height:auto;border-radius:4px}
.tw{overflow-x:auto;margin:1.8em 0;-webkit-overflow-scrolling:touch}
table{border-collapse:collapse;width:100%;font-size:.86rem;font-family:"Noto Sans CJK SC","Noto Sans SC",sans-serif;line-height:1.5}
th,td{border:1px solid var(--line);padding:.5em .7em;vertical-align:top;text-align:left}
thead th,tr:first-child th{background:var(--th);color:#fff;font-weight:600}
tbody tr:nth-child(even){background:var(--row)}
.pm{display:block;height:0;overflow:visible;position:relative}
.pm::after{content:attr(data-p);position:absolute;right:calc(100% + 1.2rem);font-size:.68rem;color:var(--mut);font-family:system-ui,sans-serif;opacity:.5}
@media(max-width:60rem){.pm::after{display:none}}
#toc{margin:2em 0 4em;font-family:"Noto Sans CJK SC","Noto Sans SC",sans-serif;font-size:.92rem;line-height:1.5}
#toc .t{display:flex;align-items:baseline;gap:.4em;margin:.32em 0}
#toc .t1{font-weight:600;margin-top:.9em}
#toc .t2{padding-left:1.2em}#toc .t3{padding-left:2.4em;font-size:.88rem}#toc .t4{padding-left:3.6em;font-size:.85rem}
#toc .d{flex:1;border-bottom:1px dotted var(--line);transform:translateY(-.22em)}
#toc .pn{color:var(--mut);font-variant-numeric:tabular-nums;font-size:.85rem}
#toc a{color:inherit;text-decoration:none}#toc a:hover{color:var(--link);text-decoration:underline}
.ttl{text-align:left;margin:0 0 4rem;padding-bottom:2rem;border-bottom:1px solid var(--line)}
.ttl .k{font-family:"Noto Sans CJK SC",sans-serif;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem}
.ttl h1{font-size:2.4rem;border:0;padding:0;margin:0 0 1rem;line-height:1.25}
.ttl .m{color:var(--mut);font-size:.95rem}
.note{background:var(--row);border-left:3px solid var(--accent);padding:1em 1.2em;margin:2em 0;font-size:.9rem;line-height:1.7;color:var(--mut)}
.note b{color:var(--fg)}
@media(max-width:40rem){body{font-size:16px}.wrap{padding:2rem 16px 4rem}.ttl h1{font-size:1.9rem}h1{font-size:1.5rem}}
</style>
</head>
