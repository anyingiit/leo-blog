#toc .t1{font-weight:600;margin-top:.9em}
#toc .t2{padding-left:1.2em}#toc .t3{padding-left:2.4em;font-size:.88rem}#toc .t4{padding-left:3.6em;font-size:.85rem}
#toc .d{flex:1;border-bottom:1px dotted var(--line);transform:translateY(-.22em)}
#toc .pn{color:var(--mut);font-variant-numeric:tabular-nums;font-size:.85rem}
#toc a{color:inherit;text-decoration:none}#toc a:hover{color:var(--link);text-decoration:underline}
.ttl{text-align:left;margin:0 0 4rem;padding-bottom:2rem;border-bottom:1px solid var(--line)}
.ttl .k{font-family:"Noto Sans CJK SC",sans-serif;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem}
.ttl h1{font-size:2.4rem;border:0;padding:0;margin:0 0 1rem;line-height:1.25}
.ttl .m{color:var(--mut);font-size:.95rem}
.note{background:var(--row);border-left:3px solid var(--accent);padding:1em 1.2em;margin:2em 0;font-size:.9rem;line-height:1.7;color:var(--mut)}
.note b{color:var(--fg)}
@media(max-width:40rem){body{font-size:16px}.wrap{padding:2rem 16px 4rem}.ttl h1{font-size:1.9rem}h1{font-size:1.5rem}}
