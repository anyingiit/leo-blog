 sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:7pt;font-style:normal;font-weight:700;text-decoration:none;color:#000;text-indent:-6.98pt;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">应付可转换票据</div></div></div></div></td><td style=font-size:0;text-align:left;vertical-align:top></td><td style="border-bottom:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:417.75pt;position:absolute;width:50.25pt><div><div style=line-height:5.29pt;position:absolute;top:16.95pt;width:50.25pt><div class=zh style="position:absolute;top:-.85pt;left:10.13pt;width:35.44pt;line-height:7pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:7pt;font-style:normal;font-weight:700;text-decoration:none;color:#000;text-indent:-3.64pt;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">衍生负债</div></div></div></div></td></tr><tr style=height:23.25pt><td style=background-color:#ecebe3;font-size:0;text-align:left;vertical-align:top><div style=position:absolute;top:32.25pt;width:98.25pt><div><div style=line-height:6.8pt;position:absolute;top:3.31pt;width:98.25pt><div class=zh style="position:absolute;top:-1.1pt;left:2.63pt;width:76.69pt;line-height:9pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2023年12月31日的余额</div></div></div></div></td><td style="background-color:#ecebe3;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:98.25pt;position:absolute;top:32.25pt;width:50.25pt><div><div style=line-height:6.8pt;position:absolute;top:13pt;width:50.25pt><font style=color:#000;font-family:georgia,serif;font-size:9pt;font-style:normal;font-weight:40