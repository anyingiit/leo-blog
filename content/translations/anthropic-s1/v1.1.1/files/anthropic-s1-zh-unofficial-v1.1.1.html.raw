p:1pt solid #000;font-size:0;text-align:left;vertical-align:top"></td><td style=background-color:#fff;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#fff;border-bottom:3pt double #000;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"></td><td style=background-color:#fff;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#fff;border-bottom:3pt double #000;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"></td></tr></tbody></table></div></div></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:669.05pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:71.96pt>______________</font></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:678.65pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:9.43pt>(1)</font><div class=zh style="position:absolute;top:-1.78pt;left:90pt;width:451.77pt;line-height:9.6pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">包括公司办公场所以及算力及基础设施的经营租赁，截至          ，其加权平均剩余租赁期为          年。更多信息参见我们的合并财务报表附注7。</div></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:697.85pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:10.46pt>(2)</font><div class=zh style="position:absolute;top:-1.78pt;left:90pt;width:451.68pt;line-height:9.6pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">包括算力及基础设施的融资租赁，截至          ，其加权平均剩余租赁期为          年。更多信息参见我们的合并财务报表附注7。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.66pt;position:absolute;text-decoration:none;white-space:pre>170</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:10.41pt>(3)</font><div class=zh style="position:absolute;top:-1.98pt;left:90pt;width:451.85pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">主要包括CSP托管及其他第三方基础设施服务协议项下的未来最低付款额。</div></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:81.6pt;width:612pt><div class=zh style="position:absolute;top:-1.77pt;left:90pt;width:451.92pt;line-height:9.6pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">该表反映了我们剩余期限超过一年的不可撤销采购承诺项下的未来最低付款额。更多信息参见我们的合并财务报表附注13。</div></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:100.8pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:10.51pt>(4)</font><div class=zh style="position:absolute;top:-1.98pt;left:90pt;width:451.59pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">不包括截至          可转换本票项下          美元的未偿本金总额，该等票据预计将</div></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:110.4pt;width:612pt><div class=zh style="position:absolute;top:-1.77pt;left:90pt;width:451.66pt;line-height:9.6pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">以股份而非现金结算。在满足适用条件的前提下，我们可能额外发行最多          美元的可转换本票。更多信息参见“—可转换票据”一节。</div></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:129.6pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:10.22pt>(5)</font><div class=zh style="position:absolute;top:-1.77pt;left:90pt;width:451.92pt;line-height:9.6pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">不包括未规定固定美元承诺金额、且未计入上述合计金额的若干其他算力及基础设施协议。该等协议项下的付款将取决于所提供及所部署的容量、交付时间、定价机制以及若干其他部署条件的满足情况。由于该等因素尚无法确定，该等协议项下的付款总额尚不确定，但我们目前估计该等付款约为          美元至          美元。我们预计该等款项将在容量交付后的一段时间内陆续支付。参见下文“—基础设施服务安排”一节。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:196.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">上表反映了截至          我们的合同义务，并包括截至该日期固定且可确定的义务。对于条款可变的协议，上述金额仅包括我们按合同承诺的最低付款额和/或定价，不包括超出该等最低额的可变付款。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:251.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">上表不包括可在一年内无罚金取消的短期承诺或剩余合同期限为一年或以下的协议项下的金额。截至          ，该等合同项下的最低付款额约为          美元。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:294.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">此外，上表不包括截至          已签署但尚未开始的租赁，其未来未折现租赁义务估计总额约为          美元。一般而言，该等租赁义务将于          至          期间开始，租赁期限从不足          年至          年不等。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:337.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">此外，上表并未反映          之后订立的承诺，其未来最低付款义务总额约为          美元。我们亦于          之后订立了若干短期性质的协议。该等合同项下的最低付款额约为          美元。参见本招股说明书其他部分所载的我们的合并财务报表附注17，以了解有关          之后所订立承诺的更多信息。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:403.8pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:72pt;width:468pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的合同义务中约有          美元预计将在未来12个月内支付。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:424.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">根据我们的算力及数据中心战略，我们预计将在扩展业务的过程中继续订立更多安排以获取算力及基础设施容量，并进行重大的相关投资。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:467.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">以下介绍我们若干最重要的现有安排。我们亦是下文未予介绍的其他算力基础设施服务安排及租赁的订约方。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:499.2pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">基础设施服务安排</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:520.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">2025年11月，我们与Microsoft订立了一项协议（该协议随后于2026年2月及10月经修订），据此，我们承诺于2026年11月至2033年5月期间合计支出至少449亿美元，无论实际使用量如何。除Microsoft发生未纠正的重大违约，或就未交付的批次按批次取消的情形外，我们在该协议项下的承诺不可撤销。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:586.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">2026年3月，我们与Google订立了一项协议（该协议随后于2026年5月至8月期间经修订），据此，我们承诺于2026年4月至2033年7月期间支出至少约1,145亿美元，无论实际使用量如何。如我们的实际支出不足，我们必须向Google支付差额作为差额补足，但须受若干调整及例外情况（如适用）的限制。除非发生Google未纠正的重大违约，我们在该协议项下的承诺不可撤销。此外，我们亦承诺向包括Google在内的TPU提供商采购额外的TPU算力，将于2028年至2031年期间交付。该等额外算力的付款义务取决于所提供的容量、其部署方式、定价机制以及若干部署条件的满足情况。我们估计该等额外算力的未来付款总额约为1,250亿美元至1,500亿美元，该等金额未计入上文合同承诺表。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:299.53pt;position:absolute;text-decoration:none;white-space:pre>171</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">2026年4月，我们与Amazon订立了一项协议，据此，我们承诺于2026年5月至2036年4月期间合计支出至少1,100亿美元，无论实际使用量如何。如我们的实际支出不足，我们必须向Amazon支付差额作为差额补足，但须受若干调整及例外情况（如适用）的限制。除非发生Amazon未纠正的重大违约，我们在该协议项下的承诺不可撤销。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:138pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">2026年5月至10月期间，我们与Space Exploration Technologies Corp.的全资子公司SpaceX.AI LLC（前称X.AI LLC）（“SpaceXAI”）订立并修订了若干协议（统称“SpaceXAI安排”），以获取由NVIDIA GPU驱动的算力。根据SpaceXAI安排，我们同意在延续至2029年的期限内合计支出最多1,205亿美元，其中在全部容量交付后（我们预计将于2026年12月交付）每月合计约31亿美元，容量爬坡期间的费用则有所不同。在相应协议项下分别于2027年1月和2027年3月结束的初始不可撤销期之后，各项协议均可由任何一方提前90天发出书面通知予以取消。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:238.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">根据与AMD订立的硬件供应协议，在满足与部署方案相关的若干条件的前提下，我们承诺于2027日历年内通过向经批准的制造商购买基于AMD的Helios机架级系统，或通过第三方服务提供商使用该等系统，获取第一批算力容量。该协议并未规定固定的美元承诺金额。如我们采购全部该初始承诺容量，我们预计在协议期限内的总支出将超过200亿美元，该等金额未计入上文合同承诺表。该协议亦规定了可能采购最多约相当于我们初始承诺数量的额外容量。除非发生AMD未纠正的重大违约，我们不可撤销与AMD订立的协议，且该协议将于双方均履行其在协议项下的承诺且所有已订购的AMD GPU容量均已交付后12个月自动终止。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:361.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">2026年8月，我们与Nscale Global Holdings Limited（连同其关联方统称“Nscale”）的全资子公司订立了GPU服务协议（统称“Nscale服务协议”），以获取由NVIDIA GPU驱动的算力。根据Nscale服务协议，我们同意在延续至2033年的期限内合计支出最多约446亿美元，费用仅在容量交付予我们并经我们验收时方会产生。Nscale须尽最大努力在该等协议生效日期后的特定期限内（或双方可能另行协定的较晚日期，并须经进一步谈判）为NVIDIA GPU及数据中心基础设施取得合格融资。除此之外，我们在各项协议项下的承诺不可撤销，但有限情况除外，包括Nscale未能满足特定的交付或服务可用性要求，或适用的Nscale实体发生未纠正的重大违约。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:484.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">2026年5月、6月及8月，我们与Lambda, Inc.（“Lambda”）订立了若干协议（统称“Lambda协议”），以获取由NVIDIA GPU驱动的算力。根据Lambda协议，我们同意在延续至2034年的期限内合计支出约413亿美元，费用仅在容量交付予我们并经我们验收时方会产生。根据我们于2026年8月订立的协议（在总承诺金额中约占349亿美元），如Lambda未能及时取得设施租赁，任何一方均可终止该协议。除此之外，除非发生Lambda未纠正的重大违约或若干其他有限情况，以及就若干Lambda协议而言，Lambda未能满足某一批次的特定交付里程碑时按批次取消外，我们在各项Lambda协议项下的承诺不可撤销。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:595.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">基础设施设备租赁</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:616.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们已与Broadcom订立为期五年的设备租赁主协议，据此，我们接收相关硬件，并将其部署于由他方代表我们运营的专用数据中心设施（“租赁安排”）。该等租赁安排作为融资租赁进行会计处理。在该等租赁的期限内，我们的租金付款合计约为1,612亿美元（不含利息），租金按季度分期支付，付款义务通常于AI基础设施设备在适用数据中心设施“可投入使用”时开始。在若干情况下（例如数据中心设施的就绪延迟时），租金付款可能提前开始。租赁安排使我们能够获取基于TPU的算力容量，其中一部分已于2026年开始上线，预计额外容量将自2027年起陆续上线。除发生违约外，在适用租赁期内任何一方</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.92pt;position:absolute;text-decoration:none;white-space:pre>172</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">均不可撤销租赁安排。就2026年租赁安排而言，我们已为Broadcom的利益将现金存入受限制现金账户，并可能在若干情况下须为Broadcom的利益存入额外现金。我们的两家特殊目的子公司就租赁安排订立了协议，其项下义务由Anthropic, PBC提供担保，且该等义务以所租赁设备作为担保。此外，我们同意了惯常的违约事件（包括交叉违约），一旦发生该等事件，我们的义务可能加速到期。如有需要，在若干情况下，我们可能通过根据基础设施合作伙伴2026 NPA发行可转换本票，为2026年租赁安排项下一定金额的季度租金付款提供资金。更多信息参见“—可转换票据—Broadcom”一节。2026年第二季度，Broadcom将其在其中一项设备租赁主协议项下的部分权利转让给另一第三方。</div></div><div id=ica694c859b8e458dbf6a73f56dde9d42_1482 style=position:absolute;top:195pt></div><div style=line-height:9.07pt;position:absolute;top:195pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">关于市场风险的定量和定性披露</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:218.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.21pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们在日常业务过程中面临市场风险。市场风险是指因金融市场价格和利率的不利变动而可能影响我们财务状况的损失风险。我们的市场风险敞口主要源于利率和外汇汇率的波动。</div></div><div style=line-height:7.56pt;position:absolute;top:261.6pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">利率风险</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:282.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2026年6月30日，我们拥有1,124亿美元的现金及现金等价物，以及193亿美元投资于多种证券的短期投资，包括货币市场基金、美国国债及政府机构证券、公司债务证券和商业票据。此外，我们拥有25亿美元的受限制现金，主要是作为我们租赁及其他义务的担保品而持有的款项。我们持有现金、现金等价物及短期投资是为了满足营运资金需要，我们不以交易或投机为目的进行投资。由于我们投资组合的期限相对较短，假设利率上升或下降100个基点，不会对截至2026年6月30日我们投资组合的公允价值产生重大影响。</div></div><div style=line-height:7.56pt;position:absolute;top:382.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">外汇风险</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:403.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们以多种货币在全球开展业务，我们的绝大部分收入以美元计价，少部分以欧元和英镑等其他货币计价。我们的国际收入、以外币计价的成本和费用，以及与境外子公司之间的公司间交易，使我们面临外汇汇率相对美元波动的风险。假设适用于我们业务的外汇汇率变动10%，不会对截至<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">2026年6月30日</span>我们的合并财务报表产生重大影响。我们尚未订立衍生工具或对冲交易，但如我们的外汇风险敞口变得更为重大，我们未来可能订立该等安排。</div></div><div id=ica694c859b8e458dbf6a73f56dde9d42_1492 style=position:absolute;top:504pt></div><div style=font-size:12pt;line-height:9.07pt;position:absolute;top:504pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">关键会计估计</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:527.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们对财务状况及经营业绩的讨论与分析以我们按照GAAP编制的财务报表为基础。GAAP要求我们作出若干影响财务报表中所报告金额的估计和判断。我们的估计基于历史经验、预期未来趋势以及我们认为在当时情况下合理的其他假设。由于该等会计政策需要作出重大判断，我们的实际结果可能与我们的估计存在重大差异。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:604.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们认为，在我们的重要会计政策（详见本招股说明书其他部分所载的我们的合并财务报表附注1）中，以下会计政策涉及较高程度的判断和复杂性。因此，我们认为该等政策对于帮助全面理解和评估我们的合并财务状况、经营业绩及现金流量最为关键。</div></div><div style=line-height:7.56pt;position:absolute;top:659.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">股权激励</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:680.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们根据授予日奖励的估计公允价值，计量授予员工、董事及其他服务提供者的所有股权激励奖励（包括股票期权和RSU）的薪酬费用。确定股票期权公允价值时最重要的输入值是我们普通股的估计公允</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.95pt;position:absolute;text-decoration:none;white-space:pre>173</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">价值。我们普通股的估计公允价值亦用于计量RSU和RSA（包括附带基于业绩的归属条件的RSU和RSA）的授予日公允价值。</div></div><div style=line-height:7.56pt;position:absolute;top:103.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">股票期权</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:124.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们于授予日采用Black-Scholes-Merton期权定价模型估计授予员工、顾问、高级职员及董事的股票期权的公允价值。预计将归属的股票期权的公允价值在必要服务期内按直线法确认为薪酬费用。于没收发生时进行会计处理。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:179.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Black-Scholes-Merton模型在估计股权激励奖励的公允价值时考虑多项变量和假设。该等变量包括：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:211.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>▪</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.17pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">普通股公允价值。由于我们的普通股尚未公开交易，我们必须估计普通股的公允价值。如下文“—普通股估值”一节所述，我们的董事会考虑众多客观和主观因素以确定我们普通股的公允价值。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:265.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>▪</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.22pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">预期波动率。由于我们的普通股并无交易历史，我们标的普通股的预期波动率按一组可比上市公司在与期权预期期限相等的期间内的加权平均历史波动率进行估计。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:309pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:italic;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.21pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">预期期限。预期期限是指我们预计股权激励奖励将保持尚未行使状态的期间。我们根据期权的归属期限和合同期限估计预期期限，即预期期限等于股权激励奖励的加权平均归属期与其合同期限的平均值。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:363.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:italic;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.23pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">无风险利率。预期无风险利率假设以期限与股票期权预期期限一致的美国国债工具为基础。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:395.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:italic;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.15pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">预期股息率。预期股息率为零，因为我们从未宣派或支付任何股息，且目前亦无计划宣派或支付股息。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:427.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.16pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2026年6月30日，与未归属股票期权相关的未确认的薪酬成本总额约为28亿美元，预计将在1.2年的加权平均期间内确认。</div></div><div style=line-height:7.56pt;position:absolute;top:459pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">限制性股票单位及限制性股票奖励</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:480pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们已根据2021年计划向员工及非员工服务提供者授予RSU。截至<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">2026年6月30日</span>尚未归属的RSU同时附带基于服务的归属条件和基于业绩的归属条件。该等奖励的基于服务的归属期通常为四年。在业绩条件满足后，基于服务的归属条件亦已满足的RSU将立即归属，而任何剩余未归属的RSU将在剩余服务期内按比例归属。业绩条件一般在发生控制权变更事件时或本招股说明书构成其一部分的注册声明生效之日满足。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:568.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">2026年6月30日</span>，由于业绩条件尚未满足，我们尚未就该等RSU确认任何股权激励费用。随着本次发行，我们将开始采用加速归属法，根据RSU的授予日公允价值记录股权激励费用。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">截至2026年6月30日，与RSU相关的未确认的股权激励费用总额约为266亿美元。其中29亿美元</span>与基于服务的归属条件已全部或部分满足的RSU相关。本次发行完成后，与我们的RSU相关的股权激励费用将导致我们未来期间（尤其是本次发行完成当季）的费用增加，因为适用于我们很大一部分尚未归属RSU的基于业绩的归属条件将在本招股说明书构成其一部分的注册声明生效时满足。本次发行完成时，对于截至本招股说明书日期尚未归属、且(i)基于服务的归属条件截至该日期已全部或部分满足，</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.89pt;position:absolute;text-decoration:none;white-space:pre>174</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">及(ii)基于业绩的归属条件在本招股说明书构成其一部分的注册声明生效时满足的RSU，我们将记录与之相关的约          美元累计股权激励费用。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:103.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们已向创始人、早期员工、顾问授予RSA，并<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">就收购事项</span>授予RSA。RSA包括附带基于服务的归属条件的奖励。RSA按授予日标的普通股的公允价值计量。我们在必要服务期内采用直线法记录该等奖励的薪酬成本。</div></div><div style=line-height:7.56pt;position:absolute;top:158.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">普通股估值</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:179.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">在我们首次公开发行之前，鉴于我们的A类普通股不存在公开交易市场，并根据美国注册会计师协会（AICPA）会计与估值指南《<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">作为薪酬发行的私营公司权益证券的估值</span>》，我们的董事会运用合理判断并考虑众多客观和主观因素，以确定我们普通股公允价值的最佳估计，该等因素包括：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:245.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">对我们普通股的同期第三方估值；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:265.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们向第三方投资者出售普通股或可赎回可转换优先股的价格，以及二级交易（包括任何要约收购）中支付的价格；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:297.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们可赎回可转换优先股相对于普通股的权利、优先权及特权；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:329.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">实际及预测的经营和财务业绩；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:349.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的发展阶段；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:370.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">行业前景；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:390.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们普通股缺乏市场流通性；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:411pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.12pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">鉴于当时的市场状况，实现流动性事件（例如首次公开发行或出售本公司）的可能性；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:442.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们业务的历史和性质、行业趋势及竞争环境；及</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:463.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.2pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">总体经济前景，包括经济增长、通货膨胀和失业、利率环境以及全球经济趋势。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:495pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的董事会通过以下方式确定普通股的公允价值：首先确定我们业务的企业价值，然后将该价值在我们各类证券之间进行分配，以得出普通股的每股价值。我们业务的企业价值主要参照最接近估值日期的一轮股权融资进行估计。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:549.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">在本次发行前将我们业务的企业价值在各类股票之间进行分配时，我们采用了基于或有权益分析法（“CCA”）和普通股等价物法（“CSE法”）的混合法。CCA以Black-Scholes-Merton期权定价模型为基础，将每类股票视为对我们资产具有独特索取权的看涨期权进行建模。CSE法假定所有可赎回可转换优先股股份均根据其转换条款转换为普通股，并忽略可赎回可转换优先股股份在权利和优先权方面的其他差异。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:627pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">在将企业价值分配至各类股票后，应用缺乏市场流通性折扣（“DLOM”）以得出普通股的公允价值。DLOM旨在反映未在公开交易所交易的私营公司股票缺乏出售机会这一情况。在最终确定普通股价值时，亦会考虑近期普通股出售和/或预期普通股出售情况。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:693pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.22pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">应用该等方法涉及使用复杂且主观的估计、判断和假设，例如有关我们预期未来收入、费用及未来现金流量、折现</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:299.07pt;position:absolute;text-decoration:none;white-space:pre>175</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">率、市场乘数、可比公司的选择以及未来可能发生事件的概率的估计、判断和假设。任何或全部该等估计和假设或该等假设之间关系的变化，均会影响我们截至各估值日期的估值，并可能对我们普通股的估值产生重大影响。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:126.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">本次发行后，由于我们的普通股股份将在公开市场交易，将无需确定我们普通股的公允价值。</div></div><div style=line-height:7.56pt;position:absolute;top:158.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">可转换票据、衍生负债及SAFE的公允价值</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:179.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们选择根据《会计准则汇编》（“ASC”）主题<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">825“金融工具”</span>，以公允价值对我们的可转换票据进行会计处理。可转换票据以其估计公允价值在我们的合并资产负债表中确认，公允价值变动计入我们合并经营报表中的“可转换票据、衍生负债及SAFE的公允价值变动”。我们选择公允价值选择权，是为了消除若根据传统分拆模型对可转换票据的负债和权益成分分别进行会计处理而将会产生的会计复杂性。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:256.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">就与Amazon及Google各自订立的2023年及2024年票据购买协议而言，我们确认了衍生负债，代表根据该等协议条款发行未来可转换票据的义务。该等衍生负债按估计公允价值计量，公允价值变动计入合并经营报表中的“可转换票据、衍生负债及SAFE的公允价值变动”。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:322.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">可转换本票的估计公允价值采用由CCA和CSE法构成的混合法确定。该分析采用情景分析法估计可转换本票的公允价值，即考虑该等工具在票据持有人可获得的各种可能结果下的概率加权现值，包括转换为可赎回可转换优先股、转换为N类普通股、到期时以现金偿还，以及在控制权变更时以溢价进行现金结算。所纳入的情景考虑了该等工具在CCA和CSE框架下的概率加权价值。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:411.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">该方法的应用涉及使用复杂且主观的估计、判断和假设，包括：每种结算情景（例如合格股权融资、首次公开发行、直接上市或控制权变更）发生的概率和时间；票据可能转换成的我们股权证券的估计公允价值；适用的转换价格，其因票据系列而异，并取决于自发行以来经过的时间、合同上限及百分比折扣等因素；以及决定本金余额在多大程度上转换为股权、而非重新发行为展期票据的持股门槛和展期条款。尤其是，持股上限和展期机制——据此，转换以特定持股门槛为上限，任何未转换的本金余额将重新发行为不计息的展期票据，该展期票据仍须按公允价值计量——在估计每笔票据融资中将有多大比例转换、多大比例展期时需要作出重大判断，因为这一判断取决于未来股权融资的规模和结构，而这本身具有不确定性。任何或全部该等估计和假设的变化，或该等假设之间关系的变化，均会影响我们在每个计量日的估值，并可能对我们合并经营报表中确认的金额产生重大影响。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:580.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">上述公允价值选择权的选择同样适用于我们在截至2023年12月31日止年度发行的SAFE。SAFE采用相同的情景分析框架按估计公允价值计量，其货币结算金额在初始时即已固定，而转换时获得的股权股份数量是可变的；与可转换票据一致，公允价值变动计入合并经营报表中的可转换票据、衍生负债及SAFE的公允价值变动。所有SAFE均已在截至2023年及2024年12月31日止年度内转换为可赎回可转换优先股，截至2024年或2025年12月31日均无发行在外的SAFE。在截至2026年6月30日止六个月内的任何时点均无发行在外的SAFE。因此，公允价值选择权下主要的持续性估计风险敞口与上述可转换票据及展期票据相关。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.89pt;position:absolute;text-decoration:none;white-space:pre>176</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">有关我们的可转换票据、衍生负债及SAFE的更多信息，包括各项工具的说明、其主要条款、转换情况以及所列报期间内的余额，参见载于本招股说明书其他部分的合并财务报表附注9。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:115.2pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">租赁</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:136.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们以经营租赁和融资租赁方式租赁设施和设备，包括算力及基础设施容量。我们在安排开始时确定该安排是否为租赁或包含租赁，并在租赁开始日以及在必要时于租赁修改时评估租赁的分类。租赁的会计处理需要作出重大判断，包括确定某项安排是否为租赁或包含租赁，并需要作出重大估计，包括预计租赁期、租赁资产的公允价值以及我们的增量借款利率。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:213.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">鉴于我们租赁组合的规模和期限，我们对标的租赁资产公允价值的估计、对预计租赁期的估计或对增量借款利率的确定发生变化，可能导致不同的租赁分类，或导致我们使用权资产和租赁负债的计量结果存在重大差异。</div></div><div style=line-height:7.56pt;position:absolute;top:268.2pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">所得税</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:289.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们采用资产负债法核算所得税，就资产和负债的财务报告基础与计税基础之间的暂时性差异以及净经营亏损及税收抵免结转确认递延所得税资产及负债，并按预计转回年度适用的已颁布税率计量。我们在必要时根据对正面和负面证据的权衡计提估值备抵，以将递延所得税资产减记至很可能（可能性大于50%）实现的金额。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:355.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">评估我们递延所得税资产的可实现性是需要管理层作出重大判断的领域。我们根据历史应税收入、预计未来应税收入、现有暂时性差异的转回模式以及可用的税务筹划策略，评估递延所得税资产的可收回性。作为一家在快速演变的市场中经营、并持续在算力及基础设施方面进行大量投资的AI公司，我们对未来应税收入的预测本身具有不确定性。如果我们对递延所得税资产可收回性的评估发生变化，我们的所得税费用将会在该期间作出调整，这可能对我们的经营业绩产生重大影响。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:444pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们根据<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">ASC主题740“所得税”</span>核算不确定税务状况。当某一税务状况基于其技术依据很可能（可能性大于50%）在税务审查中得到支持时，我们确认来自不确定税务状况的税收优惠，并按结算时很可能实现的金额计量。这些评估需要作出判断，尤其是在研发税收抵免的认定和文件记录方面，相关支持性证据可能存在不同解释。这些事项的实际结果可能与我们当前的估计存在重大差异。我们将与未确认税收优惠相关的利息和罚款计入所得税费用。</div></div><div style=line-height:7.56pt;position:absolute;top:532.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">或有损失</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:553.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们涉及在日常业务过程中产生的法律索赔、诉讼以及其他监管和行政事项，其中某些事项可能包括要求巨额或金额不确定的损害赔偿的投机性索赔。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:597pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们定期评估每一重大事项及其潜在的财务风险敞口。当我们认为损失很可能已经发生且损失金额能够合理估计时，我们确认一项负债；对于损失合理可能发生且损失金额或损失范围能够估计的事项，我们予以披露。这些评估在确定潜在损失的可能性和估计金额时均需要作出重大判断。我们根据当时可获得的最佳信息计提预计负债，并考虑每一事项的具体事实和情况、我们抗辩理由的充分性，以及谈判、和解、监管程序、裁决和法律顾问意见的影响。随着更多信息的获得和事项的进展，我们的估计可能发生变化，并且我们在以往期间曾根据更新的信息修订我们的评估。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:299.19pt;position:absolute;text-decoration:none;white-space:pre>177</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:9.07pt;position:absolute;top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">近期会计公告</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:95.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">有关近期采用的会计公告以及近期发布但尚未采用的会计公告的说明，参见载于本招股说明书其他部分的合并财务报表附注1。</div></div></div></div></div></div></section><section id=ch-business><h2 class=dl-ch>业务</h2><div class=s1-sheets data-first-page=189><div class=s1-sheets-inner><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_2986 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=a2026-10x24businessa.jpg width=816 height=1056><div style=position:absolute;left:56.88pt;top:179.64pt;width:254.88pt;height:59.4pt;background:#f1eee7></div><div class=zhimg style="position:absolute;left:60.48pt;top:183.24pt;width:247.68pt;height:52.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:47.52pt;font-weight:700;color:#100f0b;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>业务</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.89pt;position:absolute;text-decoration:none;white-space:pre>179</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_9895604651111 style=position:absolute;top:72pt></div><div style=line-height:14.36pt;position:absolute;top:72pt;width:612pt><div class=zh style="position:absolute;top:-5.32pt;left:72pt;width:468pt;line-height:25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:20pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">业务</div></div><div style=font-size:12pt;line-height:9.07pt;position:absolute;top:105pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">概览</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:128.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">有史以来第一次，智能成为人类可以构建之物。推理、分析、综合、决策和创造的认知能力可以规模化地生产，并可按需获取。我们相信，这种AI的充裕将迅速变革全球经济的每一个行业，其影响将超过工业化、电力、半导体和互联网。真正发挥其潜力（同时风险得到妥善管理）的AI，可能会显著加速全球增长，并大幅改善世界各地人们的生活质量。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:205.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Anthropic由一支研究团队于2021年创立，该团队缔造了定义AI的诸多突破。我们首先是一家研究实验室——我们的使命是<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">为人类的长期利益负责任地开发和维护先进AI</span>。这一使命指引着我们的专注——与我们的人才与文化、我们的前沿与安全研究、我们的算力策略以及我们的企业战略一道，它是使我们脱颖而出的核心优势之一。这些优势使我们能够持续推进前沿AI，并为其安全和负责任的开发塑造标准。我们的前沿AI，即Claude，通过我们的模型、平台及应用向客户提供。Claude经历了历史上所有技术中最快的企业采用，收入从2023年第一季度商业发布时的0美元增长至<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">截至2026年9月30日止三个月的          美元</span>即为明证。这一快速且不断增长的采用产生了两种自我强化的动态——推动Claude进步的改进循环，以及帮助为我们在<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">前沿</span>AI领域的持续研究提供资金的投资循环。</div></div><div style=position:absolute;top:340.2pt;width:612pt><div style=left:72pt;position:absolute><div style=position:absolute><div style=position:relative;width:468pt;height:266.75pt;overflow:hidden><img style=display:block;height:266.75pt;width:468pt src="data:image/jpeg;base64," alt=a2026-09x27xgraphicsxcompe.jpg width=624 height=355.65625><div style=position:absolute;left:13.5pt;top:65.25pt;width:128pt;height:30.5pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:15pt;top:66.75pt;width:125pt;height:27.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:11.5pt;font-weight:400;color:#000;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>我们的核心优势</span></div><div style=position:absolute;left:173.5pt;top:65.25pt;width:128pt;height:30.5pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:175pt;top:66.75pt;width:125pt;height:27.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:11.5pt;font-weight:400;color:#000;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>企业对Claude的采用</span></div><div style=position:absolute;left:333.5pt;top:65.25pt;width:128pt;height:30.5pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:335pt;top:66.75pt;width:125pt;height:27.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:11.5pt;font-weight:400;color:#000;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>我们的财务模型</span></div><div style=position:absolute;left:14pt;top:114.5pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:15.25pt;top:115.75pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>使命与专注</span></div><div style=position:absolute;left:14pt;top:128.75pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:15.25pt;top:130pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>人才与文化</span></div><div style=position:absolute;left:14pt;top:143pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:15.25pt;top:144.25pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>前沿与安全研究</span></div><div style=position:absolute;left:14pt;top:157.25pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:15.25pt;top:158.5pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>算力策略</span></div><div style=position:absolute;left:14pt;top:171.5pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:15.25pt;top:172.75pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>企业战略</span></div><div style=position:absolute;left:174.25pt;top:114.5pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:175.5pt;top:115.75pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>虚拟协作者</span></div><div style=position:absolute;left:174.25pt;top:128.75pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:175.5pt;top:130pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>平台及应用</span></div><div style=position:absolute;left:174.25pt;top:143pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:175.5pt;top:144.25pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>AI普及</span></div><div style=position:absolute;left:334.25pt;top:114.5pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:335.5pt;top:115.75pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>收入增长</span></div><div style=position:absolute;left:334.25pt;top:128.75pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:335.5pt;top:130pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>算力效率</span></div><div style=position:absolute;left:334.25pt;top:143pt;width:127pt;height:13pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:335.5pt;top:144.25pt;width:124.5pt;height:10.5pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.5pt;font-weight:600;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>运营效率</span></div><div style=position:absolute;left:111.5pt;top:216pt;width:84.5pt;height:15.5pt;background:#da7758></div><div class=zhimg style="position:absolute;left:112.5pt;top:217pt;width:82.5pt;height:13.5pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:500;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>改进循环</span></div><div style=position:absolute;left:276.5pt;top:232.25pt;width:75.75pt;height:16pt;background:#6b9bcc></div><div class=zhimg style="position:absolute;left:277.5pt;top:233.25pt;width:73.75pt;height:14pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:500;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>投资循环</span></div></div></div></div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:620.95pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们相信，AI在全球经济中的普及代表着历史上改善人类生活和工作方式的最大机遇之一，而这一进程才刚刚开始。我们认为，世界才刚刚开始使用当今前沿模型的能力，Claude能做什么与其被使用的广泛程度之间的差距，与前沿领域的持续进步一道，构成我们最大的增长机遇之一。近年来Claude的能力已显著演进，我们预计其将继续快速进步。这不仅将带来不断扩大的潜在市场，还将带来对世界不断扩大的影响范围。我们致力于确保这种影响尽可能积极。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.21pt;position:absolute;text-decoration:none;white-space:pre>180</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的核心优势</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:93pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">使命与专注。</span>我们的所有努力均以专注于使命这一唯一焦点为指引。这种专注使我们能够将人才、研究和算力投资集中于对人类最具价值的工作，并避免相互冲突的优先事项。实现我们的使命意味着世界在获得前沿AI巨大益处的同时，减轻最重大的风险，而我们相信，这需要安全与能力共同推进。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:147.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">人才与文化。</span>我们的使命与专注使我们能够吸引和留住世界一流的人才，包括希望其工作能塑造更美好未来的研究人员和工程师。我们还拥有一种文化，倡导营造谦逊低调、追求真理的环境，在这种环境中，前沿AI能力与安全相辅相成。我们相信，在我们规模扩张的过程中，我们的文化造就了我们的人才密度。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:202.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">前沿与安全研究。</span>我们相信，要构建能力最强、最安全的AI系统，必须在智能的前沿开展持续而专注的研究。我们的前沿能力研究与安全研究深度融合，直接影响模型的设计、训练和部署，帮助我们打造更可靠、更可控、更适合现实世界部署的系统，尤其是在要求严苛的企业环境中。我们将研究领先优势转化为创新速度，持续推出更优秀的模型、平台能力和应用。每一版Claude模型都协助构建下一版，有助于缩短开发周期，并使我们的创新速度获得复利式提升。我们将这一递归动态称为“闭环”，并认为这是前沿AI领域最重要的结构性优势之一，<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">并且能够大大加快能力进步的速度。我们相信，模型能力必须与安全、对齐和安保实践共同推进，尤其是在AI发展速度不断加快的情况下。我们在每个模型的开发期间以及发布前后评估其风险，并采取我们认为适当的措施，在模型能力与安全、对齐和安保之间取得平衡，即使这样做可能会放缓我们发布新能力的速度。我们将此类决策视为有意作出的权衡，我们之所以作出这些权衡，是因为它们服务于公司宗旨、我们使命的长期利益以及客户对安全且对齐的模型的需求。</span></div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:393.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">我们的算力策略</span>。我们将<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">来自多个战略合作伙伴的</span>算力作为单一的可互换资源池进行管理，并根据在任一特定时点预计哪一用途的边际单位产出最高，在各工作负载之间动态调配可用算力。我们相信，这一算力策略使我们能够交付更出色的模型、服务更多客户，并从算力投资中获得更高的生产率。这种算力效率为我们奠定了基础，使我们能够通过研究和模型开发推进AI能力的前沿、满足客户日益增长的需求，并支持Claude的内部使用。我们通过研究突破以及横跨AWS Trainium、Google TPU、NVIDIA GPU和AMD GPU的多芯片算力架构实现了这一点，使我们能够编排工作负载以优化价格与性能。为支持我们的研究、模型开发、客户需求及Claude的内部使用，我们持续进行规模化投资。截至2026年9月30日及其后，我们已订立采购承诺和租赁协议（包括短期承诺以及尚未开始的租赁），承诺支出总额超过<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">          </span>美元，其中几乎全部与算力及基础设施相关。这些承诺中约<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">          </span>美元预计将在2030年12月31日之前发生，剩余部分几乎全部预计将在2031年至2045年间发生。这些承诺中约<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">          </span>美元将在未来12个月内到期。更多信息，参见“管理层对财务状况及经营业绩的讨论与分析—流动性及资本资源—合同义务”一节。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:596.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">企业战略。</span>我们的企业战略建立在这样一种信念之上：前沿AI在现实世界场景中最具价值，因为在企业中的部署是经济影响最大、来自客户反馈的改进循环最丰富的地方。因此，我们围绕企业用例（从日常知识工作到最复杂的问题）来组织我们的研究重点、产品路线图以及市场推广团队和应用AI团队。我们收集的客户反馈指引我们的研究方向，并使Claude随着时间推移变得更加强大。这拓宽了Claude可部署的领域，并进一步扩大企业采用，从而有助于确保我们AI的益处能够规模化地惠及个人和组织。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:299.09pt;position:absolute;text-decoration:none;white-space:pre>181</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">企业对Claude的采用</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:93pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们企业客户采用的速度和深度，是Claude处于AI前沿地位的有力证明。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">截至2026年9月30日，我们的客户群包括：</span></div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:124.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">超过11,900家按过去十二个月计算贡献收入10万美元或以上的客户；</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:145.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">超过1,900家按过去十二个月计算贡献收入100万美元或以上的客户；以及</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:165.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">约250家按过去十二个月计算贡献收入1,000万美元或以上的客户。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:186pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">与服务于单一用例的静态产品不同，Claude是能力快速进步的前沿AI。我们在技术栈的三个层面进行构建：模型本身、在这些模型之上进行构建的平台，以及将Claude直接交到用户手中的应用。任一层面的进步都会在全部三个层面产生复合效应，加快我们交付能力更强的智能的步伐。我们相信，这种一体化方式的价值体现在同时使用Claude Platform和我们第一方应用的客户数量不断增加。截至2026年9月30日止三个月，在按过去十二个月计算贡献收入10万美元或以上的客户中，超过50%使用了Claude Platform以及至少一款我们的第一方应用，而截至2025年12月31日止三个月这一比例约为30%。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:286.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">如今，企业依靠Claude在复杂的工作流中进行推理、规划和执行，其可信度和判断力水平是我们相信前几代AI所无法提供的。客户主要通过三种方式从Claude中实现价值：员工生产率更高、流程更快，以及在其产品中嵌入智能。随着Claude能力的增长，我们的客户从中受益，并经常在新的工作流中扩大对Claude的采用。这一不断扩大的角色反映了Claude在企业内部使用方式的更广泛转变，即从响应离散提示词的工具转变为我们所称的虚拟协作者：一种与人类并肩工作、以专业水准完成复杂的多步骤工作的AI系统。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:386.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.17pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们主要通过使Claude可在多个产品界面上使用来推动其普及。例如：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:418.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude Platform是我们全面的智能体开发环境，为客户提供直接获取基础构件的途径，以便构建、部署和扩展其自有应用，从而在其自有产品和工作流中利用Claude的能力。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:461.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude Code是我们的编程智能体，与人类软件开发者并肩开展端到端的软件开发：在生产规模的代码库中编写、规划、编辑、测试、调试及提交代码。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:504.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.22pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude Cowork是我们的知识工作智能体，具备计算机使用（computer use）能力，使其能够与专业人士协作完成端到端的业务任务：自主开展研究、起草、分析、综合以及执行其他知识工作。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:547.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude的普及在很大程度上是自然发生的。我们通过市场推广团队和应用AI团队来放大这一效应，这些团队通过分销合作伙伴关系将Claude置于客户现有的技术栈之中，在客户所在之处与其对接，从而扩大我们的覆盖范围。例如，Claude可在全部三大云平台——AWS、GCP和Azure上使用。我们与这些CSP采取联合市场推广方式，据此我们与客户建立直接的合同关系，同时向每家CSP支付费用。这一结构使我们能够与这些CSP建立更紧密的商业协同、避免渠道冲突、自主定价，并实现算力效率持续提升所带来的财务收益。生态系统合作伙伴关系也扩大了我们的覆盖范围，使客户能够通过系统集成商（SI）（如Accenture、Deloitte、KPMG和PwC）、咨询顾问以及数据平台（如Salesforce和Snowflake）采用Claude。我们近期与领先的私募股权公司合作推出了一家AI服务公司Ode with Anthropic，旨在将Claude的能力带给各行业的中型企业，在Claude Platform上构建解决方案，并为客户提供长期支持。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.48pt;position:absolute;text-decoration:none;white-space:pre>182</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们财务模型的优势</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:93pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">构建和扩展前沿AI是历史上最重要、资本最密集的事业之一。我们的财务模型为我们提供了以下优势，使我们能够高效地构建和扩展：</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:124.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">收入快速增长。</span>我们的企业战略旨在通过将Claude直接嵌入业务关键型工作流并支持开发基于Claude的产品，推动持久的客户采用。我们相信，企业客户从Claude中获得了可观的投资回报，因为智能体工作流可以同时推动营收增长和效率提升。这使我们能够在客户中迅速扩展，截至2026年9月30日约900%的净收入留存率即为证明。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:202.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">算力效率</span>。我们的算力效率能够从研究和模型开发中获得更多智能，并且我们相信，与其他方式相比，这一方式能够以相同的算力支持更多的客户对Claude的使用及Claude的内部使用。截至2026年6月30日止三个月，我们的收入同比增长1,368%，而同期算力及基础设施费用同比增长300%，这体现了我们的算力效率。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:268.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">运营效率</span>。我们的运营效率源于高人才密度、高效的市场推广以及我们的团队在工作中对Claude的广泛运用，使我们能够以相较于其他大型企业科技公司更小的团队实现规模化。截至2026年9月30日，我们的过去十二个月人均收入超过660万美元，而截至2025年9月30日为140万美元，这体现了我们的运营效率。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:334.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的财务业绩体现了在持续投资前沿AI的同时实现的持续增长，具体如下：</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:366pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2026年6月30日止三个月，我们的收入为116亿美元，而截至2025年6月30日止三个月为7.87亿美元。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:397.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2026年6月30日止三个月，我们的经营利润率为8%，经营利润为10亿美元；而截至2025年6月30日止三个月，经营利润率为(152)%，经营亏损为12亿美元。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:441pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.2pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">收入增长、算力效率和运营效率相结合，使我们截至2026年6月30日止三个月的经调整经营利润率达到19%，经调整经营利润达到22亿美元；而截至2025年6月30日止三个月，经调整经营利润率为(129)%，经调整经营亏损为10亿美元。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:495.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们财务模型已展现的增长、规模和效率，有助于我们继续进行重大的长期投资，以负责任地构建前沿AI。我们的业务发展轨迹和财务状况使我们能够从投资者和合作伙伴处获取资本并确保算力。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">截至2026年6月30日，我们已累计筹集1,411亿美元资本，拥有现金及现金等价物1,124亿美元及短期投资193亿美元。</span>长期投资伴随着风险，因为我们必须预测未来多年的算力需求。然而，我们相信，我们的算力效率使我们能够在需求高于预测时放大回报，并能在需求低于预期或晚于预期到来时提供财务韧性。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:595.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的自我强化循环</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:616.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.22pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的规模和增长形成了自我强化循环，使Claude随着时间推移不断改进，我们相信这些循环创造了持久的竞争优势。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:648.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">改进循环</span>。Claude的企业部署加深了我们对客户最为关注的难题、边缘情况及特定领域挑战的理解。我们根据在其业务中于生产环境使用我们产品与服务的客户所提供的反馈，改进我们的模型、平台及应用。这些改进带来更广泛的部署和采用，进而推动下一轮改进。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.51pt;position:absolute;text-decoration:none;white-space:pre>183</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">投资循环</span>。不断扩大的企业采用所带来的收入，帮助我们为改进Claude所需的算力、研究和人才提供资金。Claude不断进步的能力扩大了客户使用Claude的任务和工作流范围，拓宽了我们的潜在市场，并推动更深入的部署、更多的收入以及对Claude的持续再投资。</div></div><div style=position:absolute;top:126.6pt;width:612pt><div style=left:72pt;position:absolute><div style=position:absolute><div style=position:relative;width:468pt;height:247.75pt;overflow:hidden><img style=display:block;height:247.75pt;width:468pt src=data:image/jpeg;base64, alt=business2a.jpg width=624 height=330.328125><div style=position:absolute;left:109pt;top:47pt;width:36pt;height:20.5pt;background:#eccece></div><div class=zhimg style="position:absolute;left:110pt;top:48pt;width:34pt;height:18.5pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8pt;font-weight:600;color:#141412;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>更优模型</span></div><div style=position:absolute;left:323pt;top:47pt;width:36pt;height:22pt;background:#d2cfc6></div><div class=zhimg style="position:absolute;left:324pt;top:48pt;width:34pt;height:20pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8pt;font-weight:600;color:#141412;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>更高增长</span></div><div style=position:absolute;left:6.5pt;top:126.5pt;width:44.5pt;height:20.5pt;background:#ecc9b6></div><div class=zhimg style="position:absolute;left:7.5pt;top:127.5pt;width:42.5pt;height:18.5pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8pt;font-weight:600;color:#141412;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>更多用例</span></div><div style=position:absolute;left:414pt;top:126.25pt;width:50pt;height:21pt;background:#c5d3e0></div><div class=zhimg style="position:absolute;left:415pt;top:127.25pt;width:48pt;height:19pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8pt;font-weight:600;color:#141412;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>更多投资</span></div><div style=position:absolute;left:105.25pt;top:204.5pt;width:43.25pt;height:20.5pt;background:#d2cfc6></div><div class=zhimg style="position:absolute;left:106.25pt;top:205.5pt;width:41.25pt;height:18.5pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8pt;font-weight:600;color:#141412;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>更多反馈</span></div><div style=position:absolute;left:315.5pt;top:204.5pt;width:52pt;height:21.5pt;background:#bcd1ca></div><div class=zhimg style="position:absolute;left:316.5pt;top:205.5pt;width:50pt;height:19.5pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8pt;font-weight:600;color:#141412;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>更多能力</span></div><div style=position:absolute;left:89.5pt;top:118.5pt;width:75.5pt;height:13pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:90.5pt;top:119.5pt;width:73.5pt;height:11pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8pt;font-weight:600;color:#141412;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>改进循环</span></div><div style=position:absolute;left:307.75pt;top:118pt;width:67.5pt;height:13.5pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:308.75pt;top:119pt;width:65.5pt;height:11.5pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8pt;font-weight:600;color:#141412;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>投资循环</span></div><div style=position:absolute;left:209.25pt;top:132.75pt;width:49.5pt;height:21.5pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:210pt;top:133.5pt;width:48pt;height:20pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.75pt;font-weight:400;color:#72716c;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>前沿智能</span></div></div></div></div></div><div style=line-height:7.56pt;position:absolute;top:388.35pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude正在加速我们实现闭环的能力</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:409.35pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude本身已成为我们进步最强大的驱动力之一——每一版新的Claude模型都直接加速下一版的开发。后续各代模型的研究、训练和测试的诸多方面现已有Claude参与，包括运行实验、生成和处理训练数据、自动化评估和安全审计，以及编写和审查代码。我们将这一递归动态称为“闭环”。这一动态的直接体现是我们产出算力倍增因子的速度不断加快。能力更强的模型帮助我们的研究人员更快地发现这些改进；反过来，更强大的算力倍增因子使我们能够训练能力更为强大的模型，并<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">更高效地部署这些模型。</span></div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:509.55pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400">我们实现闭环能力的一个清晰例证，是在我们整个工程组织中部署我们的智能体编程产品Claude Code。随着我们模型的进步，我们看到Claude在更具挑战性、开放式的工程问题上的能力显著提升，这些问题缺乏明确的规格说明，历来依赖经验丰富的人类判断。</span>根据我们的内部基准测试，Claude在这些问题上的成功率在2026年9月达到约90%，在九个月内提升了约50个百分点。Claude Code已从建议代码发展到直接编写和运行代码，并能在较长时间跨度内自主处理复杂的多步骤工程任务。这使我们的工程师能够越来越多地指导和审查其工作，而非逐行编写代码。因此，截至2026年9月30日止三个月，我们每名工程师平均每日向代码库贡献的代码量是截至2024年12月31日止年度平均每日代码量的45倍以上。2026年9月，我们代码库中超过90%的贡献是由Claude编写的。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:643.95pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude的影响不止于研究和工程领域。从2024年12月31日至2026年9月30日，我们的员工人数增至原来的五倍以上，而我们截至2026年9月30日止三个月的收入是截至2024年12月31日止三个月收入的86倍。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:687.15pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.22pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们相信，这种经营杠杆是由Claude在我们整个组织中的使用所推动的。在我们的研究、工程、市场推广和运营团队中，Claude使员工能够在日常工作中借助一支</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.45pt;position:absolute;text-decoration:none;white-space:pre>184</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.16pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">智能体团队，通过成倍放大每个人的影响力，使一支规模相对较小的团队能够承担传统上需要规模大得多的团队才能完成的工作。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:103.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们自身对Claude使用的扩大直接体现了这种杠杆效应。按标价计算，我们内部Claude使用的价值从2026年1月至2026年9月增至原来的250倍以上，并且在2026年4月，这一月度价值首次超过了我们的月度人员费用（不包括股权激励）。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400">由于每一版Claude都被用于帮助构建下一版，且Claude提升了我们全公司各团队的生产率，我们相信，我们投入内部使用的算力会使这些收益产生复利效应，持续加快我们的开发步伐，并进一步巩固我们的领先地位。</span></div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:181.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">利用AI帮助构建能力更强的AI也可能带来相当大的安全风险，尤其是如果这会急剧加快进步速度的话。这是我们的负责任扩展政策所涵盖的领域之一，该政策阐明了我们在接近所谓“递归式自我改进”时监测和减轻相关风险的计划。</div></div><div style=line-height:9.07pt;position:absolute;top:235.8pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">AI正在变革智能</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:259.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.22pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们相信，强大AI——一种能力极强、影响深远的前沿AI形态，具有以下关键特征——将在数年内得到广泛普及：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:291pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">在大多数专业和科学学科中，认知能力达到或超过顶尖人类专家；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:322.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.21pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">能够操作远程办公的人类可使用的所有界面，包括文本、音频、视频及直接的计算机控制；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:354.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">能够在较长时间内（持续数小时、数天或数周）自主推理完成复杂任务，并在需要时寻求澄清和反馈；</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:386.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">能够在多个实例之间进行协调，并与人类及其他AI系统协作；以及</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:418.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">能够通过数字连接以数字方式控制实验室设备、机器人系统及其他机器，从而与物理世界交互。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:450pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">如果强大AI被用于解决人类最棘手的问题，且其风险得到负责任的管理，其潜力将是非凡的。其可能性包括：将数十年的科学进步压缩至数年之内；加速药物发现、疾病检测及个性化疗法的提供；提供个性化定制的教育以及专业的财务和法律建议；推进电网和电池设计以提高效率和可靠性；以及将富裕国家耗费数代人才建立起来的能力推广至发展中国家。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:527.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">规模定律与进展的可预测性</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:548.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">AI系统的智能和能力已取得巨大进步。就在几年前还超出AI系统能力范围的任务，例如复杂的数学推理、设计科学实验以及执行软件开发中相当大一部分的工作，如今已由AI例行完成。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:591.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">这些进步遵循了经验性的“规模定律”（“Scaling Laws”），即AI模型的性能随着模型规模、训练数据和算力的增加而可预测地提升这一发现。奠基性论文<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">《Scaling Laws for Neural Language Models》</span>的主要作者（包括Dario Amodei、Jared Kaplan、Sam McCandlish和Tom Brown）后来共同创立了Anthropic，该论文对确立这些关系起到了关键作用，并帮助引领了现代大语言模型（LLM）的浪潮。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:657.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们预计，AI能力——涵盖语言、推理、数学、编程、科学分析以及范围不断扩大的智能体任务和知识工作——将在未来多年持续进步。因此，我们相信，这将推动对AI的需求在可预见的未来超过供给，而主要的制约因素是算力的可获得性。我们相信，这一需求的大部分将集中于前沿：根据我们的经验，企业在各种各样的工作负载中都倾向于选择我们能力最强的模型，</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style="background-image:url(data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20style=%22pointer-events:none%22%3E%3Cpath%20style=%22fill:transparent;stroke:%23000;stroke-width:.5pt%22%20d=%22M96%20876.53H288%22/%3E%3C/svg%3E);background-size:612pt 792pt;height:792pt;position:absolute;width:612pt;z-index:-9223372036854775805"></div><div style=position:absolute;top:662.4pt><div style=width:468pt><div style=line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);width:612pt><div class=zh style="position:absolute;top:-1.77pt;left:90pt;width:451.79pt;line-height:9.6pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:-18pt;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:5.2pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.117pt">6</span> 有关我们如何计算全球知识工作者所创造年度经济价值的说明，参见“行业、市场及其他数据”一节。</div></div><div style=line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:19.2pt;width:612pt><div class=zh style="position:absolute;top:-1.78pt;left:90pt;width:451.83pt;line-height:9.6pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:-18pt;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:5.2pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.117pt">7</span> IDC，The Economic Impact of AI: 2026 Edition，文件编号US54452226，2026年4月。反映AI解决方案和服务、AI基础设施供应链投资以及由AI释放的企业生产率和效率提升所创造的年度价值。</div></div><div style=line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:48pt;width:612pt><div class=zh style="position:absolute;top:-1.98pt;left:72pt;width:468pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:5.2pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.117pt">8</span> IDC，Worldwide Black Book: Live Edition V2 2026 Forecast，2026年7月。</div></div></div></div><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.62pt;position:absolute;text-decoration:none;white-space:pre>185</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">包括其最高价值的工作。此外，我们相信，前沿的每一次扩展都将解锁新的工作类别，而这些新的工作类别反过来将产生行业增量需求的大部分。我们预计，行业将继续增加对算力、研究人才和工程资源的投资，以推进AI的前沿。在这一框架下，拥有专有训练方法、高质量数据和差异化研究人才的研究实验室处于有利地位，能够超越仅凭规模所能预测的表现。</div></div><div style=line-height:7.56pt;position:absolute;top:138pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">变革认知工作的近期机遇</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:159pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">前沿AI正在变革认知工作——即运用知识、推理和判断来创造经济价值。我们相信，它将使人类的能力大幅提升，并扩大全球从事此类工作的整体能力，包括加速科学发现和帮助企业成长。知识工作者处于这一机遇的最前沿。随着前沿AI的进步，能力更强的模型可以解锁全新的用例，同时还能在能力-成本-速度曲线上高效地规模化服务于广泛的认知工作。我们相信，2025年全球知识工作者所从事的工作代表了超过40万亿美元的经济价值，<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:6.175pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.513pt">6</span>而凭借前沿AI显著提升其生产率的潜力，我们的近期机遇在于扩大这一价值并加速经济增长。尽管现在预测前沿AI对整体经济的全面影响仍为时尚早，但IDC估计，到2031年，对AI解决方案和服务的投资将产生22.5万亿美元的累计全球经济影响。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:6.175pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.513pt">7</span>我们相信，其影响可能会更大。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:293.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">历史表明，变革性技术会扩大其所进入的市场。例如，信息技术支出从2006年的约1.2万亿美元增长至2025年的4.3万亿美元，复合年增长率约为7%，同期云计算支出从零增长至1.9万亿美元，并扩大了信息技术预算。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:6.175pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.513pt">8</span>我们也看到其他技术，包括个人电脑、互联网和智能手机，同样扩大了其市场。打造这些技术的公司的增长速度远超整体经济。根据世界银行的数据，全球GDP从2000年的约34万亿美元增长至2025年的超过118万亿美元，增至原来的三倍以上。在同一期间，按截至2026年9月30日的市值计算的十大上市科技公司，其合计收入从680亿美元增长至超过2.5万亿美元，增至原来的约38倍，约为全球GDP增速的11倍。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:416.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">前沿AI或将重塑整个行业并加速全新发现</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:437.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们相信，前沿AI代表着比以往任何技术周期都更大的机遇，而Claude已在展现这一潜力。Claude如今能够在数小时乃至数天内自主执行复杂项目，并行协调数以千计的智能体，开展复杂的规划、长篇研究和自我纠错式分析。Claude还能将开放式任务转化为完整、高质量的交付成果——而就在不久前，这类工作还超出前沿AI的能力范围。这些能力使Claude能够变革全球经济中规模最大的行业，包括软件开发、商业和专业服务、网络安全、金融服务以及医疗健康和生命科学，为部署Claude的组织带来生产率和产出的显著提升。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:537.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">网络安全是我们最重要的近期机遇之一。随着每一代新AI模型在发现和利用漏洞方面的能力不断增强，我们预计，保护企业网络和关键基础设施将越来越需要前沿AI。与此同时，随着各组织以不断加快的速度部署智能体和自主能力，AI的普及正在扩大威胁面。我们在编程领域的领先地位使我们得以提升Claude的网络安全能力，并打造帮助企业保护其最关键基础设施的产品。例如，Claude Security能够持续扫描客户的代码库、对漏洞进行分级处理并编写修复程序。我们最近还推出了OSS Scanner，将上述部分能力扩展至企业软件所依赖的开源项目。通过我们的受信访问计划，经审核的网络防御人员还可以将我们能力最强的模型用于安全</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style="background-image:url(data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20style=%22pointer-events:none%22%3E%3Cpath%20style=%22fill:transparent;stroke:%23000;stroke-width:.5pt%22%20d=%22M96%20940.53H288%22/%3E%3C/svg%3E);background-size:612pt 792pt;height:792pt;position:absolute;width:612pt;z-index:-9223372036854775805"></div><div style=position:absolute;top:710.4pt><div style=width:468pt><div style=line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);width:612pt><div class=zh style="position:absolute;top:-1.98pt;left:72pt;width:468pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:5.2pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.117pt">9</span> IQVIA Institute for Human Data Science，Global Medicine Use Trends 2026，2026年2月。</div></div></div></div><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.44pt;position:absolute;text-decoration:none;white-space:pre>186</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">运营、事件响应及经授权的渗透测试，从而推动安全转向持续保护模式。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:103.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">随着Claude的前沿能力超越现有市场、开辟全新市场，延伸至机器人、先进制造和物流等领域，并加速包括药物发现和材料科学在内的科学研究进展，我们预计其他行业也将跟进。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:147pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">例如，在生命科学领域，2026年全球年度药品支出预计将超过2万亿美元，<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:6.175pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.513pt">9</span>我们的客户、我们的生物技术合作伙伴以及我们自己的研究人员均在药物发现和开发中使用Claude。我们还在将Claude拓展至机器人领域，我们的Model Hardware Standard（模型硬件标准）使AI智能体能够操作实验室和制造设备，如显微镜、液体处理器和现成的机械臂。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:213pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">归根结底，我们相信前沿AI将有助于推动全球经济增长。随着前沿AI提升劳动者和组织的生产力、嵌入其所提供的产品和服务之中并催生新的商业模式，它将创造此前并不存在的经济产出。我们相信，我们的机遇在于，随着全球经济扩张，不仅获取当今经济活动中的一部分份额，还获取上述新创造产出中的一部分份额。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:279pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">安全与合乎伦理的行为的重要性</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:300pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">尽管AI的潜在益处非凡，但其快速发展将以可能造成重大冲击的方式影响经济和社会，尤其是在该技术未以负责任的方式开发和部署的情况下。例如，不法分子已经利用AI的能力实施了引人注目的网络攻击，以发现漏洞、生成恶意软件并规避检测工具；与滥用相关的其他风险（包括生物领域的风险）可能造成更大的危害。规模化部署的AI还可能以侵蚀信任、危害社会和破坏地缘政治秩序稳定的方式，在国家内部及国家之间集中权力和财富。未对齐的AI系统可能通过其用户和运营者无法察觉或理解的自主行动，破坏机构决策或造成大规模危害。我们相信，前沿AI公司必须在安全与对齐方面进行投入，以帮助确保这项技术的负责任普及。我们还相信，安全、对齐及合乎伦理的行为在企业中尤其能引起强烈共鸣——在企业为关键任务型工作负载选择AI合作伙伴时，严格的安全保障措施、可预测的模型行为以及可证明的问责机制已成为决定性标准。</div></div><div style=line-height:9.07pt;position:absolute;top:457.2pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的核心优势</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:480.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.17pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们拥有五大核心优势，奠定了我们处于前沿的地位：我们的使命与专注、我们的人才与文化、我们的前沿与安全研究、我们的算力策略以及我们的企业战略。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:512.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">使命与专注</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:533.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400">Anthropic由一支研究人员团队于2021年创立，该团队曾取得许多定义前沿AI的重大突破。</span>他们共同秉持一种信念：安全必须是构建强大AI的基本原则。我们拥有与该目标相一致的公司架构，以特拉华州PBC形式注册成立，并设立了明确以推进我们的使命为职责的LTBT。此外，我们公开发布安全方法论、模型评估以及我们的负责任扩展政策，因为我们相信，透明是信任的前提，而信任是规模化地负责任部署前沿AI的前提。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:610.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Anthropic的每一位员工都朝着同一使命努力，该使命指导着每一项决策——从模型架构、产品战略、合作条款，到我们如何引导研究方向和调配算力。我们不会仅凭商业机会或研究新颖性来开展项目；我们的工作必须推进我们的使命。当商业利益与安全或信任之间出现艰难取舍时，我们有明确的答案。例如，2026年4月，鉴于我们的前沿模型Mythos在网络漏洞发现方面的先进能力，我们最初通过Project Glasswing将其作为受限访问的研究预览版发布，向特定组织提供，用于网络安全应用，而非在发布时即广泛开放。我们相信，这种</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.74pt;position:absolute;text-decoration:none;white-space:pre>187</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">使命的清晰性能够减少摩擦、加快决策，并培育一种安全与能力齐头并进的文化。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:103.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">人才与文化</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:124.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">人才是我们最重要的优势之一，因为技术、资本、产品和分销均源于卓越的人才。人才密度比人才规模更重要。才华横溢的人在同样才华横溢的同事身边会受到激励和鼓舞，从而形成吸引更多杰出人才的环境。这些人才可以借助Claude最大限度地发挥每个人的影响力。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:179.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们相信，我们已汇聚了全球最密集的AI研究人才，其中包括许多开创了现代大语言模型（LLM）基础技术的研究人员。我们的创始团队首创了AI领域的多项基础性进展，包括规模定律（Scaling Laws）、GPT-2和GPT-3、基于人类反馈的强化学习（RLHF）以及机制可解释性。我们坚信安全与能力必须同步推进，这一信念有助于我们吸引和留住包括研究人员和工程师在内的世界一流人才。例如，在截至2026年9月30日的过去十二个月（TTM）期间，我们全体员工的遗憾性人才流失率为<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">约1%</span>。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:256.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们始终致力于开放的内部协作和求真，这一承诺以我们谦逊低调、注重影响力且与使命一致的文化为基础。研究人员公开分享成果，同事们实时提出批评并调整方向。当多个团队并行采用不同方法时，惯例是严格评估哪种方法展现出更强且更符合对齐要求的结果。这种协作氛围难以复制，因为它既需要我们自组织创立之初便建立起来的信任基础，也需要坚持不懈地维护这种信任。这种信任以在我们这种规模下并不常见的方式体现出来：各团队始终朝着同一方向发力，而非彼此掣肘。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:345.6pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:72pt;width:468pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们相信，在我们规模扩大的过程中，我们的文化成就了我们的人才密度。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:366pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">前沿与安全研究</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:387pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们在前沿模型方面的领先地位是我们人才密度的直接成果。我们相信，我们的研究人员在智能、能力和可靠性方面不断突破边界，其程度一直超过规模更大或预算更多的团队。Claude在各行业真实任务中的表现获得广泛认可，包括编程、医学、法律、科学和数学。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:441.6pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:72pt;width:468pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的研究方式为我们的业务带来了关键优势：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:462pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">我们的模型研究与算力性能从一开始便协同设计</span>。架构决策从第一天起便考虑算力效率。我们的模型架构与推理基础设施在一个统一的流程中设计。AI研究人员与推理基础设施工程师共享规划周期、汇报关系和性能目标。这种方式使我们能够开发出相较于以往版本能力更强、效率更高的模型版本。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:539.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">我们的预训练流程专为资本效率而设计</span>。我们专注于一条清晰的流程，用于开发在架构、训练方法和数据方面的模型改进。这些改进在消耗大量算力之前先在较小规模上进行测试。纳入前沿训练运行的门槛很高，且严格以证据为依据：我们要求证明某项改进在模型规模增大时依然有效，而不仅仅是在缩小规模下表现良好。前沿训练运行是有计划、有排期的资本部署，具有已知的投入和严格的纳入标准。由此形成了一套可重复的流程，能够将研究投入转化为能力提升，同时管控前沿训练运行固有的风险。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:639.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">我们的后训练投入专为智能体能力而打造</span>。后训练已从收尾步骤发展为一项重大研究投入，这反映了市场从助手向智能体的转变。正是在这一阶段，我们的模型磨炼其编写代码、使用工具、遵循指令以及代表用户操作软件的能力。我们针对完整、真实的任务进行训练，这些任务的复杂程度反映了真实的专业工作。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.3pt;position:absolute;text-decoration:none;white-space:pre>188</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">我们的安全研究是一项商业优势</span>。随着模型承担起能够访问关键业务系统的智能体角色，信任和可靠性至关重要。而且，随着能力的提升，安全运行的能力成为决定商业可行性的关键因素之一。对齐良好的模型更善于遵循用户的指令——例如，它们会避免在未充分理解用户意图的情况下采取可能具有破坏性的行动。它们在抵御提示注入等攻击方面也更为稳健，在此类攻击中，恶意行为者试图通过向模型输入非法指令来劫持模型。我们在对齐、可解释性研究、安全保障措施和红队测试方面的工作，以及借助能够评估我们安全实践的外部审查人员，有助于我们打造更安全、更可靠的模型，从而使我们能够满足客户的严格要求。安全研究与能力研究相互融合，这使我们能够提供企业工作流所需的信任和性能。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:206.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的算力策略</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:227.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.17pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的算力策略始于训练这样的模型：其设计目标是在任何特定类型的算力上都具备更强的能力并更高效地运行。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:259.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们构建能力更强的模型并更高效地提供服务的能力，体现了预训练、后训练和推理研究之间迭代循环所带来的复利回报，而这一切均得益于我们的可互换算力池。预训练和后训练研究产生专有的算力倍增因子，使我们的模型能力更强。研究和推理工程推动为这些模型提供服务所需算力的持续降低。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:325.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">除了使模型能力更强、效率更高之外，我们横跨AWS Trainium、Google TPU、NVIDIA GPU和AMD GPU的多芯片算力架构使我们能够编排工作负载，以实现价格和性能的优化。我们在多个芯片家族上有效训练和运行模型方面拥有多年经验，我们相信这一点具有差异化优势且难以复制。这一基础，加上Claude对芯片和模型架构日益加深的理解，使我们能够以过去所需时间的一小部分接入新的芯片平台。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:402.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的算力池在设计上即可互换。我们进行了大量工程投入，构建了内部编排、调度和容量管理系统，使加速器容量无论来自哪家提供商、采用何种芯片架构或位于何处，均可在各工作负载之间调配。为客户工作负载提供服务的同一基础设施也被调配用于研究、模型开发<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">以</span>及Claude的内部使用。这些系统将底层硬件作为统一的容量池进行管理，监控整个池的利用率和需求，并在任何特定时间将算力调配至预计最具生产力之处。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:491.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400">与依赖单一平台相比，我们的多芯片算力策略为我们提供了显著更多的芯片获取渠道，并使我们能够适时获取每个芯片家族及每代芯片的性价比优势</span>。确保这种获取渠道需要大量的预先承诺。鉴于从签订算力合同到该算力可用于服务工作负载之间的交付周期较长，我们会在预期需求出现之前提早锁定算力。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400">在某些情况下，我们还可能在设备或基础设施交付之前预先付款。</span>我们预计在可预见的未来将进行大量投资，包括在算力及基础设施方面的投资，以确保我们拥有维持并扩大我们在AI前沿地位所需的技术资源。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:591.6pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">企业战略</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:612.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的企业战略与我们的使命相一致。我们针对需要最高智能的问题打造能力最强的模型。同样的智能也被高效地应用于日常工作——根据每项任务的难度调整投入，并将工作负载分配给我们模型家族中最适合的模型。因此，我们遍布全球的客户正在从日常知识任务到其最重要问题的广泛工作中采用Claude。目前，Claude已在各主要行业中部署用于知识工作，包括金融服务、保险、医疗健康、生命科学、法律、教育、零售与商业、电信、专业服务、科技以及网络安全。除实际的企业挑战外，Claude还被应用于科学研究、药物发现、教育和气候分析等领域的紧迫全球性问题。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.44pt;position:absolute;text-decoration:none;white-space:pre>189</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们打造我们的模型、平台及应用，着眼于在生产环境中的实用性，而非基准测试表现。这一区别至关重要，因为许多AI系统在复杂的企业环境中被证明难以实施，且无法实现预期价值，而在此类环境中，治理和安全方面的顾虑仍然是采用的首要障碍之一。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:126.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的应用，如Claude Code和Claude Cowork，能够成倍提升员工的影响力。随着时间推移，我们的应用能力不断增强，目前经常被用于与员工并肩开展长时间运行的自主工作。各组织还将Claude作为驱动并变革内部业务流程的智能进行集成。此外，我们的Claude Platform被用作企业构建AI原生产品的基础。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:192.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">随着企业客户将Claude集成到日益复杂的工作流中，他们会提出塑造我们路线图的用例和需求。他们还提供反馈，使我们能够持续改进我们的模型、平台及应用，并开发新的解决方案以推进其AI采用。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:235.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">随着每一次模型和产品的进步，Claude能够应对更有价值的用例，在深化对现有客户影响的同时降低新客户的采用门槛。当某个模型跨越某类工作所需的能力、可靠性和信任门槛时，该类别的采用通常会迅速从试验阶段进入生产阶段。编程是第一个此类类别：在大约一年的时间里，Claude从建议单行代码发展到操作在生产代码库中自主工作的智能体集群。网络安全正沿着类似的曲线发展，Claude在ExploitBench（由Carnegie Mellon研究人员开发、用于评估AI模型利用软件漏洞能力的基准测试）上的表现在大约四个月内从Opus 4.8的40%提升至Claude Mythos 5的78%，再提升至Opus 5.5的91%。网络防御人员目前正在规模化地识别和修补漏洞。我们预计模型能力的这些提升将解锁更多用例。Claude Security和我们最近推出的OSS Scanner是早期例子，能够持续扫描代码库，并在攻击者发现漏洞之前提出修复方案。</div></div><div style=line-height:9.07pt;position:absolute;top:381.6pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">作为虚拟协作者的Claude</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:405pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们相信，我们已到达一个拐点，AI系统能够在专业工作中作为真正的协作者发挥作用。它们能够快速完成实质性任务，而这些任务原本可能需要一名熟练的专业人员耗费数小时、一整天甚至更长时间。AI系统也越来越有能力执行以往因难度过大或成本过高而无法完成的任务，或提出原创的见解和分析。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:459.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">我们将这些与人类并肩工作、以专业水准完成复杂多步骤工作的AI系统称为虚拟协作者。虚拟协作者拥有其所在组织授予的访问权限、</span>系统连接和上下文，从而能够更准确、更可靠地发挥作用。它们能够浏览和使用内部工具，并执行跨越多个步骤、需要持续推理的工作流。虚拟协作者是旨在嵌入工作发生之处的AI，我们的目标是</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style="background-image:url(data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20style=%22pointer-events:none%22%3E%3Cpath%20style=%22fill:transparent;stroke:%23000;stroke-width:.5pt%22%20d=%22M96%20940.53H288%22/%3E%3C/svg%3E);background-size:612pt 792pt;height:792pt;position:absolute;width:612pt;z-index:-9223372036854775805"></div><div style=position:absolute;top:710.4pt><div style=width:468pt><div style=line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);width:612pt><div class=zh style="position:absolute;top:-1.98pt;left:72pt;width:468pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:5.2pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.117pt">10</span> IDC，Worldwide Developer Population Growth Forecast, 2025–2029，doc # US53789825，2025年9月。</div></div></div></div><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.36pt;position:absolute;text-decoration:none;white-space:pre>190</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="posi