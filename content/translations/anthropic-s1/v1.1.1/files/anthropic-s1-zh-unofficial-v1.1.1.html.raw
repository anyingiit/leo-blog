t;vertical-align:top></td><td style="background-color:#ecebe3;border-bottom:3pt double #000;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:334.5pt;position:absolute;top:169.5pt;width:65.25pt><div><div style=line-height:7.18pt;position:absolute;top:3.52pt;width:65.25pt><font style=color:#000;font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;white-space:pre><font style=left:2.63pt;position:absolute>$<font style=display:inline-block;height:7.18pt;width:29.91pt></font></font><font style=left:38.330000000000005pt;position:absolute>1,079<font style=display:inline-block;height:7.18pt;width:3.56pt></font></font></font></div></div></div></td><td style=background-color:#ecebe3;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#ecebe3;border-bottom:3pt double #000;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:402.75pt;position:absolute;top:169.5pt;width:65.25pt><div><div style=line-height:7.18pt;position:absolute;top:3.52pt;width:65.25pt><font style=color:#000;font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;white-space:pre><font style=left:2.63pt;position:absolute>$<font style=display:inline-block;height:7.18pt;width:36.56pt></font></font><font style=left:44.980000000000004pt;position:absolute>443<font style=display:inline-block;height:7.18pt;width:3.56pt></font></font></font></div></div></div></td></tr></tbody></table></div></div></div><div style=line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:460pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:71.96pt>______________</font></div><div style=line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:469.6pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:9.43pt>(1)</font><div class=zh style="position:absolute;top:-1.98pt;left:90pt;width:450pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2025年12月31日，本公司并无融资租赁。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:488.2pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">尚未开始的租赁</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:509.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2025年12月31日及2026年6月30日（未经审计），本公司已订立主要与算力及基础设施容量相关但尚未开始的租赁协议，预计未来未折现租赁义务总额<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400">分别</span>约为502亿美元及3,214亿美元，其中部分安排须以满足若干合同条件为前提。该等租赁义务将于2026年至2028年间开始，租赁期限为不足一年至20年不等。本公司可能选择通过发行可转换本票履行其部分义务。详见附注9。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:598pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">通过合并可变利益实体持有的租赁</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:619pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">本公司合并若干为融资及部署算力及基础设施容量而设立的可变利益实体（VIE）。截至<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">2026年6月30日</span>（未经审计），除该等VIE订立的任何合同或文书中可能明确规定的情况外，一般不可用于清偿该等VIE以外任何人士之义务的资产为<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">2.96亿美元</span>，主要计入经营租赁使用权资产。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:673.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">本公司为若干VIE义务提供担保，因此若干<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">VIE的</span>债权人对本公司的一般信用拥有追索权。截至<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">2026年6月30日</span>（未经审计），与该等VIE相关的负债为<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">3.28亿美元</span>，主要包括<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">3.10亿美元</span>租赁负债，其中<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">2.57亿美元</span>计入经营租赁负债（非流动）。本公司可能就若干VIE租金义务，</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:0;width:612pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">F-36</div></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div><div style=line-height:7.18pt;position:absolute;top:24.3pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:0;width:612pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">Anthropic, PBC</div></div><div style=line-height:7.18pt;position:absolute;top:35.7pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:0;width:612pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">合并财务报表附注（续）</div></div></div></div><div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">以发行可转换本票代替现金的方式予以履行。该等VIE为<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">本公司</span>在可转换本票项下的义务提供担保，并向出租人授予租赁资产的担保权益以担保该等义务，担保金额以向出租人发行的未偿付票据金额为限。截至<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">2026年6月30日</span>（未经审计），尚未发行任何可转换本票。详见附注9<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">。截至2025年12月31日，该等合并VIE的资产及负债并不重大</span>。</div></div><div id=ica694c859b8e458dbf6a73f56dde9d42_1818 style=position:absolute;top:138pt></div><div style=font-size:12pt;line-height:9.07pt;position:absolute;top:138pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">8. 补充财务信息</div></div><div style=line-height:7.56pt;position:absolute;top:161.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">现金、现金等价物及受限制现金</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:182.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.2pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text