ecebe3;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#ecebe3;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:146.25pt;position:absolute;top:46.5pt;width:45pt><div><div style=line-height:6.05pt;position:absolute;top:2.63pt;width:45pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:2.63pt;position:absolute;text-decoration:none;white-space:pre>150亿</font></div><div style=line-height:6.05pt;position:absolute;top:10.63pt;width:45pt><div class=zh style="position:absolute;top:-1.98pt;left:2.63pt;width:41.37pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">美元<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:5.2pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.117pt">(2)</span></div></div></div></div></td><td style=background-color:#ecebe3;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#ecebe3;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:194.25pt;position:absolute;top:46.5pt;width:45pt><div><div style=line-height:6.05pt;position:absolute;top:2.63pt;width:45pt><font style=color:#000;font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;white-space:pre><font style=left:2.63pt;position:absolute>$<font style=display:inline-block;height:6.05pt;width:26.9pt></font></font><font style=left:34.4pt;position:absolute>—<font style=display:inline-block;height:6.05pt;width:3pt></font></font></font></div></div></div></td><td style=background-color:#ecebe3;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#ecebe3;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:242.25pt;position:absolute;top:46.5pt;width:45pt><div><div style=line-height:6.05pt;position:absolute;top:2.63pt;width:45pt><div class=zh style="position:absolute;top:-1.98pt;left:0;width:45pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">不适用</div></div></div></div></td><td style=background-color:#ecebe3;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#ecebe3;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:290.25pt;position:absolute;top:46.5pt;width:45pt><div><div style=line-height:6.05pt;position:absolute;top:2.63pt;width:45pt><div class=zh style="position:absolute;top:-.98pt;left:2.63pt;width:40.85pt;line-height:8pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">自发行之日起10年</div></div></div></div></td><td style=background-color:#ecebe3;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#ecebe3;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:338.25pt;position:absolute;top:46.5pt;width:45pt><div><div style=line-height:6.05pt;position:absolute;top:2.63pt;width:45pt><div class=zh style="position:absolute;top:-1.98pt;left:0;width:45pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">不适用<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:5.2pt;font-style:normal;font-weight:400;text-decoration:none;position:relative;top:-2.117pt">(2)</span></div></div></div></div></td><td style=background-color:#ecebe3;font-size:0;text-align:left;vertical-align:top></td><td style="background-color:#ecebe3;border-top:1pt solid #000;font-size:0;text-align:left;vertical-align:top"><div style=left:386.25pt;position:absolute;top:46.5pt;width:81.75pt><div><div style=line-height:6.05pt;position:absolute;top:2.72pt;width:81.75pt><div class=zh style="position:absolute;top:-.98pt;left:2.63pt;width:76.73pt;line-height:8pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">每次提款通过发行我们的N类普通股股份结算，价格相当于截至相关算力产能里程碑达成之日我们A类普通股的前30日成交量加权平均价格，但须受持股上限的限制。</div></div></div></div></td></tr></tbody></table></div></div></div><div style=line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:616.3pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:71.96pt>______________</font></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:625.9pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:9.43pt>(1)</font><div class=zh style="position:absolute;top:-1.98pt;left:90pt;width:450pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2026年6月30日。</div></div><div style=font-size:12pt;line-height:6.05pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:635.5pt;width:612pt><font style=font-family:georgia,serif;font-size:8pt;font-style:normal;font-weight:400;left:72pt;position:absolute;text-decoration:none;white-space:pre;width:10.46pt>(2)</font><div class=zh style="position:absolute;top:-1.98pt;left:90pt;width:450pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们预计在本次发行完成之前不会根据Amazon 2026 NPA发行任何票据。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:654.1pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">根据Amazon 2026 NPA发行票据或股份的期限截至以下两者中较早者：(i)本次发行后30个月；及(ii)我们与Amazon之间若干商业协议终止之时。Amazon 2026 NPA项下的金额将在根据我们与Amazon之间若干商业协议达成相关算力产能里程碑后，以每批50亿美元的方式可供我们使用，且</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.59pt;position:absolute;text-decoration:none;white-space:pre>166</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">在我们首次公开发行之前发行的票据可应我们的提款申请以每批10亿美元的方式发行。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:103.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">如果票据转换时无法在不超过Amazon持股上限的情况下发行我们的N类普通股股份，则该票据中无法转换的本金额将作为不计息展期票据重新发行，该展期票据自发行起10年到期，可在每个财政季度末转换为我们的N类普通股股份，任何未转换余额须于到期时以现金支付，或经Amazon选择，以抵销Amazon根据我们的商业协议应付我们的若干款项的方式支付。有关我们向Amazon发行的未偿票据的更多信息，参见“—可转换票据—未偿票据”一节。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:192.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">在若干清算交易中，Amazon可选择收取现金以代替转换。发生特定违约事件时，我们可能须分五期等额偿还票据的未偿本金额及应计利息。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:235.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Broadcom</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:256.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">下表概述了基础设施合作伙伴2026 NPA的主要条款，根据该协议，我们可在需要时发行可转换本票，所得款项仅用于为2026年租赁安排项下的季度租金义务提供资金。参见“—合同义务—基础设施设备租赁”一节。</div></div><div style=position:absolute;text-align:justify