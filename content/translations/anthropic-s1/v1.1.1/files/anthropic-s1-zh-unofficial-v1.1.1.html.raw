sition:absolute;left:74pt;top:180.5pt;width:39.75pt;height:7.75pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:5.25pt;font-weight:400;color:#131311;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>代码执行</span></div><div style=position:absolute;left:119pt;top:180.5pt;width:30.75pt;height:7.75pt;background:#f0ede6></div><div class=zhimg style="position:absolute;left:119pt;top:180.5pt;width:30.75pt;height:7.75pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:5.25pt;font-weight:400;color:#131311;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>网络搜索</span></div><div style=position:absolute;left:231pt;top:180.5pt;width:30.75pt;height:7.75pt;background:#f0ede6></div><div class=zhimg style="position:absolute;left:231pt;top:180.5pt;width:30.75pt;height:7.75pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:5.25pt;font-weight:400;color:#131311;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>智能体技能</span></div><div style=position:absolute;left:319pt;top:180.5pt;width:27.75pt;height:7.75pt;background:#f0ede6></div><div class=zhimg style="position:absolute;left:319pt;top:180.5pt;width:27.75pt;height:7.75pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:5.25pt;font-weight:400;color:#131311;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>快速模式</span></div><div style=position:absolute;left:72.25pt;top:237.5pt;width:50.5pt;height:9.25pt;background:#faf9f5></div><div class=zhimg style="position:absolute;left:73pt;top:238.25pt;width:49pt;height:7.75pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:5.5pt;font-weight:400;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>前沿智能</span></div><div style=position:absolute;left:171pt;top:238.25pt;width:52.75pt;height:9.75pt;background:#faf9f5></div><div class=zhimg style="position:absolute;left:171.75pt;top:239pt;width:51.25pt;height:8.25pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:5.5pt;font-weight:400;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>强大智能</span></div><div style=position:absolute;left:270.75pt;top:237.5pt;width:71.5pt;height:9.25pt;background:#faf9f5></div><div class=zhimg style="position:absolute;left:271.5pt;top:238.25pt;width:70pt;height:7.75pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:5.5pt;font-weight:400;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>通用智能</span></div><div style=position:absolute;left:370.25pt;top:237.5pt;width:65.75pt;height:9.25pt;background:#faf9f5></div><div class=zhimg style="position:absolute;left:371pt;top:238.25pt;width:64.25pt;height:7.75pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:5.5pt;font-weight:400;color:#131311;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>高性价比智能</span></div></div></div></div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:361pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude模型家族</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:382pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.23pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude模型家族目前由四个模型系列组成：Mythos（包括Fable）、Opus、Sonnet和Haiku。我们的模型系列可单独用于某些任务，也可相互组合使用。它们为每个用例选择理想的性能、成本和速度提供了广泛的灵活性。所有模型均支持文本、代码和多模态输入。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:436.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Mythos（包括Fable）</span>。我们能力最强的模型系列，在所有领域均提供前沿性能，能够解决AI此前未能可靠处理的问题，尤其是在编程和长时间运行的智能体任务方面。鉴于其在软件漏洞发现和生物学等敏感领域的先进能力，我们以两种不同的配置部署这一底层模型。Fable已全面开放，并在我们的生产安全保障措施下运行，这些措施会阻止或限制其在某些敏感主题上的表现，包括将请求路由至能力较弱的Claude模型。Mythos在为从事网络安全和生命科学工作的经审查组织和个人校准的安全保障措施下运行，并通过我们的受信访问计划（包括我们的Cyber Verification Program（网络安全验证计划））提供。我们于2026年4月首次通过Project Glasswing以Claude Mythos Preview的形式提供该模型系列，于2026年6月全面开放Fable 5并向Project Glasswing参与者提供Mythos 5，并于2026年9月发布了Mythos 5.1和Fable 5.1。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:571pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Opus。</span>我们面向推理密集型任务的强大主力模型系列。我们最新发布的Opus版本Claude Opus 5.5旨在成为企业日常主力模型，为端到端运行项目的智能体提供支持，并提升智能体编程、计算机使用（computer use）和知识工作等方面的能力。Opus模型在关键行业基准测试中始终位居领先模型之列。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:625.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Sonnet。</span>我们面向日常任务的多功能模型系列，在性能、成本和速度之间取得平衡，适用于最广泛的通用用例，包括多智能体编排设置中的高用量子智能体。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:668.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Haiku。</span>我们成本最低、速度最快的模型系列。Haiku模型专为客户服务智能体和大规模文档处理等高用量工作负载而设计。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:297.52pt;position:absolute;text-decoration:none;white-space:pre>200</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude Platform</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:93pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.23pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">客户选择Claude不仅仅是因为模型。Claude Platform使开发者和企业能够在具备高可靠性、高安全性和高可用性的基础设施上构建、管理和部署智能体AI应用。</div></div><div style=line-height:7.56pt;position:absolute;top:124.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">平台功能</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:145.8pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:72pt;width:468pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">平台功能使开发者能够定制其对Claude的使用，包括：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:166.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">扩展思考</span>。Claude能够在生成最终回复之前进行额外的内部推理，逐步处理复杂的多步骤问题，以提升分析、数学和编程等任务的回复质量。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:209.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">自适应思考</span>。Claude会自动判断某一请求是否需要扩展推理以及应投入多少推理——这样，开发者无需逐个请求配置推理水平即可获得扩展推理的益处。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:252.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.21pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">投入程度控制</span>。开发者可以为每个请求指定投入程度，以引导Claude投入多少推理，从而在回复质量与成本和延迟之间取得平衡。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:284.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">工具使用。</span>Claude能够在整个对话过程中原生调用外部函数和API，并支持并行执行以及在工具调用之间进行交错思考。搜索工具仅按需加载特定任务所需的工具，与预先加载完整工具库相比，可以降低token开销。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:339pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.23pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">长上下文</span>。Claude支持大型上下文窗口，并在输入增长时仍保持强劲性能，这意味着开发者可以在单个请求中纳入整个代码库、大型文档集或较长的智能体历史记录。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:382.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">结构化输出。</span>开发者可以将Claude的回复约束为指定的模式，例如有效的JSON（JavaScript对象表示法），使结果能够与下游系统和应用代码可靠集成，减少额外的解析或验证。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:425.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">代码执行</span>。一种沙箱化执行环境，Claude可在其中于智能体循环内编写、运行和迭代代码，这是数据分析和自动化工作流的基础。该环境使Claude能够更高效地调用工具和处理大量数据，并运行打包在智能体技能（Agent Skills）中的脚本。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:480pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">网络搜索</span>。一种原生工具，使Claude能够访问实时网络信息，从而在生产应用中提供有依据、可标注引用的回复。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:511.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Files API。</span>使开发者能够一次性上传文档并在多个会话中引用，从而简化依赖持久化文档的工作流。</div></div><div style=line-height:7.56pt;position:absolute;top:543.6pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">上下文管理</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:564.6pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:72pt;width:468pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">开发者可以使用上下文构件，为其智能体和应用将上下文连接至Claude。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:585pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">模型上下文协议（MCP）。</span>MCP是我们于2024年11月推出、并于2025年12月捐赠给Linux基金会旗下Agentic AI Foundation的开放标准。MCP定义了一个通用接口，Claude以及其他AI工具可以通过该接口连接到企业数据源、工具和工作流。Claude Platform的原生MCP连接器可自动处理连接管理、工具发现和错误处理。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:651pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.22pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">智能体技能（Agent Skills）。</span>一种模块化框架，使组织能够将可重复的任务、工作流和领域专业知识编码为可复用的包（即技能），供Claude按需加载。我们为Word、Excel、PowerPoint和PDF等常用格式提供预置技能，而自定义技能则可以涵盖从工程标准和监管流程到专有工具链的任何内容。这些技能将机构知识转化为智能体能力。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.39pt;position:absolute;text-decoration:none;white-space:pre>201</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Model Hardware Standard</span>。我们的Model Hardware Standard目前处于研究预览阶段，使AI智能体能够查找、理解并安全操作显微镜、液体处理仪以及现成机械臂等实验室和制造设备。我们的Model Hardware Standard与模型无关，可使任何智能体运行框架通过MCP等标准协议访问具备可编程接口的设备。</div></div><div style=line-height:7.56pt;position:absolute;top:138pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">基础设施</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:159pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude Platform为企业级智能体工作负载提供高可靠性和高可用性。在Claude上进行构建的客户需要模型在其运营的任何地方都能得到可靠服务，需要模型能够以规模化和高速度高效运行，并需要能够让模型自主工作的工具。我们运营这些基础设施，使客户无需自行构建和维护。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:213.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.21pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">可用性</span>。Claude Platform可直接从Anthropic获取，也可通过AWS、GCP和Azure等主要云服务提供商获取。功能可用性因部署方式而异。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:245.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.19pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">成本、速度与规模</span>。开发者可以调整Claude的运行方式，以适应每个工作负载的性能和经济性要求：</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:277.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:108pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>◦</font><div class=zh style="position:absolute;top:-2.11pt;left:126pt;width:416.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">提示缓存</span>。大型、重复使用的提示词组件可缓存最长一小时，与在不使用缓存的情况下处理相同请求相比，对于长提示词可将成本降低最多约97%，并将延迟降低约60%。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:320.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:108pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>◦</font><div class=zh style="position:absolute;top:-2.35pt;left:126pt;width:414pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">批处理</span>。以更低成本实现高用量的异步处理。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:340.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:108pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>◦</font><div class=zh style="position:absolute;top:-2.11pt;left:126pt;width:416.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">快速模式</span>。为速度至关重要的延迟敏感型和交互式应用提供更低延迟的回复。</div></div><div style=line-height:7.56pt;position:absolute;top:372.6pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">运行框架（harness）</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:393.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">单靠模型本身并不能构成智能体。在生产环境中可靠地运行智能体颇具挑战，因为智能体必须能够在崩溃和中断后存续，以范围受限且可审计的凭证对系统执行操作，并能根据多变的工作负载进行扩展。自主运行需要运行框架（harness），它提供模型自主规划、调用工具、核验自身工作并安全完成任务所需的安全环境、凭证、记忆和编排循环。构建和运营该等基础设施是一项专业且持续的工作，直到最近，每个客户都必须自行承担这项工作。我们在Claude Platform上提供两种运行框架的运行方式：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:471pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Agent SDK。</span>该解决方案向所有开发者提供为Claude Code提供支持的同一套生产级运行框架，供其在自有算力上运行。它内置上下文管理、会话处理、多智能体协调和提示优化功能，使客户能够在其自有基础设施上构建和运行复杂的智能体，所需时间仅为原本所需时间的一小部分。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:525.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude Managed Agents。</span>一种开箱即用的解决方案，由我们在Anthropic管理的算力上代表客户运营运行框架。我们托管沙箱、存储凭证、维护记忆并运行智能体循环；客户则定义其智能体的任务、工具和护栏。当新模型推出时，客户无需重建其智能体循环。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:580.2pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">直营应用及集成</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:601.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的平台基础构件和模型是我们所有产品的基础，并支持广泛的用例，从编程智能体到生命科学、金融、安全等领域的专业产品。结合我们对模型当前及未来能力的深刻理解，这一基础使我们能够快速推出在众多用户类型和工作流中释放价值的产品。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:655.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude Code。</span>一款编程智能体，以终端工具、桌面应用、网页界面和移动应用形式提供，并与GitHub及主流IDE（集成开发环境）原生集成。Claude Code能够凭借持续的上下文，在大型代码库中处理多步骤软件开发任务——规划、编写、编辑、测试、调试和提交代码，并支持并行智能体会话，使单个开发者能够同时推进多项任务。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:297.78pt;position:absolute;text-decoration:none;white-space:pre>202</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude Cowork。</span>一款基于Claude Code智能体架构构建的知识工作智能体，可在桌面端、网页端和移动端使用。用户以日常语言描述任务，Claude将其分解为若干步骤，并跨本地文件、已连接的应用、Chrome及桌面本身完成这些步骤，在不存在集成的情况下通过原生应用程序进行点击和输入操作。它交付成品文档、电子表格、演示文稿和整理好的文件夹，无需使用终端或编写代码。开源插件系统让用户能够安装或构建将技能、数据连接器和工作流打包在一起的程序包。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:149.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude.ai。</span>我们的旗舰对话产品，可在桌面端、网页端和移动端使用。Claude.ai是接触Claude最广泛的入口，面向企业、团队和个人提供，可访问我们的Claude模型家族，并支持文件上传、可在多次对话间保持持久化上下文的项目、记忆、网络搜索以及用于实时渲染代码和文档的artifacts。Claude.ai在获客漏斗顶端为企业采用创造需求。2026年9月，我们开始将Claude Cowork与Claude.ai合并为一个统一的应用程序，从而借助Claude Cowork的能力，使用适当的工具自动处理任何请求。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:238.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude Security。</span>一款防御性网络安全产品，以公开测试版形式向Claude Enterprise客户提供，将前沿的漏洞检测和修补能力交到安全团队手中。Claude Security像安全研究人员一样对代码进行推理，追踪数据流并检查代码库中各组件如何交互，从而发现基于模式的扫描工具可能遗漏的复杂且依赖上下文的漏洞。每项发现均附有置信度评级、严重性评估和复现步骤。用户可直接转入Claude Code审阅并应用拟议的补丁，从而缩短从扫描到修复的时间。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:327pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude Tag</span>。一款协作型智能体，在Slack等生产力工具中与团队协同工作，用户可在任何频道或讨论串中标记Claude，并以日常语言委派工作。借助周边对话、企业软件工具、共享文档以及频道范围内记忆所提供的上下文，Claude直接在讨论串内返回答案、草稿、分析和拉取请求（pull request），作为一名知道何时主动加入对话的常驻队友开展工作。Claude Tag将Claude引入团队已在其中开展协调的多人工作流，将采用范围从个人扩展至整个组织。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:415.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude Design。</span>使用户能够通过自然语言对话和直接编辑，创建精美的设计、原型、演示文稿及其他视觉作品。Claude Design将我们的平台延伸至视觉和创意工作领域，拓宽了设计师、营销人员、创始人和市场推广专业人士可借助Claude完成的专业任务范围。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:470.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude Science</span>。一款面向科学研究的AI工作台，将文献分析、数据处理和稿件准备整合到单一桌面环境中。研究人员以日常语言描述一项分析，Claude Science即可查询60多个科学数据库，端到端地完成该分析。Claude Science在实验室的自有机器、机构计算集群或按需云资源上执行计算密集型工作负载，而无需研究人员管理底层基础设施。它交付可直接用于发表的图表和稿件，并附有原生渲染的科学输出、完全可复现的代码、由智能体驱动的核验以及可追溯的结果。Claude Science将Claude延伸至科学研究领域，将前沿能力直接交到致力于攻克世界上一些最艰巨难题的研究人员手中。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:582pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">客户可通过我们的Claude Enterprise产品使用上述每一款产品。Claude Enterprise提供安全与合规控制，包括基于SAML（安全断言标记语言）的单点登录及SCIM（跨域身份管理系统）用户预配、基于角色的访问控制、审计日志、Compliance API（合规API），以及旨在支持医疗健康和受监管数据工作负载遵守《1996年健康保险流通与责任法案》（“HIPAA”）的配置，此外还提供用于IT监督、成本可见性和控制的集中式管理控制台。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:659.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">受监管行业及其他行业的客户使用我们能力最强的模型处理敏感工作。这些客户必须保持其数据的私密性，而我们必须能够检测滥用行为。2026年9月，我们宣布推出Enterprise Frontier Safeguards（企业前沿安全保障措施），旨在同时满足这两项需求。我们用于自动化安全监控的活动数据存储在客户自己的云账户中，受客户的加密密钥和访问控制保护。我们的自动化系统会审查近期活动是否存在严重滥用的迹象，并将</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:297.81pt;position:absolute;text-decoration:none;white-space:pre>203</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">此类滥用的警报直接发送给客户的安全团队。整个过程无需Anthropic员工进行审查。我们与金融服务、医疗健康和公共部门等行业的100多家客户共同开发了Enterprise Frontier Safeguards。我们正在分阶段推出该功能，在推出完成之前，符合条件的客户可就Fable 5和Fable 5.1享受零数据留存，即除为遵守适用法律或打击滥用或危害所需的情况外，我们在处理请求后不会存储其输入或输出。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:149.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">垂直行业解决方案</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:170.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">除横向平台和应用外，我们还在因领域专业性和监管要求而使通用工具无法满足需求的行业中构建垂直行业解决方案。我们的垂直行业解决方案专为特定用途打造，内嵌领域知识、旨在支持行业特定合规要求的控制措施，以及可缩短价值实现时间的预配置数据集成。我们的垂直行业解决方案通过多种渠道交付，包括我们的Claude Enterprise和Team方案、在我们的个人订阅方案中提供的领域专用连接器和插件、Claude Platform，以及（就Claude for Education而言）全机构范围的协议。迄今为止，我们已推出七项垂直行业解决方案：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:259.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude for Financial Services。</span>为金融专业人士提供预构建、可定制的AI智能体，用于常见的金融工作流，例如起草推介材料（pitch book）、审阅盈利情况、开展了解你的客户（KYC）筛查以及进行财务分析。Claude for Financial Services直接接入这些机构已在使用的数据源（例如市场数据、数据仓库），并在金融专业人士使用的工具内运行，例如Excel、PowerPoint、Word、Outlook以及Claude自身的应用。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:336.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude for Financial Advisors</span>。为财务顾问和财富管理机构提供预构建、可定制的工作流，用于常见的顾问任务，例如筹备客户会议、起草跟进函件、审阅投资组合再平衡以及准备遗产和税务简报。Claude for Financial Advisors直接接入顾问已在使用的系统（例如托管平台、投资组合管理和财务规划工具以及客户关系管理软件），并在每个工作流中内置顾问审阅环节，以帮助相关机构满足其合规要求。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:414pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude for Healthcare。</span>为医疗服务提供方、支付方和健康科技公司提供前沿模型，具备涵盖临床推理、医疗编码和长周期智能体运营的领域智能，以及旨在支持医疗和运营工作流遵守HIPAA的工具。Claude for Healthcare还连接至多个行业系统，包括美国联邦医疗保险和医疗补助服务中心（Centers for Medicare & Medicaid Services）覆盖范围数据库、ICD-10以及国家医疗服务提供方标识（NPI）登记库，并配有用于快速医疗互操作性资源（FHIR）开发和事先授权审核的智能体技能。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:491.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude for Life Sciences。</span>为计算生物学家、生物信息学家、临床试验经理和注册事务专员提供内置于前沿模型中的领域智能，涵盖有机化学、结构生物学、实验方案和生物信息学流程。Claude for Life Sciences支持整个研发链条上的工作，从早期发现和临床前研究，直至临床试验运营和注册申报。Claude直接接入研究人员已在使用的工具和数据库，例如电子实验记录本、数据存储库和科学文献。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:568.8pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude for Legal。</span>为法律专业人士、企业内部法律顾问、律师事务所律师和法务运营团队提供预构建的AI智能体，用于常见的法律工作流。Claude for Legal直接接入法律专业人士已在依赖的系统和工具。通过MCP连接器，Claude for Legal可连接至Relativity等电子证据开示和法律数据智能平台、Ironclad等AI合同平台、法律研究数据库、交易数据室以及案件管理系统。每个智能体和工作流均可按照团队自身的先例、流程、上报链条、风险校准和内部风格进行配置，并配有旨在支持律师－客户特权、信息隔离墙和保密义务的控制措施。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:669pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude for Education。</span>为高等教育机构和K-12教育工作者提供值得信赖的AI解决方案。Claude for Higher Education为教职员工、学生、研究人员和行政管理人员提供用于教学、学习、研究和运营的AI伙伴。其中包括面向学生的学习模式，旨在强化批判性思维。Claude还在研究、拟定作业和支持行政工作等各项任务中为大学教职员工提供帮助，</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:297.75pt;position:absolute;text-decoration:none;white-space:pre>204</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">所有这些均具备为满足机构要求而构建的安全与合规能力。Claude for Teachers向美国经过验证的K-12教育工作者免费提供高级Claude功能、教学技能库，以及与循证课程的直接连接，该等课程与全部50个州的学术标准相对应。Claude协助处理文书工作，让教师能够花更多时间陪伴学生。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:138pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Claude for Government</span>。在获FedRAMP High授权的环境中，向美国政府机构提供Claude模型，用于起草、研究、分析和编程，旨在支持政府客户的数据处理和可审计性要求。美国境外的政府客户以及在涉密环境中拥有工作负载的客户可通过Amazon Bedrock使用Claude模型，但须受该平台的授权和可用性所限。</div></div><div style=line-height:9.07pt;position:absolute;top:204pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的基础设施</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:227.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的基础设施支撑着我们训练前沿模型、规模化地提供推理服务、管理Claude的内部使用，以及以企业部署所需的性能和可靠性向客户交付Claude的能力。我们已构建起一个差异化的基础设施层，使我们能够在多个硬件平台上更高效地训练和部署前沿模型。这一基础设施优势会随时间推移不断累积：随着我们对每个芯片家族进行优化，我们系统的每一层都会相应受益。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:293.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">多芯片算力策略</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:314.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们已在多个芯片平台上制定审慎且多元化的算力采购战略，该战略带来以下独特优势：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:346.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.35pt;left:108pt;width:432pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们能够从多家供应商获取算力，而不受制于任何单一供应商。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:366.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们能够根据每项工作负载的最佳性价比和效率特性选择芯片，从而受益于各平台的差异化优势。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:398.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.19pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们与每家供应商均保持协作关系，并对未来几代芯片的路线图和功能施加影响。我们的芯片平台包括：</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:430.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:108pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>◦</font><div class=zh style="position:absolute;top:-2.11pt;left:126pt;width:416.2pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">AWS Trainium。</span>我们与Amazon的战略合作使我们能够获得AI加速器（包括定制设计的Trainium芯片）和算力基础设施，并有机会对未来几代Trainium芯片施加影响。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:473.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:108pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>◦</font><div class=zh style="position:absolute;top:-2.11pt;left:126pt;width:416.19pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">Google TPU。</span>我们与Google和Broadcom的合作伙伴关系使我们能够获得涵盖多代TPU平台、由Google TPU提供支持的算力容量。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:505.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:108pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>◦</font><div class=zh style="position:absolute;top:-2.11pt;left:126pt;width:416.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">NVIDIA GPU。</span>我们与NVIDIA Corporation（“NVIDIA”）的战略合作伙伴关系，连同我们与Microsoft、SpaceXAI、Nscale、Lambda及其他云服务提供商的安排，使我们能够获得由NVIDIA GPU（包括NVIDIA Grace Blackwell及Vera Rubin GPU系统）提供支持的算力容量，并有机会在设计和工程方面与NVIDIA直接合作，针对我们的工作负载特征优化未来的NVIDIA硬件。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:571.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:108pt;position:absolute;text-decoration:none;white-space:pre;width:3.36pt>◦</font><div class=zh style="position:absolute;top:-2.11pt;left:126pt;width:416.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">AMD GPU。</span>我们与AMD的关系，连同我们与基于AMD的Helios机架级系统的认可制造商及第三方服务提供商的安排，使我们能够获得由AMD Instinct™ GPU（包括AMD Instinct™ MI450系列GPU）提供支持的算力容量，并有机会通过一项多年期工程合作与AMD直接开展合作。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:637.2pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们引入新芯片平台所需的时间仅为过去的一小部分。过去，将新芯片平台投入生产需要历时数月的高强度工程投入。借助Claude，我们的工程团队现在能够更快地将新芯片平台投入生产。这种速度和效率还依赖于我们已在多个芯片家族上构建的稳固基础，包括一个专有编排层，该编排层旨在针对我们的实际工作负载无缝测试和衡量性能。因此，我们能够在新的AI加速器</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:297.93pt;position:absolute;text-decoration:none;white-space:pre>205</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.2pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">上市时即予采用，从而在扩大算力容量获取的同时，降低对任何单一硬件供应商的依赖。</div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:103.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">有关该等安排条款的更多信息，参见“管理层对财务状况及经营业绩的讨论与分析——流动性及资本资源——合同义务——基础设施服务安排”一节。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:147pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的数据中心战略</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:168pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">过去，我们以固定期限协议采购算力。随着我们的算力需求不断扩大，我们已转向一种混合模式：除以云服务形式采购算力外，我们还直接采购专用AI加速器，并在按照我们的规格、代表我们租赁和运营的专用数据中心设施中运行这些硬件。我们将这一额外的算力来源称为Anthropic Direct。这一转变在一定程度上是由我们的算力需求规模以及直接租赁和托管基础设施的潜在长期经济优势所推动的。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">我们的首个数据中心设施已于今年投入运营。</span></div></div><div style=font-size:12pt;line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:256.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.18pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Anthropic Direct还使我们能够将对数据中心容量的承诺与对其中部署的AI加速器的承诺区分开来。由于数据中心需要较长的筹备周期，但在算力总成本中所占比例较小，这一方式使我们能够提前锁定数据中心容量，同时将规模更大的加速器投资推迟至我们的具体算力需求更加明确之时。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:311.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的数据中心基础设施战略包括若干合同安排，这些安排共同构成一项新的算力来源，以补充我们从CSP采购的容量。该等安排包括：</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:354.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">算力基础设施设备。</span>我们通过设备租赁主协议（包括2026年租赁安排）采购专用AI加速器及相关组件（包括CPU和高带宽内存），根据该等协议，我们接收此类硬件，以部署于由他人代表我们运营的专用数据中心设施中。有关该等租赁条款的更多信息，参见“管理层对财务状况及经营业绩的讨论与分析——流动性及资本资源——合同义务——基础设施设备租赁”一节。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:443.4pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">数据中心。</span>在我们的部分数据中心基础设施安排中，由第三方合作伙伴采购底层不动产、电力和数据中心设施，而我们租赁该等设施中的容量，并与专业第三方运营商签约进行持续的设施管理。例如，我们已与Fluidstack USA I Inc.（“Fluidstack”）订立一项托管及服务协议，根据该协议，Fluidstack向我们提供数据中心开发和运营服务。我们也已直接签署数据中心租约，并预计未来将越来越多地这样做。为获得若干数据中心开发项目（这些项目需要在部署前作出重大资本承诺），我们在某些情况下已经依赖并预计将继续依赖与融资来源或合作伙伴的安排，由其为租赁义务提供担保，以支持预计将承载该合作伙伴的芯片或计算基础设施的数据中心容量的开发。我们未来通过该等安排扩大算力及基础设施容量的能力，可能取决于数量有限的CSP、合作伙伴和融资来源是否持续愿意并有能力订立及履行该等安排。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:600.6pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:90pt;position:absolute;text-decoration:none;white-space:pre;width:3.72pt>•</font><div class=zh style="position:absolute;top:-2.11pt;left:108pt;width:434.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400;text-decoration:none">电力。</span>电力采购需要与公用事业供应商另行作出安排，或在某些情况下开发表后发电产能，直接向设施供电，而不经由更广泛的电网。无论是通过并网安排还是表后安排，为数据中心项目确保充足的电力容量通常都需要较长的筹备周期，并需要在设施投入运营之前很早就作出重大财务承诺。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:678pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.2pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的数据中心基础设施项目目前主要位于美国。随着我们继续扩大全球客户群和研究业务<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">，我们正在国际范围内寻求更多的数据中心容量，以支持我们全部类型的工作负载。</span></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:297.75pt;position:absolute;text-decoration:none;white-space:pre>206</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.56pt;position:absolute;top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">多云分发</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:93pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude可通过三大云平台各自的专用AI服务层（Amazon Bedrock、Gemini Enterprise Agent Platform和Microsoft Foundry）获取，确保各组织能够在其已在使用和信任的基础设施内部署我们的模型，同时为企业提供部署灵活性并避免供应商锁定。</div></div><div style=line-height:9.07pt;position:absolute;top:147.6pt;width:612pt><div class=zh style="position:absolute;top:-2.96pt;left:72pt;width:468pt;line-height:15pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:12pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的客户</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:171pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.2pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">世界各地的组织都依赖Claude。我们服务的客户范围广泛，从规模最大的企业到AI原生公司、政府和研究机构，以及专业消费者。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:202.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">截至2026年9月30日，我们按过去十二个月计算贡献收入10万美元或以上的客户涵盖《财富》10强中的每一家公司、《财富》500强中逾50%的公司以及全球2000强中逾30%的公司。在各个行业中，企业均在关键任务生产工作流中部署Claude，例如承保保险单、为救命药物撰写临床报告、检测和修复网络安全威胁，以及为资产管理人分析投资组合。Claude已在高度受监管的行业中实现尤为深入的采用，在这些行业中，不可靠的AI所带来的代价令人难以承受，而信任无法事后补建。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:280.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">此外，领先的AI原生公司基于Claude构建新一代编程工具、设计平台和生产力应用。政府和研究机构也将Claude应用于从材料科学到能源安全等各类工作；以使命为驱动的组织使用Claude缩短科学研究、临床工作流以及公共福利发放的预期时间线。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:334.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的客户群在客户关系的数量和规模方面均实现快速增长，各组织从最初的用例扩展至全企业范围的生产部署。截至2026年9月30日，我们拥有超过11,900家按过去十二个月计算贡献收入10万美元或以上的客户，<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">而截至2025年9月30日为超过950家。</span></div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:389.4pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:72pt;width:468pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的客户主要分为两类：企业和专业消费者。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:409.8pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">企业</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:430.8pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">我们的企业客户包括大量规模化部署AI的组织，既有构建产品的AI原生初创公司，也有在任何一项工作流影响生产之前即要求具备企业级安全、治理和合规能力的全球最大型组织。我们通过单一的可组合平台服务这一完整的客户谱系，提供对我们前沿模型的顺畅访问，以及客户所需的控制措施，例如单点登录、审计日志、数据留存政策、基于角色的访问控制，以及在其现有云基础设施内的原生部署。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:508.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.28pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">软件开发者仍是企业内部推动采用的关键力量：他们既是客户，也是基于我们平台所构建应用的架构师，还是推动全组织范围采用的内部倡导者。软件开发者使用Claude Code和Claude Platform更快地编写、调试和交付生产级质量的代码——设计系统架构、实现功能、构建智能体工作流，并在数小时内解决以往需要数天才能解决的复杂问题。这些生产部署揭示了只有在真实企业负载下才会显现的治理、可靠性和集成要求，由此产生的反馈回流至我们的路线图，并随每一次发布深化我们的客户关系。</div></div><div style=line-height:7.56pt;position:absolute;top:597pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">专业消费者</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:618pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">知识工作者，包括研究人员、开发者、分析师和写作者，订阅Claude Pro和Claude Max以开展复杂的认知工作，包括起草分析报告、综合研究成果、编写和审阅代码、构建财务模型以及实现工作流自动化。借助Claude Cowork，非技术背景的专业消费者无需编写代码即可跨其应用构建智能体工作流，在数分钟内完成以往需要数小时人工处理的工作。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:684pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">专业消费者是我们最早的采用者之一，并且通常是我们最具鉴别力的用户之一。他们会在模型发布后数小时内测试其能力，将最新版本的Claude应用于我们可能未曾预料的用例，并发现边缘情况和故障，从而使Claude模型的每一个后续版本更加完善。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><font style=font-family:georgia,serif;font-size:9.5pt;font-style:normal;font-weight:400;left:298.05pt;position:absolute;text-decoration:none;white-space:pre>207</font></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:inherit;text-decoration:inherit>目录</a></span></div></div></div></div><div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:72pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.24pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude Code的采用始于个人软件开发者，他们在企业采购团队考虑这一类别之前便已注意到自主编程智能体的潜力；Claude Code如今正成为许多企业工程组织内部的默认选择。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:115.2pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">专业消费者是一台强大的获客漏斗顶端引擎——我们一直观察到，亲身体验到Claude价值的个人会成为其所在组织内部的倡导者，播下采用的种子，并使采用从个人使用加速扩展至团队范围，最终扩展至全组织范围的部署。</div></div><div style=font-size:12pt;line-height:7.56pt;position:absolute;top:158.4pt;width:612pt><div class=zh style="position:absolute;top:-2.47pt;left:72pt;width:468pt;line-height:12.5pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:10pt;font-style:italic;font-weight:700;text-decoration:none;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">Claude如何为客户创造价值</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:179.4pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.19pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">客户主要通过三种方式从Claude中实现价值：员工更高效、流程更快捷，以及<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">在其产品中嵌入智能</span>。这些成果是同一种智能的不同表现形式，均依托于相同的模型和基础构件。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:222.6pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.26pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">员工更高效。</span>采用最常从这里开始。个人亲身体验到前沿AI模型对其自身产出可能产生的影响——例如，在数分钟内完成需要数小时的财务分析或代码审查——这种信念从第一位用户扩散至其团队，再从一个团队扩散至整个公司。这一过程在软件开发领域通过Claude Code发生；Claude Cowork则为更广泛的知识工作者实现这一点。我们的Claude Enterprise方案提供治理、安全和管理功能，以支持在组织规模上采用Claude。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:300pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">流程更快捷。</span>随着采用不断深化，Claude不再只是员工咨询的对象，而开始成为组织赖以运行的基础。随着各组织将更多工作流（包括其数据、系统、惯例和既往工作）编码到Claude中，该平台对其价值愈发提升。Claude可以利用这些累积的上下文，建议下一个值得自动化的工作流，从而减少每一次后续部署所需的投入。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:366pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.27pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:italic;font-weight:400">嵌入式智能。</span>在最深层次上，Claude从一项运营优势转变为一项商业优势。产品团队基于Claude Platform进行构建，将前沿AI嵌入其自身产品，包括面向客户的智能体、AI原生功能，以及在不具备AI能力的情况下此前不可行的全新产品线。Claude既是组织使用的工具，也是组织向其自身客户交付价值的组成要素。</div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:432pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.29pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">在所有这三个维度上，相当大比例的扩展只需极少甚至完全无需新的部署。Claude模型的每一个新版本都旨在提升现有用例的表现：员工产出更高质量的工作，经编码的流程以更高的准确性和可靠性运行，嵌入式产品为终端用户带来更多价值。<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">因此，客户无需经历新的销售周期或采购决策，即可增加使用量、使用更高的订阅档位，并将更多工作流引入平台。</span></div></div><div style=line-height:7.18pt;position:absolute;text-align:justify;text-align-last:var(--justify);top:498pt;width:612pt><div class=zh style="position:absolute;top:-2.11pt;left:72pt;width:470.25pt;line-height:11.4pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-indent:0;text-align:justify;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict">尽管采用速度很快，但我们相信，我们对前沿AI机遇的渗透仍处于最早期阶段。相对于Claude目前能够处理的工作范围以及我们相信Claude未来能够处理的工作范围而言，目前使用Claude的大多数企业部署Claude的团队和用例数量较少。我们相信，全球大多数知识工作者尚未使用过前沿AI。随着Claude模型的每一个新版本在能力上不断进步，可在平台上实现的任务和工作流范围也在持续扩大。由于我们既运营平台又提供应用，模型的进步会通过<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">多个</span>渠道<span style="font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none">同时</span>惠及我们的客户。</div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3645 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=a2026-10x25xcasestudyxaccea.jpg width=816 height=1056><div style=position:absolute;left:473.04pt;top:47.52pt;width:89.28pt;height:15.12pt;background:#171717></div><div class=zhimg style="position:absolute;left:473.76pt;top:48.24pt;width:87.84pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2025年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:97.2pt;width:338.04pt;height:71.28pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:99.36pt;width:333.72pt;height:66.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.14;font-style:normal"><span>加速开启
专业服务的未来</span></div><div style=position:absolute;left:42.48pt;top:195.12pt;width:39.24pt;height:14.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:196.2pt;width:37.08pt;height:11.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:154.44pt;top:216pt;width:144.36pt;height:27.36pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:217.44pt;width:141.48pt;height:24.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>接受Anthropic培训的
Accenture专业人员</span></div><div style=position:absolute;left:154.44pt;top:258.48pt;width:144.36pt;height:38.88pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:259.92pt;width:141.48pt;height:36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>借助由Claude驱动的Accenture
Cyber.AI，安全扫描测试
覆盖率得到提升</span></div><div style=position:absolute;left:42.12pt;top:312.48pt;width:45.72pt;height:22.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:313.92pt;width:42.84pt;height:19.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.84pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>7倍</span></div><div style=position:absolute;left:154.44pt;top:312.48pt;width:144.36pt;height:49.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:313.92pt;width:141.48pt;height:46.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>一家宽带服务商（Accenture与
Anthropic的共同客户）报告的
AI投资回报</span></div><div style=position:absolute;left:335.16pt;top:233.28pt;width:242.28pt;height:110.88pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:336.6pt;top:234.72pt;width:239.4pt;height:108pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:13.68pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>“我们与Anthropic的合作伙伴关系实现了令人振奋的扩展，这将帮助我们的客户加速转变：从试验AI，转向将AI作为推动整个企业重塑的催化剂。”</span></div><div style=position:absolute;left:342.72pt;top:353.52pt;width:198.36pt;height:13.32pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:343.8pt;top:354.6pt;width:196.2pt;height:11.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>Julie Sweet，Accenture董事长兼首席执行官</span></div><div style=position:absolute;left:42.12pt;top:376.56pt;width:59.76pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:377.64pt;width:57.6pt;height:13.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:41.76pt;top:389.52pt;width:257.76pt;height:105.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:390.96pt;width:254.88pt;height:102.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Accenture通过帮助全球领先企业构建数字核心、释放AI的力量，为各行业的组织快速创造价值，助力其实现重塑。该公司汇聚逾800,000名员工的才智，依托专有资产与平台、深厚的流程及行业专业知识以及领先的生态系统合作关系，规模化交付端到端解决方案和可衡量的成果。</span></div><div style=position:absolute;left:41.4pt;top:503.64pt;width:38.88pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:504.72pt;width:36.72pt;height:13.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:41.4pt;top:516.6pt;width:258.12pt;height:119.16pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:518.04pt;width:255.24pt;height:116.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>2025年12月，Accenture与Anthropic宣布大幅扩展双方的合作伙伴关系，成立Accenture Anthropic Business Group，帮助企业实现全面规模化的AI部署。Accenture首先从自身的AI部署入手，向数万名开发人员推广Claude Code，并在全公司范围内扩大Claude Enterprise用户群。Accenture拥有逾18,000名经认证的Claude从业人员，覆盖Anthropic的基础、技术及专业三类认证路径。</span></div><div style=position:absolute;left:41.4pt;top:644.4pt;width:258.12pt;height:118.8pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:645.84pt;width:255.24pt;height:115.92pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>在推进Accenture内部转型的同时，Accenture Anthropic Business Group将同样的方法带给客户，并配备前置部署工程师，将Claude直接嵌入客户环境。Accenture已设立Claude卓越中心和创新中心，供全球2000强客户进行原型开发和用例验证。两家公司还在联合开发一项产品，帮助首席信息官（CIO）将AI引入其工程团队。</span></div><div style=position:absolute;left:311.76pt;top:408.96pt;width:258.48pt;height:120.24pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.2pt;top:410.4pt;width:255.6pt;height:117.36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Accenture与Anthropic还在为受监管行业——金融服务、生命科学、医疗健康和公共部门——打造行业产品。在网络安全领域，相关成果已通过Cyber.AI投入应用；Cyber.AI是一款以Claude为推理引擎的安全产品。Accenture正在自身全球IT基础设施中部署Cyber.AI，帮助保护1,600个应用程序和500,000多个API，将扫描周转时间从数天缩短至一小时以内，并将测试覆盖率从约10%提升至80%以上。</span></div><div style=position:absolute;left:311.76pt;top:536.4pt;width:258.48pt;height:81pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.2pt;top:537.84pt;width:255.6pt;height:78.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Accenture与Anthropic的合作伙伴关系已在为客户创造成果。美国一家大型宽带服务商基于Claude重构了其面向企业客户的营销和销售方式。首年内，该客户报告其AI投资回报达7倍，产品上市速度加快55%。销售线索验证成本下降86%，准确率则从13%提升至97%。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3433 style=position:absolute;top:0></div><div style=position:absolute;text-align:justify;text-align-last:var(--justify);width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=casestudy-aig1da.jpg width=816 height=1056><div style=position:absolute;left:473.04pt;top:47.52pt;width:89.28pt;height:15.12pt;background:#171717></div><div class=zhimg style="position:absolute;left:473.76pt;top:48.24pt;width:87.84pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2023年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:95.76pt;width:527.04pt;height:40.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:97.92pt;width:522.72pt;height:36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.14;font-style:normal"><span>重塑商业保险核保</span></div><div style=position:absolute;left:42.48pt;top:149.04pt;width:39.24pt;height:14.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:150.12pt;width:37.08pt;height:11.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:154.08pt;top:169.2pt;width:144.72pt;height:16.56pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:170.64pt;width:141.84pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>使用Claude的AIG业务线¹</span></div><div style=position:absolute;left:42.48pt;top:218.52pt;width:255.96pt;height:27.72pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:219.6pt;width:253.8pt;height:25.56pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.44;font-style:normal"><span>AIG Lexington中型市场财产险业务（该公司规模大、
增长快的业务领域）实现¹：</span></div><div style=position:absolute;left:154.44pt;top:250.92pt;width:144.36pt;height:16.92pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:252.36pt;width:141.48pt;height:14.04pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>已报价投保申请</span></div><div style=position:absolute;left:154.44pt;top:290.88pt;width:144.36pt;height:16.2pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:292.32pt;width:141.48pt;height:13.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>报价时间</span></div><div style=position:absolute;left:154.44pt;top:330.12pt;width:144.36pt;height:15.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:331.56pt;width:141.48pt;height:12.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>已承保投保申请</span></div><div style=position:absolute;left:335.16pt;top:183.96pt;width:235.08pt;height:182.88pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:336.6pt;top:185.4pt;width:232.2pt;height:180pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:11.52pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.3;font-style:normal"><span>“我们看待AI以及与Anthropic等合作伙伴开展合作的方式很简单：必须为客户和同事创造价值。我们构建的每一个工作流都应帮助同事更快、更智能、更一致地工作，同时改善客户的体验和成果。这意味着为我们服务的个人和企业带来更快的速度、更精准的核保、响应更及时的理赔服务、更短的周转时间以及更强的信心。”</span></div><div style=position:absolute;left:342.72pt;top:380.52pt;width:198.36pt;height:14.76pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:343.8pt;top:381.6pt;width:196.2pt;height:12.6pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>Eric Andersen，AIG总裁兼首席执行官</span></div><div style=position:absolute;left:42.48pt;top:367.56pt;width:60.12pt;height:15.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:368.64pt;width:57.96pt;height:12.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:41.4pt;top:380.16pt;width:258.12pt;height:133.2pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:381.6pt;width:255.24pt;height:130.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.34;font-style:normal"><span>AIG是一家全球领先的保险机构，帮助200多个国家和司法管辖区的企业和个人保护资产、管理风险。2023年，AIG认识到，其核保流程因需人工接收和审阅来自保险经纪人、客户及第三方的多种格式数据而效率受限。AIG缺乏审阅每一份适用投保申请的资源，并认为这意味着错失增长机会，因此着手将AI嵌入其核保业务的核心。</span></div><div style=position:absolute;left:41.76pt;top:520.92pt;width:60.84pt;height:15.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:522pt;width:58.68pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:41.4pt;top:534.24pt;width:258.12pt;height:120.24pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:535.68pt;width:255.24pt;height:117.36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.34;font-style:normal"><span>AIG与Anthropic合作，在一个受到高度监管的行业中构建工作流。自Claude 2.0模型起，该公司创建了Underwriting by AIG Assist，旨在处理和分析其所部署业务线收到的每一份投保申请的数据。核保人员过去需要花费数周时间收集数据才能着手撰写风险摘要；现在，他们在开始每次审阅时即可获得由Claude生成的精选风险摘要和完整审计追踪。</span></div><div style=position:absolute;left:41.4pt;top:660.24pt;width:258.12pt;height:81.36pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:661.68pt;width:255.24pt;height:78.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.34;font-style:normal"><span>在已部署的业务线中，Underwriting by AIG Assist将投保申请审阅时间缩短了90%以上，并实现了对100%适用投保申请的审阅。在AIG Lexington中型市场财产险业务（该公司在北美最大的业务之一）中，Underwriting by AIG Assist使核保人员审阅的投保申请数量增加了30%以上，</span></div><div style=position:absolute;left:311.76pt;top:433.8pt;width:257.76pt;height:27.72pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.2pt;top:435.24pt;width:254.88pt;height:24.84pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.34;font-style:normal"><span>报价速度提高了55%（截至2026年3月31日）。</span></div><div style=position:absolute;left:311.4pt;top:469.08pt;width:258.12pt;height:134.28pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.84pt;top:470.52pt;width:255.24pt;height:131.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.34;font-style:normal"><span>过去一年，AIG已将Underwriting by AIG Assist扩展至八条业务线，并正在全公司范围内持续推广。该公司还将Claude扩展至其理赔部门。在早期试点中，Claims by AIG Assist将AIG在索赔提交后回应客户所需的时间从数天缩短至数小时，并将保险责任审查时间从数小时缩短至数分钟。此外，AIG正在探索向其软件工程师提供Claude Code的使用权限，通过Claude Enterprise部署，并配备受监管保险公司所需的治理控制措施。</span></div><div style=position:absolute;left:311.4pt;top:609.84pt;width:258.12pt;height:120.24pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.84pt;top:611.28pt;width:255.24pt;height:117.36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.34;font-style:normal"><span>AIG的另一个探索方向是组建由专用智能体构成的团队，这些智能体可能提升其核保团队的工作能力，并在Anthropic的协助下构建和部署。例如，在一个正在考虑的场景中，一个智能体接收投保申请并提取数据，另一个智能体对照核保准则检查风险，第三个智能体对照业务组合目标对定价进行基准比较，再由一个协作智能体汇总各方工作——全程由核保人员监督每一项决策。</span></div><div style=position:absolute;left:41.76pt;top:754.2pt;width:69.48pt;height:13.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:755.28pt;width:67.32pt;height:11.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:6.48pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>1. 截至2026年3月31日</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3464 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=casestudiesbristol3da.jpg width=816 height=1056><div style=position:absolute;left:473.04pt;top:47.52pt;width:88.56pt;height:15.84pt;background:#141414></div><div class=zhimg style="position:absolute;left:473.76pt;top:48.24pt;width:87.12pt;height:14.4pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2023年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:95.76pt;width:522.72pt;height:41.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:41.76pt;top:97.2pt;width:519.84pt;height:38.16pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:30.24pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>加速新药发现</span></div><div style=position:absolute;left:42.48pt;top:149.04pt;width:52.2pt;height:13.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:150.12pt;width:50.04pt;height:11.52pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:142.56pt;top:170.28pt;width:146.52pt;height:26.64pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:143.64pt;top:171.36pt;width:144.36pt;height:24.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#1a1a19;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>可使用Claude的员工（全员）</span></div><div style=position:absolute;left:42.12pt;top:212.76pt;width:77.76pt;height:21.6pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:213.84pt;width:75.6pt;height:19.44pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.12pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>数十个</span></div><div style=position:absolute;left:142.56pt;top:212.04pt;width:154.44pt;height:38.16pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:143.64pt;top:213.12pt;width:152.28pt;height:36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#1a1a19;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>通过MCP集成已接入的内部数据源，另有数千个正在评估中</span></div><div style=position:absolute;left:42.12pt;top:267.12pt;width:77.76pt;height:41.4pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:268.2pt;width:75.6pt;height:39.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:14.4pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.38;font-style:normal"><span>约2个月→
约5分钟</span></div><div style=position:absolute;left:142.56pt;top:266.04pt;width:155.16pt;height:26.28pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:143.64pt;top:267.12pt;width:153pt;height:24.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#1a1a19;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>解答一个真实世界证据问题所需的时间</span></div><div style=position:absolute;left:337.68pt;top:186.84pt;width:238.68pt;height:96.48pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:340.92pt;top:190.08pt;width:232.2pt;height:90pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:11.88pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>“大多数企业AI止步于聊天机器人。真正的回报，是仍被困在数十年数据孤岛背后、尚未开发的价值……Anthropic的Claude为我们提供了连接各系统所需的智能体能力、创新速度和安全性。”</span></div><div style=position:absolute;left:340.56pt;top:289.08pt;width:233.64pt;height:28.08pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:341.64pt;top:290.16pt;width:231.48pt;height:25.92pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.38;font-style:normal"><span>Greg Meyers，Bristol Myers Squibb
执行副总裁兼首席数字与技术官</span></div><div style=position:absolute;left:42.48pt;top:322.92pt;width:66.6pt;height:14.76pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:324pt;width:64.44pt;height:12.6pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:41.76pt;top:336.6pt;width:257.4pt;height:158.4pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:337.68pt;width:255.24pt;height:156.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>Bristol Myers Squibb是全球最大的制药公司之一。数十年来，公司积累了业内最深厚的科学档案库之一，涵盖研究、临床、生产及商业数据。BMS希望将其人员、系统和机构知识连接起来，在其整个价值链（从早期药物发现到生产质量和商业运营）中，释放长期困于当今生物制药行业典型的割裂系统之中的数据和专业知识。公司于2023年开始使用Claude，选择Anthropic的模型是看中其长上下文窗口和高质量推理能力。</span></div><div style=position:absolute;left:42.12pt;top:501.84pt;width:52.56pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:502.92pt;width:50.4pt;height:13.32pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:41.76pt;top:515.16pt;width:257.4pt;height:223.2pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:516.24pt;width:255.24pt;height:221.04pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>2026年5月，BMS选定Claude Enterprise作为其全公司AI平台，看中的是其智能体能力、适用于受监管环境的安全态势以及快速的创新步伐。BMS首先向其全球开发者和数据科学家（目前已逾3,000人）推出Claude Code，使他们无需自行构建和维护编排及智能体基础设施，从而能够专注于开发新产品。在此过程中，BMS通过技能（Skills）和MCP集成将其设计模式和技术栈固化到Claude Code中，提高了输出的一致性，并加快了开发者的入职上手。公司目前正在探索如何推广这一模式，帮助科学家、生产团队和销售代表更快上手，并专注于更高价值的工作。随着Claude Code的普及，BMS扩大了部署范围，目前计划向全部30,000余名员工推出Claude Cowork。</span></div><div style=position:absolute;left:41.76pt;top:745.2pt;width:257.4pt;height:29.16pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:746.28pt;width:255.24pt;height:27pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>BMS正将Claude融入把药物从研究推向患者的工作之中。在全公司范围内，</span></div><div style=position:absolute;left:311.76pt;top:357.84pt;width:258.12pt;height:224.28pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.84pt;top:358.92pt;width:255.96pt;height:222.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>其目标是让数十年来孤立分散的数据即时可得、可付诸行动，无论数据存放在何处、归哪个职能部门所有。借助Claude，研究人员可以直接查询、处理和分析公司数据，而无需依赖内部团队搭建的仪表盘。Claude目前已覆盖BMS订阅的30至40个外部医疗记录及理赔数据库，将生成一个真实世界数据问题答案所需的时间从最长两个月缩短至五分钟或更短。科学家将实验记录本与过往研究相连接，以发掘药物发现机会，并在更广泛的数据范围内更快地开展研究。BMS的团队已在探索Anthropic新发布的Claude Science如何帮助公司在早期发现阶段加快进度。同样的探索精神也延伸到了实验室之外：运营团队开始用自然语言查询人力资源软件和IT服务管理系统，而无需依赖工程团队。</span></div><div style=position:absolute;left:311.76pt;top:590.04pt;width:258.12pt;height:184.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.84pt;top:591.12pt;width:255.96pt;height:182.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>每一代模型都在拓宽BMS交由Claude承担的工作范围。借助Claude Opus，公司的专家们正将Claude视为博士级别的顾问和思考伙伴。此外，还有若干新用例目前正在评估中。展望未来，BMS正在考虑可以如何运用Claude现有最强大的模型，以人在回路（human in the loop）的方式探索自主任务工作。例如，员工可将一项任务交给Claude——解决一个跨越多个系统的人力资源或IT请求，或将实验记录本与过往研究相连接以寻找药物发现的新途径——由Claude借助公司的MCP集成库，推理确定使用哪些内部系统以及如何组织工作。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3459 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=casestudy-doordash1c.jpg width=816 height=1056><div style=position:absolute;left:473.04pt;top:47.52pt;width:88.56pt;height:15.84pt;background:#141414></div><div class=zhimg style="position:absolute;left:473.76pt;top:48.24pt;width:87.12pt;height:14.4pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2023年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:97.2pt;width:440.64pt;height:74.16pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:99.36pt;width:436.32pt;height:69.84pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.19;font-style:normal"><span>赋能每一位员工，
从编程到知识工作</span></div><div style=position:absolute;left:64.8pt;top:234.72pt;width:504.72pt;height:98.64pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:66.24pt;top:236.16pt;width:501.84pt;height:95.76pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:16.56pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.53;font-style:normal"><span>“对我们而言，真正重要的成果不是合并了多少代码，而是让客户更快看到产品上线。借助Claude，我们的团队能用少得多的时间，把一个想法变成交付给客户的真实成果。”</span></div><div style=position:absolute;left:71.28pt;top:342.36pt;width:181.8pt;height:15.84pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:72.36pt;top:343.44pt;width:179.64pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>Andy Fang，DoorDash联合创始人</span></div><div style=position:absolute;left:42.84pt;top:400.32pt;width:51.48pt;height:13.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:401.04pt;width:50.04pt;height:12.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:312.84pt;top:400.68pt;width:47.88pt;height:13.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.56pt;top:401.4pt;width:46.44pt;height:12.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:154.44pt;top:421.56pt;width:145.44pt;height:38.88pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:422.64pt;width:143.28pt;height:36.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.3;font-style:normal"><span>Claude Code和Claude Cowork向每一位公司员工开放</span></div><div style=position:absolute;left:155.16pt;top:475.56pt;width:144.72pt;height:13.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:156.24pt;top:476.64pt;width:142.56pt;height:11.52pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.3;font-style:normal"><span>Cowork月度用户</span></div><div style=position:absolute;left:154.8pt;top:514.44pt;width:145.08pt;height:26.64pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:515.52pt;width:142.92pt;height:24.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.3;font-style:normal"><span>主要产品的上线周期缩短一半以上</span></div><div style=position:absolute;left:43.2pt;top:559.08pt;width:65.52pt;height:14.4pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.92pt;top:559.8pt;width:64.08pt;height:12.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:42.48pt;top:572.76pt;width:257.4pt;height:92.88pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:573.84pt;width:255.24pt;height:90.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>DoorDash是全球领先的本地商务平台之一，为消费者与其所在社区的商家建立连接。DoorDash自2023年起成为Anthropic的客户，在工程和知识工作领域广泛使用Claude：在工程领域，编程是其最主要的用途；在知识工作领域，目前每月有超过7,000名员工使用Claude Cowork开展工作。</span></div><div style=position:absolute;left:312.12pt;top:412.92pt;width:258.48pt;height:106.56pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.2pt;top:414pt;width:256.32pt;height:104.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>DoorDash于2025年首先向其工程团队推出Claude Code，随后使用范围迅速扩展至全公司。一名工程师用三周时间完成了一项代码迁移，而这项工作以往需要四名工程师花费一个多季度。主要产品的上线周期已缩短一半以上。如今，设计师和产品经理与工程师一同交付生产代码，所依托的内部平台运行经安全审批的Claude会话。</span></div><div style=position:absolute;left:312.12pt;top:502.92pt;width:258.48pt;height:117.36pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.2pt;top:504pt;width:256.32pt;height:115.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>随后推出的Claude Cowork建立在Claude Code广泛使用的基础之上，并于2026年通过全公司范围的推广正式落地。随着员工将Claude连接至DoorDash的内部工具，使用量持续增长：推广后的第一个月，周活跃用户数几乎翻了一番；如今每月有超过7,000名员工使用Cowork，其中近一半每天使用。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3454 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=casestudy-internationalres.jpg width=816 height=1056><div style=position:absolute;left:473.04pt;top:47.52pt;width:88.56pt;height:15.12pt;background:#141414></div><div class=zhimg style="position:absolute;left:473.76pt;top:48.24pt;width:87.12pt;height:13.68pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2025年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:97.2pt;width:487.44pt;height:71.28pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:99.36pt;width:483.12pt;height:66.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.17;font-style:normal"><span>以前沿AI赋能
一线人道主义救援</span></div><div style=position:absolute;left:43.92pt;top:195.12pt;width:39.24pt;height:14.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:196.2pt;width:37.08pt;height:11.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:43.56pt;top:216.36pt;width:78.12pt;height:22.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:217.8pt;width:75.24pt;height:19.8pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.84pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>8倍</span></div><div style=position:absolute;left:154.8pt;top:215.28pt;width:144pt;height:16.56pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:156.24pt;top:216.72pt;width:141.12pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>Claude用户数增长¹</span></div><div style=position:absolute;left:43.56pt;top:256.32pt;width:103.32pt;height:19.44pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:257.76pt;width:100.44pt;height:16.56pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.84pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>2,050万+</span></div><div style=position:absolute;left:154.8pt;top:253.8pt;width:144pt;height:27.72pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:156.24pt;top:255.24pt;width:141.12pt;height:24.84pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>2025年在40个国家
服务的人数</span></div><div style=position:absolute;left:154.8pt;top:296.64pt;width:144pt;height:15.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:156.24pt;top:298.08pt;width:141.12pt;height:12.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>每周为员工节省的工时</span></div><div style=position:absolute;left:336.96pt;top:230.76pt;width:231.48pt;height:83.88pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:342pt;top:235.8pt;width:221.4pt;height:73.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:13.68pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>“如今能够实现的一切，在有Claude之前是无法想象的。我们以前根本无法获得如此水平的实时数据和洞察。”</span></div><div style=position:absolute;left:340.92pt;top:318.24pt;width:221.76pt;height:26.64pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:342pt;top:319.32pt;width:219.6pt;height:24.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.38;font-style:normal"><span>Katherine Rodrigues，International Rescue Committee政策与规划高级总监</span></div><div style=position:absolute;left:43.92pt;top:338.4pt;width:59.76pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:339.48pt;width:57.6pt;height:13.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:43.56pt;top:351.36pt;width:258.48pt;height:93.6pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:352.8pt;width:255.6pt;height:90.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>International Rescue Committee（国际救援委员会，IRC）是全球最大的人道主义组织之一，2025年为超过2,050万名受冲突和灾害影响的民众提供了帮助。IRC在40多个国家开展工作，必须让每一个员工工时和每一美元捐款都发挥最大效用。2025年，IRC与Claude for Nonprofits合作，以折扣价获得使用许可，借助AI扩大其影响力。</span></div><div style=position:absolute;left:43.92pt;top:452.52pt;width:38.52pt;height:15.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:453.6pt;width:36.36pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:43.56pt;top:465.84pt;width:258.84pt;height:93.96pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:467.28pt;width:255.96pt;height:91.08pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>其使用规模已从300名用户的试点扩大到约2,400个Claude席位，并正朝着覆盖全部10,000名配备电脑的员工迈进。双方合作最初以提升生产力为重点：半数试点用户表示每月节省四小时或以上，项目团队重建了整套流程——过去需要一个月人工处理电子表格才能完成的项目组合综合分析，如今可即时获得。</span></div><div style=position:absolute;left:43.56pt;top:565.92pt;width:258.84pt;height:146.52pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:567.36pt;width:255.96pt;height:143.64pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>Claude还为员工提供了个案层面的实时数据，使新的一线工作成为可能。IRC员工如今能够发现以往难以察觉的新出现的健康问题——季节性感染高峰、孕产妇保健缺口等——并据此调整服务。非洲的一线卫生团队利用Claude整理分散的现场数据，使战略规划中所用关键健康指标的占比从20%提升至100%。这种新的可见性已在改变当地的医疗服务：从围绕感染病例开展的青少年外展工作，到对孕产妇就医模式的实时调查。</span></div><div style=position:absolute;left:313.2pt;top:386.64pt;width:259.56pt;height:133.2pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:314.64pt;top:388.08pt;width:256.68pt;height:130.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>IRC的营养不良项目是前沿智能投入实际应用的又一例证。现场团队拍摄纸质记录，Claude将汇总这些数据，以前所未有的清晰度呈现每名儿童的治疗状况。IRC预计，各团队将能够在个人和项目两个层面发现护理缺口并采取行动。“我们正从被动应对的体系，转向预判哪些儿童有中断营养不良治疗的风险并及早干预，”Rodrigues表示。</span></div><div style=position:absolute;left:313.2pt;top:526.68pt;width:259.56pt;height:80.64pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:314.64pt;top:528.12pt;width:256.68pt;height:77.76pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>Claude减轻了业务拓展中的行政负担，将开展一次全国范围资金格局分析所需的时间从1周缩短至几个小时。在一项针对早期试点用户的调查中，每一位受访者都表示Claude已融入其日常工作流程，每项任务可为其节省两到三个小时。</span></div><div style=position:absolute;left:313.2pt;top:614.88pt;width:259.56pt;height:28.8pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:314.64pt;top:616.32pt;width:256.68pt;height:25.92pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>从后台办公室到一线现场，Claude正在帮助IRC在全球范围内为最需要的人提供救助。</span></div><div style=position:absolute;left:43.92pt;top:754.56pt;width:146.16pt;height:12.6pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45pt;top:755.64pt;width:144pt;height:10.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:7.2pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>1. 2025年12月至2026年5月</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3870 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=casestudy-janestreet1da.jpg width=816 height=1056><div style=position:absolute;left:473.04pt;top:47.52pt;width:89.28pt;height:15.12pt;background:#141414></div><div class=zhimg style="position:absolute;left:473.76pt;top:48.24pt;width:87.84pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2023年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:95.76pt;width:413.64pt;height:76.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:97.92pt;width:409.32pt;height:72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>交易公司可以信赖的
前沿智能</span></div><div style=position:absolute;left:42.48pt;top:195.12pt;width:39.24pt;height:14.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:196.2pt;width:37.08pt;height:11.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:154.44pt;top:216pt;width:144.36pt;height:40.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:217.44pt;width:141.48pt;height:37.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>在Jane Street内部智能体编程评估中，Claude Fable 5.1相较Fable 5的表现提升</span></div><div style=position:absolute;left:43.92pt;top:271.08pt;width:67.32pt;height:20.52pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:45.36pt;top:272.52pt;width:64.44pt;height:17.64pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.84pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>约1周</span></div><div style=position:absolute;left:154.44pt;top:269.28pt;width:144.36pt;height:40.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:270.72pt;width:141.48pt;height:37.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>借助Claude Fable迁移大型代码库所需的时间，此前需要数月</span></div><div style=position:absolute;left:335.16pt;top:233.28pt;width:242.28pt;height:110.88pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:336.6pt;top:234.72pt;width:239.4pt;height:108pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:13.68pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>“我们的想法向来比我们有精力执行的要多。Claude这样的智能体极大地提升了我们的速度，让每个人能发挥的作用成倍放大。”</span></div><div style=position:absolute;left:340.92pt;top:352.44pt;width:236.16pt;height:27.36pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:342pt;top:353.52pt;width:234pt;height:25.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.45;font-style:normal"><span>Craig Falls，Jane Street Capital量化研究主管</span></div><div style=position:absolute;left:42.12pt;top:326.52pt;width:63.36pt;height:15.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:327.6pt;width:61.2pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:41.4pt;top:339.84pt;width:258.12pt;height:93.6pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:341.28pt;width:255.24pt;height:90.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Jane Street是一家全球性交易公司，其竞争优势取决于量化研究的质量和速度。该公司构建用于为各类金融工具定价和交易的模型、策略及系统。多年来，其开发人员一直难以构建能够在大型数据集上自主完成研究任务的AI智能体。早期的尝试令人沮丧，效果也不稳定。</span></div><div style=position:absolute;left:42.12pt;top:441pt;width:41.76pt;height:14.4pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:442.08pt;width:39.6pt;height:12.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:41.4pt;top:453.6pt;width:258.12pt;height:120.96pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:455.04pt;width:255.24pt;height:118.08pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>随着模型的能力和可靠性不断提升，这一情况发生了改变。Jane Street采用Claude 3.7 Sonnet后，其智能体在长时程、多步骤任务上的表现实现了跨越式提升。智能体能够将任务从头至尾执行完毕，既不会中途停止，也无需返工。随着每一代新模型的推出，AI在全公司的采用不断加快，各团队已将AI融入研究、工程和设计方面的日常工作。如今，Claude已在整个组织内近乎全面部署。</span></div><div style=position:absolute;left:41.4pt;top:554.04pt;width:258.12pt;height:119.88pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:555.48pt;width:255.24pt;height:117pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>由此带来的回报是研究产出的提高。研究人员如今负责监督由多个智能体组成的团队，这些智能体分析代码、监控训练运行并处理结果。过去需要持续监督的实验，如今可在周末期间自主运行。一位研究人员估计，其完成的分析量比一年前多出约50%；其效果是更多的研究得到更快的检验。</span></div><div style=position:absolute;left:41.4pt;top:629.28pt;width:258.12pt;height:132.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:630.72pt;width:255.24pt;height:129.6pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Claude Fable使智能体能够承担更长的多步骤任务。一位研究人员还用它重构了自己开发的一个大型Python应用，将杂乱庞大的代码整理为清晰的结构。随后，他在大约一周内将该代码库迁移至一种更稳健的编程语言。类似的工作通常需要一个团队花费数月才能完成。</span></div><div style=position:absolute;left:311.76pt;top:421.2pt;width:258.48pt;height:28.8pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.2pt;top:422.64pt;width:255.6pt;height:25.92pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>对于一家竞争优势取决于研究速度的公司而言，Fable缩短了运行实验和测试新金融工具所需的时间。</span></div><div style=position:absolute;left:311.76pt;top:456.84pt;width:258.48pt;height:121.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.2pt;top:458.28pt;width:255.6pt;height:118.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>在Jane Street看来，Fable的与众不同之处在于其“研究品味”——即追求合理策略、产出深思熟虑之成果的判断力。其智能体会检查自己的工作，承担更复杂的项目，并始终专注于长期目标。随着智能体的结果日益可靠，Jane Street正在将其更深入地引入研究工作。其使用范围已远远超出研究团队。设计师如今经常为功能编写可直接投入生产的代码，并直接交给开发人员合并。</span></div><div style=position:absolute;left:311.76pt;top:557.28pt;width:258.48pt;height:199.08pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.2pt;top:558.72pt;width:255.6pt;height:196.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Jane Street在其内部评估中目睹了模型能力的快速攀升；这些评估以其自身工程师已完成的工作为参照，从质量、准确性和可信度等方面对智能体的工作进行评分。曾经只能通过其中1%测试的模型最终超越了这些测试，因此Jane Street构建了一项难度更高的智能体编程评估。在该评估中，Claude Fable 5.1的得分较Fable 5提升32%。“在内部基准测试中，Claude Fable 5.1解决的编程问题比Fable 5或Opus 5更多，并在交易直觉方面达到业界领先水平，”​Jane Street量化研究主管Craig Falls表示，“以往的模型工作时间越长，其过程就越难以理解，而Fable 5.1在长时程、多步骤任务中始终保持可读性。”</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3449 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=casestudy-legora1ca.jpg width=816 height=1056><div style=position:absolute;left:471.6pt;top:47.52pt;width:91.44pt;height:15.48pt;background:#141414></div><div class=zhimg style="position:absolute;left:472.32pt;top:48.24pt;width:90pt;height:14.04pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2024年起成为客户</span></div><div style=position:absolute;left:39.24pt;top:95.76pt;width:524.52pt;height:79.2pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:41.4pt;top:97.92pt;width:520.2pt;height:74.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.27;font-style:normal"><span>规模化拓展面向律师的
智能体操作系统</span></div><div style=position:absolute;left:42.48pt;top:194.4pt;width:39.96pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:195.48pt;width:37.8pt;height:13.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:154.08pt;top:215.28pt;width:146.16pt;height:28.08pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:216.72pt;width:143.28pt;height:25.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>服务的律师事务所及企业内部法务团队</span></div><div style=position:absolute;left:154.08pt;top:257.04pt;width:146.16pt;height:41.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:258.48pt;width:143.28pt;height:38.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>每位律师每周挽回的非计费工时，数据来自一项针对31家律师事务所的独立研究</span></div><div style=position:absolute;left:154.08pt;top:311.04pt;width:146.16pt;height:28.08pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:312.48pt;width:143.28pt;height:25.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>员工可使用Claude Enterprise</span></div><div style=position:absolute;left:42.48pt;top:354.24pt;width:68.04pt;height:23.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.92pt;top:355.68pt;width:65.16pt;height:20.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.12pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>14倍</span></div><div style=position:absolute;left:154.08pt;top:353.16pt;width:146.16pt;height:27.72pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:354.6pt;width:143.28pt;height:24.84pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>Claude Code席位数（全公司
从约50个增至700个）</span></div><div style=position:absolute;left:336.96pt;top:233.28pt;width:233.28pt;height:131.04pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:338.4pt;top:234.72pt;width:230.4pt;height:128.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:13.68pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.31;font-style:normal"><span>“AI正日益成为法律工作开展方式的根基，并将重塑律师事务所和企业内部法务团队的运作方式。我们发现，Claude在遵循指令和驱动智能体工作流方面表现出色。”</span></div><div style=position:absolute;left:340.2pt;top:370.44pt;width:200.88pt;height:15.12pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:341.28pt;top:371.52pt;width:198.72pt;height:12.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>Jacob Lauritzen，Legora首席技术官</span></div><div style=position:absolute;left:42.12pt;top:398.88pt;width:61.56pt;height:15.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:399.96pt;width:59.4pt;height:12.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:41.04pt;top:411.84pt;width:259.2pt;height:59.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:413.28pt;width:256.32pt;height:56.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Legora是面向律师的智能体操作系统的开发者，其产品为数千家律师事务所及企业内部法务团队所使用。自Legora平台于2024年10月推出以来，Claude一直为该平台的部分功能提供支持。</span></div><div style=position:absolute;left:42.12pt;top:474.12pt;width:38.88pt;height:14.76pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:475.2pt;width:36.72pt;height:12.6pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:41.04pt;top:486.36pt;width:259.2pt;height:68.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:487.8pt;width:256.32pt;height:65.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>作为一家AI原生的法律公司，Legora开展了严格的模型评估，以选定其平台的基础模型。Claude在最重要的几个维度上表现良好：对指令进行优先级排序并加以遵循，以及随客户需求的变化而灵活调整。</span></div><div style=position:absolute;left:41.04pt;top:561.24pt;width:259.2pt;height:121.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:562.68pt;width:256.32pt;height:118.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>随着Claude能力的增强，该平台的能力也随之提升，能够承担原本需要律师事务所手工完成的复杂、长周期法律工作。Claude是Legora智能体系统内部推理层的组成部分：在起草、文件审阅和法律研究等环节进行规划和任务分派，并在律师看到每一个答案之前，确保其均有来源依据。在Legora自己的评估中，Opus 4.8持续稳定地生成有来源依据的输出，其中在交易文件起草方面提升最大。</span></div><div style=position:absolute;left:311.04pt;top:427.68pt;width:259.2pt;height:108.72pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.48pt;top:429.12pt;width:256.32pt;height:105.84pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>这些成果体现在客户工作中：在一项覆盖14个国家、31家律师事务所的独立研究中，律师们报告平均每周挽回4.3个非计费工时，相当于每100名律师每年新增690万美元的计费收入。在一宗并购交易中，Legora团队用半天时间审阅了一个横跨四个司法管辖区、包含900份文件的数据室——传统团队完成这样的初步审阅需要一周时间。</span></div><div style=position:absolute;left:311.04pt;top:540.72pt;width:259.2pt;height:148.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.48pt;top:542.16pt;width:256.32pt;height:145.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Legora在内部同样基于Claude进行构建。其工程团队很早便采用了Claude Code；如今，一支约80人的工程团队支撑着一个由超过1,500家组织使用的平台。目前，Legora远超一半的代码由AI工具生成，Claude Code是其工程师进行构建所用的主要工具之一；一支专门的开发者体验团队还运行后台编程智能体——每名工程师最多可同时运行10个智能体。Claude Code在Legora的使用规模已增至14倍，全公司从约50个席位增至700多个；如今，每位员工都在市场营销、设计、运营和法律工程等工作中使用Claude。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_4115 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=casestudy-lilly1ba.jpg width=816 height=1056><div style=position:absolute;left:471.6pt;top:47.16pt;width:90.72pt;height:15.12pt;background:#141412></div><div class=zhimg style="position:absolute;left:471.6pt;top:47.16pt;width:90.72pt;height:15.12pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2024年起成为客户</span></div><div style=position:absolute;left:40.68pt;top:95.76pt;width:522.36pt;height:74.16pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.12pt;top:97.2pt;width:519.48pt;height:71.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:31.68pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>将最强大的科学工具
带给每个团队</span></div><div style=position:absolute;left:42.84pt;top:194.4pt;width:66.24pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.92pt;top:195.48pt;width:64.08pt;height:13.32pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:155.88pt;top:216.36pt;width:141.12pt;height:27.36pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:156.96pt;top:217.44pt;width:138.96pt;height:25.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#1a1a19;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>可使用Claude Enterprise的员工</span></div><div style=position:absolute;left:43.2pt;top:258.12pt;width:65.88pt;height:23.76pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:44.28pt;top:259.2pt;width:63.72pt;height:21.6pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.84pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>5倍</span></div><div style=position:absolute;left:155.88pt;top:257.76pt;width:141.12pt;height:15.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:156.96pt;top:258.84pt;width:138.96pt;height:12.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#1a1a19;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>自部署以来的规模扩展</span></div><div style=position:absolute;left:155.88pt;top:297pt;width:141.12pt;height:28.08pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:156.96pt;top:298.08pt;width:138.96pt;height:25.92pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#1a1a19;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.25;font-style:normal"><span>关键职能部门中
积极使用Claude的员工</span></div><div style=position:absolute;left:334.8pt;top:231.84pt;width:237.96pt;height:115.92pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:336.96pt;top:234pt;width:233.64pt;height:111.6pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:12.96pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.38;font-style:normal"><span>“科学与技术始终携手并进。因此，我们首先把Claude交给了我们的科学家。如今，Claude已遍及全公司，我们无法想象回到过去。患者在等待，所以我们不能回头。”</span></div><div style=position:absolute;left:341.64pt;top:352.44pt;width:230.04pt;height:41.04pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:342.72pt;top:353.52pt;width:227.88pt;height:38.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Diogo Rau，Eli Lilly and Company执行副总裁兼首席信息与数字官</span></div><div style=position:absolute;left:42.84pt;top:341.64pt;width:73.44pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.92pt;top:342.72pt;width:71.28pt;height:13.32pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:42.84pt;top:355.32pt;width:257.76pt;height:118.8pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.92pt;top:356.4pt;width:255.6pt;height:116.64pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>Lilly是一家医药公司，致力于将科学转化为治愈之道，让世界各地人们的生活更加美好。150年来，Lilly开创了诸多改变生命的发现。如今，其药物帮助全球数千万人，治疗领域涵盖糖尿病和肥胖症、阿尔茨海默病、免疫系统疾病及癌症。Lilly于2024年开始通过Amazon Bedrock使用Claude，将Anthropic的模型集成到其内部AI平台以及其开发人员编写代码所用的工具中。</span></div><div style=position:absolute;left:42.84pt;top:481.32pt;width:59.04pt;height:15.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.92pt;top:482.4pt;width:56.88pt;height:13.68pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:42.84pt;top:494.64pt;width:257.76pt;height:106.92pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.92pt;top:495.72pt;width:255.6pt;height:104.76pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>2025年7月，Lilly向约10,000名员工推出了Claude Enterprise，主要面向其研究部门。截至2026年4月，Lilly已面向全体员工提供Claude Enterprise，成为首家实现全员覆盖的大型制药公司。Lilly使用Claude最多的五个职能部门为法律与合规、技术、财务、肿瘤及研究。在这些职能部门中，超过85%的全职员工积极使用Claude。</span></div><div style=position:absolute;left:42.84pt;top:608.76pt;width:257.76pt;height:92.88pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.92pt;top:609.84pt;width:255.6pt;height:90.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>Lilly研究部门的早期采用者仍在不断发掘Claude的新用途。过去依赖电子表格宏处理常规数据的生物学家，如今借助Claude在几个小时内即可构建可实际运行的网络应用。化学家可以使用Claude实时可视化复杂数据，从而帮助他们发现新的基序和原子构型，而若采用传统方法，这些工作需耗费数小时。</span></div><div style=position:absolute;left:312.84pt;top:432.72pt;width:257.76pt;height:172.44pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.92pt;top:433.8pt;width:255.6pt;height:170.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>为支持全公司范围的部署，Lilly的技术部门构建了自有的管控措施，随后与Anthropic合作，共同制定支撑Claude Enterprise的企业就绪路线图。这项工作包括：一条安全的私有连接，旨在让Claude能够访问Lilly内部系统，而无需将其暴露于公共互联网；以及数据防泄漏钩子（hooks），用于审计经由Claude传输的数据。Lilly与Anthropic的工程师就这些钩子开展合作，提供需求并协助Anthropic进行测试。该团队还搭建了一个内部市场，供各团队发布技能和插件，并由Claude对提交内容进行初步审核。</span></div><div style=position:absolute;left:312.84pt;top:612.36pt;width:257.76pt;height:80.64pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:313.92pt;top:613.44pt;width:255.6pt;height:78.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>2026年10月，Lilly开始在广泛的用户群体中试点Claude Science（Anthropic面向科学家的工作台）。Lilly以同样的方式参与制定了Claude Science的企业级管控措施，提供需求并协助Anthropic进行测试。两家公司正在共同打造这些工具，以助力推动科学进步。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3502 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=casestudy-mercadolibrex21da.jpg width=816 height=1056><div style=position:absolute;left:473.76pt;top:47.52pt;width:87.12pt;height:15.84pt;background:#141414></div><div class=zhimg style="position:absolute;left:474.48pt;top:48.24pt;width:85.68pt;height:14.4pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2023年起成为客户</span></div><div style=position:absolute;left:41.04pt;top:97.92pt;width:372.6pt;height:74.88pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:99.36pt;width:369.72pt;height:72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.21;font-style:normal"><span>变革拉丁美洲
电子商务</span></div><div style=position:absolute;left:42.48pt;top:194.76pt;width:39.24pt;height:14.4pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:195.84pt;width:37.08pt;height:12.24pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:154.44pt;top:215.28pt;width:144.36pt;height:17.28pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:216.72pt;width:141.48pt;height:14.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>合并代码量同比增长</span></div><div style=position:absolute;left:154.44pt;top:254.16pt;width:144.36pt;height:28.08pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:255.6pt;width:141.48pt;height:25.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>过去一年自主审查的代码提交量</span></div><div style=position:absolute;left:154.44pt;top:296.64pt;width:144.36pt;height:28.08pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:298.08pt;width:141.48pt;height:25.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>非技术团队中每周活跃使用
Cowork的人员比例</span></div><div style=position:absolute;left:334.08pt;top:225.36pt;width:236.16pt;height:112.68pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:335.52pt;top:226.8pt;width:233.28pt;height:109.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:13.68pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.34;font-style:normal"><span>“AI带来的生产力提升让我们最资深的工程师重新投入编写代码，而不仅仅是审查代码。Claude Cowork现已覆盖31,000名员工，是全球规模最大的企业部署之一。”</span></div><div style=position:absolute;left:42.48pt;top:341.64pt;width:60.12pt;height:15.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:342.72pt;width:57.96pt;height:13.68pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:41.76pt;top:354.96pt;width:258.48pt;height:105.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:356.4pt;width:255.6pt;height:102.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Mercado Libre是拉丁美洲领先的电子商务和金融科技公司，业务遍及18个国家。该公司在整个工程部门推广Claude Code，提升了开发人员的生产力。其目标是将基础设施的维护工作——涵盖40,000个微服务的版本迁移、依赖项补丁和测试覆盖——转交给Claude，从而帮助团队更快地交付产品。</span></div><div style=position:absolute;left:42.12pt;top:468.36pt;width:38.88pt;height:15.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:469.44pt;width:36.72pt;height:13.68pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:41.76pt;top:482.04pt;width:258.48pt;height:158.4pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:483.48pt;width:255.6pt;height:155.52pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Mercado Libre评估了多家AI提供商，希望找到一家能够自主承担更多运营负担、提升其工程团队效能的提供商。该公司将Claude Code用于其要求最高的工作负载——代码库迁移、自动化代码审查和测试生成——以及提升开发人员个人生产力。Mercado Libre于2025年1月成为最早的采用者之一；如今，全公司已有23,000多名开发人员使用Claude Code。Claude还负责执行该公司大规模的自主变更：过去一年，在人类监督下，智能体已审查了超过50万次代码提交，并将约9,000个服务迁移至更新的平台。</span></div><div style=position:absolute;left:41.76pt;top:647.64pt;width:258.48pt;height:119.88pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:649.08pt;width:255.6pt;height:117pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>生产力提升已十分显著：2026年第二季度，代码提交量同比增长110%，合并代码量增长超过100%，部署量增长近75%。与此同时，质量也有所改善，回滚次数同比下降。2025年，Mercado Libre部署至生产环境的代码中约有40%由Claude编写，并在发布前经人类工程师审查。到2026年，人工编写的代码已成为例外。这一变化重塑了公司的开发团队，30%的管理岗位人员如今重新开始贡献代码。</span></div><div style=position:absolute;left:311.4pt;top:390.6pt;width:258.12pt;height:68.4pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.84pt;top:392.04pt;width:255.24pt;height:65.52pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Mercado Libre的近期目标是让90%的编码工作自主运行，包括完整的拉取请求（pull request）审查流程。该公司还计划将原本分立的后端、前端和数据库岗位合并为单一的构建者（builder）岗位，由智能体填补其间的空缺。</span></div><div style=position:absolute;left:311.4pt;top:464.4pt;width:258.12pt;height:303.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.84pt;top:465.84pt;width:255.24pt;height:300.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>随后，Mercado Libre将Claude推广至非工程团队。首先是财务团队：一个月内，团队大部分成员已采用Claude Cowork，借助共享技能在几分钟内生成符合品牌规范的演示文稿——这项工作过去每周要耗费数人数小时。Cowork还将月度财务结账时间缩短了三分之一，并改善了内部报告。财务团队现在可以随时预览结账情况，而无需等到月末，因此能够更早发现成本上升等变化并更快作出反应。由于Claude能够结合Mercado Libre的业务背景，它还能就业绩变动原因起草初步解释，再由业务和财务团队进行验证。此后，Claude的应用扩展至市场营销、人力资源、法务、合规以及业务和商务团队，覆盖这些团队中超过26,500人，其中78%目前每周保持活跃。一些采购团队甚至在没有IT部门参与的情况下，自行构建了由Claude驱动的智能体来处理供应商问题。Mercado Libre战略转型总监Maria Pia Garcia表示：“我几乎可以说，我们已经不再使用电子表格了——一切都实现了自动化，基于Claude构建的仪表板随处可见。现在，我们正以AI优先的方式从零开始重新设计核心流程——这些都是人们一直梦寐以求、却认为不可能实现的事情。”</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3497 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=casestudy-mozilla1da.jpg width=816 height=1056><div style=position:absolute;left:473.76pt;top:47.52pt;width:87.12pt;height:15.84pt;background:#171717></div><div class=zhimg style="position:absolute;left:474.48pt;top:48.24pt;width:85.68pt;height:14.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2025年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:97.2pt;width:527.04pt;height:69.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:99.36pt;width:522.72pt;height:64.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>发现攻击者尚未发现的漏洞</span></div><div style=position:absolute;left:61.92pt;top:232.56pt;width:506.52pt;height:127.08pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:63.36pt;top:234pt;width:503.64pt;height:124.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:16.56pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.55;font-style:normal"><span>“多年来，我们在剖析全球顶尖安全研究人员的工作方面积累了丰富经验，而Mythos Preview的能力与他们相比毫不逊色。迄今为止，对于人类能够发现的漏洞，无论其类别或复杂程度如何，我们尚未发现该模型无法发现的情况。”</span></div><div style=position:absolute;left:70.2pt;top:367.56pt;width:218.88pt;height:15.84pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:71.28pt;top:368.64pt;width:216.72pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>Bobby Holley，Firefox首席技术官</span></div><div style=position:absolute;left:41.4pt;top:423.72pt;width:40.32pt;height:16.56pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:424.8pt;width:38.16pt;height:14.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:154.44pt;top:446.04pt;width:144pt;height:38.16pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:447.12pt;width:141.84pt;height:36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>由Claude Opus 4.6发现、截至Firefox 148已修复的漏洞</span></div><div style=position:absolute;left:154.44pt;top:500.4pt;width:144pt;height:37.8pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:501.48pt;width:141.84pt;height:35.64pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.32;font-style:normal"><span>由Claude Mythos Preview发现、截至Firefox 150已修复的漏洞</span></div><div style=position:absolute;left:41.4pt;top:556.56pt;width:60.48pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:557.64pt;width:58.32pt;height:13.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:40.68pt;top:569.52pt;width:252.36pt;height:95.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.12pt;top:570.96pt;width:249.48pt;height:92.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>Mozilla是Firefox的创建者和维护者。Firefox是一款领先的开源浏览器，全球用户达数亿人。二十多年来，Firefox一直是互联网上受到最严格审查的开源代码库之一。其工程团队是Claude Code的早期采用者，如今Claude Code已在Firefox工程团队中得到广泛使用。</span></div><div style=position:absolute;left:311.4pt;top:424.44pt;width:38.16pt;height:15.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.48pt;top:425.52pt;width:36pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:311.04pt;top:437.4pt;width:257.4pt;height:133.56pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.48pt;top:438.84pt;width:254.52pt;height:130.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>Mozilla长期采用先进的安全技术保护Firefox用户，正因如此，Anthropic前沿红队与该公司接洽，在网络防御方面对Claude进行实测。在为期两周的评估中，Claude Opus 4.6在Firefox最关键的代码中发现了22个此前未知的漏洞，其中14个为高危漏洞。Mozilla的工程师在数小时内即开始合入修复，并在Firefox 148中发布。两个月后，Mozilla又针对Claude Mythos Preview识别出的另外271个漏洞发布了修复。</span></div><div style=position:absolute;left:310.68pt;top:554.76pt;width:257.76pt;height:78.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.12pt;top:556.2pt;width:254.88pt;height:75.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>对Mozilla而言，长期以来有利于攻击者的不对称局面正开始扭转：过去需要数年才会暴露的缺陷，如今可由负责相关代码的资深防御人员逐一发现并修复。</span></div><div style=position:absolute;left:311.04pt;top:606.24pt;width:257.4pt;height:115.2pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.48pt;top:607.68pt;width:254.52pt;height:112.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>Mozilla表示：“我们认为，这些工具清楚地表明，大规模AI辅助分析为安全工程师的工具箱增添了一项强大的新手段。数十年来，Firefox经历了极为广泛的测试、静态分析和定期安全审查。尽管如此，该模型仍发现了许多此前未知的缺陷。”</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3849 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=casestudy-paypal1da.jpg width=816 height=1056><div style=position:absolute;left:473.04pt;top:46.8pt;width:89.28pt;height:16.56pt;background:#171717></div><div class=zhimg style="position:absolute;left:473.76pt;top:47.52pt;width:87.84pt;height:15.12pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2025年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:95.76pt;width:527.04pt;height:40.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:97.92pt;width:522.72pt;height:36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.14;font-style:normal"><span>为逾1.2万名员工规模化部署AI</span></div><div style=position:absolute;left:42.48pt;top:195.12pt;width:39.24pt;height:14.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:196.2pt;width:37.08pt;height:11.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:154.44pt;top:215.28pt;width:144.36pt;height:27.36pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:216.72pt;width:141.48pt;height:24.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.44;font-style:normal"><span>Claude Enterprise月活跃用户</span></div><div style=position:absolute;left:65.88pt;top:258.84pt;width:43.2pt;height:21.6pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:66.96pt;top:259.92pt;width:41.04pt;height:19.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:14.4pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>分钟</span></div><div style=position:absolute;left:154.44pt;top:257.4pt;width:144.36pt;height:30.6pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.88pt;top:258.84pt;width:141.48pt;height:27.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.44;font-style:normal"><span>销售团队成员人均每周节省时间</span></div><div style=position:absolute;left:335.16pt;top:233.28pt;width:235.08pt;height:146.88pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:336.6pt;top:234.72pt;width:232.2pt;height:144pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:13.32pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>“2025年，我们为员工提供了领先的AI工具，并让成果说话。我们的员工如今会把Claude当作日常的思考与执行伙伴，这让我确信，Claude已成为PayPal值得信赖的协作者。”</span></div><div style=position:absolute;left:340.92pt;top:389.16pt;width:207.36pt;height:26.64pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:342pt;top:390.24pt;width:205.2pt;height:24.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.38;font-style:normal"><span>Anshu Bhardwaj，PayPal首席AI转型与精简官</span></div><div style=position:absolute;left:42.48pt;top:302.4pt;width:60.12pt;height:15.84pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:303.48pt;width:57.96pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:41.4pt;top:316.08pt;width:258.84pt;height:66.96pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:317.52pt;width:255.96pt;height:64.08pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>PayPal运营着全球最大的数字支付网络之一，深受数亿消费者和商户信赖。作为一家受全球监管的金融机构，PayPal开发和交付的技术满足一系列更严格、更复杂的合规要求。</span></div><div style=position:absolute;left:41.76pt;top:391.32pt;width:60.84pt;height:14.4pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:392.4pt;width:58.68pt;height:12.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:41.4pt;top:403.56pt;width:258.84pt;height:67.68pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:405pt;width:255.96pt;height:64.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>如今，Claude及其他工具正在支撑PayPal众多员工的工作方式及其向客户提供的智能服务。目前已有超过12,000名PayPal员工在产品、技术和销售领域使用Claude。Claude Code是其技术团队最常用的AI工具之一。</span></div><div style=position:absolute;left:41.4pt;top:478.08pt;width:258.84pt;height:68.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:479.52pt;width:255.96pt;height:65.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>PayPal产品部门的各团队如今可通过Claude自助完成产品分析和仪表盘创建。其产品团队构建了用于数据查询和检索的定制MCP服务器，减少了对工程和数据分析人员的依赖。</span></div><div style=position:absolute;left:41.4pt;top:553.32pt;width:258.84pt;height:106.92pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.84pt;top:554.76pt;width:255.96pt;height:104.04pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>借助Claude，商户审核、合规审查和交易周期均得到优化，审查效率得以提升，此前分散在多个相互孤立的工具中的数据也得以整合。过去需要数小时的审查，如今只需其中一小部分时间。自2025年8月起，PayPal销售团队一直使用一款专为销售管道管理和客户风险审查定制开发的插件，每位用户每周平均节省45分钟。</span></div><div style=position:absolute;left:311.04pt;top:457.2pt;width:259.2pt;height:133.2pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.48pt;top:458.64pt;width:256.32pt;height:130.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>客户管理团队使用基于Claude构建的AI驱动分析平台AMOS（客户管理操作系统），在几分钟而非几天内即可获得客户组合洞察、商户健康状况诊断和销售管道情报。该AI驱动分析平台以对话方式访问实时数据，取代了手动制作仪表盘。AMOS已将报告准备时间缩短至5至10分钟，并每周呈现商户增长信号，其中部分信号此前未被发现。这使客户经理能够将更多时间用于服务商户。</span></div><div style=position:absolute;left:311.04pt;top:596.88pt;width:259.2pt;height:69.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.48pt;top:598.32pt;width:256.32pt;height:66.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.35;font-style:normal"><span>此外，PayPal是Anthropic“AI Fluency for Small Business”课程的合作伙伴，该课程帮助小企业员工（无论从事客户互动、后台管理、供应链运营还是领导工作）培养实用的协作技能。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3492 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=casestudy-rakuten1ba.jpg width=816 height=1056><div style=position:absolute;left:471.6pt;top:47.52pt;width:91.44pt;height:15.48pt;background:#141414></div><div class=zhimg style="position:absolute;left:472.32pt;top:48.24pt;width:90pt;height:14.04pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2024年起成为客户</span></div><div style=position:absolute;left:39.24pt;top:95.76pt;width:524.52pt;height:80.64pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:41.4pt;top:97.92pt;width:520.2pt;height:76.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.27;font-style:normal"><span>让每一位员工
都成为构建者</span></div><div style=position:absolute;left:42.48pt;top:194.4pt;width:39.96pt;height:15.48pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.56pt;top:195.48pt;width:37.8pt;height:13.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成果</span></div><div style=position:absolute;left:154.08pt;top:215.28pt;width:146.16pt;height:28.08pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:216.72pt;width:143.28pt;height:25.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>使用AI的业务部门</span></div><div style=position:absolute;left:154.08pt;top:253.44pt;width:146.16pt;height:28.8pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:254.88pt;width:143.28pt;height:25.92pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>复杂代码修改中实现的代码准确率</span></div><div style=position:absolute;left:66.6pt;top:297pt;width:42.48pt;height:22.32pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:67.68pt;top:298.08pt;width:40.32pt;height:20.16pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.12pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>小时</span></div><div style=position:absolute;left:154.08pt;top:295.2pt;width:146.16pt;height:18pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:296.64pt;width:143.28pt;height:15.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>自主编码</span></div><div style=position:absolute;left:88.56pt;top:337.32pt;width:42.12pt;height:23.04pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:89.64pt;top:338.4pt;width:39.96pt;height:20.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:15.12pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.1;font-style:normal"><span>天</span></div><div style=position:absolute;left:154.08pt;top:335.52pt;width:146.16pt;height:27.36pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:155.52pt;top:336.96pt;width:143.28pt;height:24.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.36;font-style:normal"><span>新功能上市所需的工作日</span></div><div style=position:absolute;left:336.96pt;top:233.28pt;width:233.28pt;height:146.88pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:338.4pt;top:234.72pt;width:230.4pt;height:144pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:13.68pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.31;font-style:normal"><span>“当我们借助Claude Code这样的智能体，将创新的成本降至最低——实现从构想到投产的快速转化时，它们便能大放异彩。为有能力的人配备能把握上下文、具备品味的智能体，就能让隐藏的人才将潜力放大100倍。”</span></div><div style=position:absolute;left:340.2pt;top:387.72pt;width:229.68pt;height:27.36pt;background:#e9e6dd></div><div class=zhimg style="position:absolute;left:341.28pt;top:388.8pt;width:227.52pt;height:25.2pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>Yusuke Kaji，Rakuten的AI业务部门总经理</span></div><div style=position:absolute;left:42.12pt;top:380.52pt;width:63.36pt;height:15.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:381.6pt;width:61.2pt;height:12.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>背景</span></div><div style=position:absolute;left:41.04pt;top:393.84pt;width:259.2pt;height:107.28pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:395.28pt;width:256.32pt;height:104.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>Rakuten Group是一家全球性互联网和电子商务公司，在30个国家和地区经营70余项业务，为全球逾20亿会员提供服务。2023年，Rakuten在全公司范围内发起了将AI融入其业务各个环节的行动，并称之为“AI化”（AI-⁠nization）。对其开发人员而言，这意味着AI能够在坚守公司高质量、高安全标准的同时，构建更具雄心的产品。</span></div><div style=position:absolute;left:42.12pt;top:507.96pt;width:38.88pt;height:15.12pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:43.2pt;top:509.04pt;width:36.72pt;height:12.96pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9.36pt;font-weight:600;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>成效</span></div><div style=position:absolute;left:41.04pt;top:520.56pt;width:259.2pt;height:146.88pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:522pt;width:256.32pt;height:144pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>借助Claude Code，Rakuten的团队能够在有限的人工指导下连续自主编码七小时，在复杂的多语言代码库中实现99.9%的准确率。Claude Code将新功能的上市时间缩短了75%以上，Rakuten的团队如今每两周即可发布一次重大版本，而非每季度一次。随着Claude Code在全公司推广，Rakuten的团队结构也被重塑：原本分属工程、设计和可靠性的岗位已经融合，通才型人员如今能够完成从构想到部署的全流程产品开发。</span></div><div style=position:absolute;left:311.04pt;top:457.2pt;width:259.2pt;height:237.6pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:312.48pt;top:458.64pt;width:256.32pt;height:234.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.33;font-style:normal"><span>随后，Rakuten在全组织范围内部署了Claude Managed Agents，在产品、销售、营销和财务领域分别配置专门智能体，每个智能体均在一周内完成部署。员工在Slack或Microsoft Teams中向Claude分配任务，即可收到完成的工作成果，从提案演示文稿、电子表格到可运行的应用程序。管理人员与Claude协同工作，完成审核并梳理流程瓶颈。随着Claude能力的扩展，Rakuten的智能体获得了更高的自主性，如今可在夜间完成精细复杂的长时间运行任务。Rakuten按任务完成情况和单任务成本衡量每项工作，并将每项任务分配给能力足以支撑其成本的模型：较小的Claude模型处理常规工作，而要求最高的任务则在前沿模型上以最高推理投入程度运行。“在最高投入程度下，Fable会对自身工作进行反思和验证。对我们而言，这正是高度自主运营得以实现的原因——额外的思考投入足以收回自身成本。”Kaji表示。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3808 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=casestudy-salesforce1b.jpg width=816 height=1056><div style=position:absolute;left:473.04pt;top:47.52pt;width:89.28pt;height:15.12pt;background:#141414></div><div class=zhimg style="position:absolute;left:473.76pt;top:48.24pt;width:87.84pt;height:13.68pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:8.64pt;font-weight:600;color:#fff;text-align:center;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>自2023年起成为客户</span></div><div style=position:absolute;left:40.32pt;top:97.2pt;width:393.84pt;height:72.72pt;background:#f5f5ed></div><div class=zhimg style="position:absolute;left:42.48pt;top:99.36pt;width:389.52pt;height:68.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:28.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.15;font-style:normal"><span>重塑一家全球企业的
