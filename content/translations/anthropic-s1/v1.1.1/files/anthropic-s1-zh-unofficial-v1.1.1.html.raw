ak:break-word;line-break:strict">Societe Generale</div></div></div></div></td><td style=font-size:0;text-align:left;vertical-align:top><div style=left:432pt;position:absolute;top:67.5pt;width:144pt><div><div style=line-height:7.18pt;position:absolute;top:4.27pt;width:144pt><div class=zh style="position:absolute;top:-2.35pt;left:0;width:144pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">TD Securities</div></div></div></div></td></tr><tr style=height:15pt><td style=font-size:0;text-align:left;vertical-align:top><div style=position:absolute;top:82.5pt;width:144pt><div><div style=line-height:6.05pt;position:absolute;top:5.72pt;width:144pt><div class=zh style="position:absolute;top:-1.98pt;left:0;width:144pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">BTIG</div></div></div></div></td><td style=font-size:0;text-align:left;vertical-align:top><div style=left:144pt;position:absolute;top:82.5pt;width:144pt><div><div style=line-height:6.05pt;position:absolute;top:5.72pt;width:144pt><div class=zh style="position:absolute;top:-1.98pt;left:0;width:144pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">Cantor</div></div></div></div></td><td style=font-size:0;text-align:left;vertical-align:top><div style=left:288pt;position:absolute;top:82.5pt;width:144pt><div><div style=line-height:6.05pt;position:absolute;top:5.72pt;width:144pt><div class=zh style="position:absolute;top:-1.98pt;left:0;width:144pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">Capital One Securities</div></div></div></div></td><td style=font-size:0;text-align:left;vertical-align:top><div style=left:432pt;position:absolute;top:82.5pt;width:144pt><div><div style=line-height:6.05pt;position:absolute;top:5.72pt;width:144pt><div class=zh style="position:absolute;top:-1.98pt;left:0;width:144pt;line-height:10pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:8pt;font-style:normal;font-weight:400;text-decoration:none;color:#000;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">Macquarie Capital</div></div></div></div></td></tr></tbody></table></div></div></div><div style=font-size:12pt;line-height:6.8pt;position:absolute;top:757.63pt;width:612pt><div class=zh style="position:absolute;top:-2.23pt;left:0;width:612pt;line-height:11.25pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:none;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">招股说明书日期：          </div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_4004 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=a2026-10x25pg1a.jpg width=816 height=1056><div style=position:absolute;left:41.4pt;top:326.52pt;width:511.2pt;height:84.96pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.2pt;top:328.32pt;width:507.6pt;height:81.36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:15.12pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.4;font-style:normal"><span>我们相信，AI是人类历史上影响最为深远的技术之一。如果管理得当，AI可能迅速加快科学创新，大幅提高经济增长率，使重大疾病的治愈触手可及，并解决人类世世代代努力仍未能攻克的难题。</span></div><div style=position:absolute;left:42.48pt;top:424.44pt;width:258.48pt;height:46.44pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.92pt;top:425.88pt;width:255.6pt;height:43.56pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>Anthropic的目标是在实现上述益处的同时，应对并防范如此迅猛、如此强大的技术革命所带来的风险。</span></div><div style=position:absolute;left:42.48pt;top:479.52pt;width:258.48pt;height:92.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.92pt;top:480.96pt;width:255.6pt;height:89.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>我们希望Anthropic的每一位投资者都了解以下四点：AI的巨大潜力、我们必须应对的风险、Anthropic在构建公司及在世界上运营方面的独特方式，以及我们的行为可能在哪些方面有别于一家纯粹追求利润最大化的公司。</span></div><div style=position:absolute;left:42.84pt;top:584.64pt;width:102.6pt;height:18pt;background:#fff></div><div class=zhimg style="position:absolute;left:44.28pt;top:586.08pt;width:99.72pt;height:15.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:10.8pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.3;font-style:normal"><span>AI的潜力</span></div><div style=position:absolute;left:41.76pt;top:610.56pt;width:259.2pt;height:107.28pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.2pt;top:612pt;width:256.32pt;height:104.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>2020年，我们的创始人中有四位合著了一篇论文，记录了AI的规模定律（scaling laws）。规模定律描述了同时增加算力、数据、模型规模和训练环境如何使AI的通用认知能力迅速提升，进而使其经济价值迅速提升。在当时的许多人看来，机器智能会如此高度</span></div><div style=position:absolute;left:311.76pt;top:424.44pt;width:258.48pt;height:47.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:313.2pt;top:425.88pt;width:255.6pt;height:44.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>依赖于规模这一观点令人惊讶，但基于规模定律作出的预测一次又一次得到了验证。¹</span></div><div style=position:absolute;left:311.76pt;top:479.52pt;width:258.48pt;height:137.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:313.2pt;top:480.96pt;width:255.6pt;height:134.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>这一现象在一定程度上类似于计算机芯片的摩尔定律：根据该定律，数十年来这些芯片的计算能力每12至18个月翻一番。摩尔定律是从个人电脑到互联网等一系列产业的基础，这些产业彻底变革了现代经济，但我们相信，机器认知的指数级增长所产生的影响，甚至将远远超过计算机芯片的指数级增长。</span></div><div style=position:absolute;left:317.88pt;top:651.24pt;width:251.28pt;height:84.24pt;background:#fff></div><div class=zhimg style="position:absolute;left:318.96pt;top:652.32pt;width:249.12pt;height:82.08pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:7.2pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.38;font-style:normal"><span>这一观点与Richard Sutton提出的“苦涩的教训”（bitter lesson）概念密切相关，该概念描述了单纯的规模如何始终胜过更具针对性、更复杂的AI模型训练方法。请注意，规模并非模型能力提升的唯一来源——算法效率提升（“算力倍增因子”）也发挥了重要作用，它们使我们能够（例如）以相同的算力实现更强的能力。但这些效率提升本身也是借助规模定律发现的：研究人员测试新的想法，并保留对规模趋势改善最大的那些想法。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3999 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=a2026-10x25pg2a.jpg width=816 height=1056><div style=position:absolute;left:41.76pt;top:44.64pt;width:257.04pt;height:197.28pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.2pt;top:46.08pt;width:254.16pt;height:194.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.54;font-style:normal"><span>Anthropic的核心观点是，认知能力的指数级增长很可能会持续下去，最终达到我们所称的“数据中心里的天才之国”的水平——数以百万计的虚拟智能体，有能力彻底变革人类活动的每一个领域：软件、物理、数学、生物、医学、金融、经济、商业、机器人，以及军事和情报能力等等。Anthropic始终将与其他企业合作作为首要重点，因为我们理解，AI的非凡效益将主要来自企业及世界各地其他组织部署我们模型的方式。</span></div><div style=position:absolute;left:41.76pt;top:248.76pt;width:249.12pt;height:47.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.2pt;top:250.2pt;width:246.24pt;height:44.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.54;font-style:normal"><span>其中有几项应用尤其具有提升人类生活质量的巨大潜力，值得重点说明：</span></div><div style=position:absolute;left:56.88pt;top:304.56pt;width:239.4pt;height:212.76pt;background:#fff></div><div class=zhimg style="position:absolute;left:57.96pt;top:305.64pt;width:237.24pt;height:210.6pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.54;font-style:normal"><span>首先，我们相信AI将深刻地加快生物学和医学的进步速度，有可能治愈困扰人类数千年的疾病，包括癌症、阿尔茨海默病、心脏病、罕见遗传病以及主要传染病。AI开创了从事科学研究和药物开发的全新方式，我们希望在开发惠及更广泛科学界的工具方面发挥引领作用。Anthropic已与众多生物技术及制药公司合作，改进基础发现和临床试验，从帮助制药公司科学家攻克药物</span></div><div style=position:absolute;left:326.88pt;top:44.64pt;width:242.64pt;height:210.6pt;background:#fff></div><div class=zhimg style="position:absolute;left:328.32pt;top:46.08pt;width:239.76pt;height:207.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.54;font-style:normal"><span>发现难题，到将撰写临床试验报告所需的时间从数月缩短至数分钟。为打造最好的科学工具，我们的团队需要具备从事科学研究和药物发现的第一手经验。我们已开始直接利用Claude取得生物学发现，其中包括发现一种分子机器，它可能有潜力被开发为一种新型生物技术工具，或可用于基因编辑。我们预计Claude将在不久的将来促成更多新的生物学发现，我们将与合作伙伴共同验证这些发现，携手提高整个领域的发现速度。</span></div><div style=position:absolute;left:327.24pt;top:264.6pt;width:241.92pt;height:257.4pt;background:#fff></div><div class=zhimg style="position:absolute;left:328.32pt;top:265.68pt;width:239.76pt;height:255.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.54;font-style:normal"><span>其次，AI可以成为推动经济增长的强大杠杆。作为一种通用技术，AI有潜力提升经济中每一个部门的生产率。近几十年来，发达经济体的生产率增长陷入停滞，部分源于结构性原因，部分则是因为新的想法似乎越来越难以发现。AI可能扭转这一趋势。AI可以直接提高劳动者和企业在以往难以自动化的任务中的生产率（部分分析表明，仅此一项即可能抵消近期的生产率放缓）。但AI同时也是一种“创新方法的创新”——它能够改进企业构思新产品和新工作方式的过程本身。这可能使经济增长持续加速，同时带来增长对人类福祉的种种益处。</span></div><div style=position:absolute;left:327.24pt;top:530.28pt;width:241.92pt;height:210.96pt;background:#fff></div><div class=zhimg style="position:absolute;left:328.32pt;top:531.36pt;width:239.76pt;height:208.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:9.72pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.54;font-style:normal"><span>第三，AI可以将这些效益扩散至全世界，帮助提高全球经济增长率。如今，即使针对可怕疾病的药物已被研发出来，由于世界较贫困地区在物流、人员配备或可及性方面的不足，这些药物也并非总能惠及所有需要的人。据世界卫生组织（“WHO”）和世界银行估计，46亿人（超过世界人口的一半）仍无法获得基本卫生服务。我们相信AI在这方面同样可以提供帮助，具体方式包括扩大稀缺专业知识的覆盖范围、强化卫生系统赖以运行的数据，以及帮助将治疗送达最需要的地方。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3994 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=a2026-10x25pg3a.jpg width=816 height=1056><div style=position:absolute;left:56.52pt;top:43.92pt;width:243.72pt;height:452.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:58.68pt;top:46.08pt;width:239.4pt;height:447.84pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>我们在非洲已有多项正在进行的疟疾及其他疾病流行病学建模合作。例如，在2026年刚果民主共和国埃博拉疫情暴发期间，世界卫生组织（WHO）非洲区域办事处借助Claude，将编制每日情况报告所需的时间从一整天缩短至不到一小时，使其团队在决定治疗中心选址时能够运行多个疾病模型，而不是只运行一个。我们正与盖茨基金会合作，帮助各国卫生部利用其数据部署卫生工作者、管理供应链并发现疫情暴发；我们还为从乌干达、海地到蒙古等约100个中低收入国家的医生提供免费的AI驱动临床检索服务。我们正与国际救援委员会合作，探索如何利用Claude将尼日利亚的儿童健康记录数字化并加以分析，帮助工作人员识别存在营养不良风险的儿童，让有限的资源发挥更大作用。更广泛而言，AI可以帮助强化目前较为薄弱的市场。2000年代，移动电话在发展中国家发挥了这一作用，使人们能够获取关键的价格信息，从而推动了贸易流通。AI可能在专业知识领域发挥同样的作用，让任何人都能获得律师、会计师或农艺师的知识和技能，从而提高经济效率，加速全球增长。</span></div><div style=position:absolute;left:56.16pt;top:503.28pt;width:244.08pt;height:213.84pt;background:#fff></div><div class=zhimg style="position:absolute;left:58.32pt;top:505.44pt;width:239.76pt;height:209.52pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>第四，AI可能提升政府服务质量，并构建国家的技术能力。税务机关、社会服务、医疗项目、规划与许可审批——民众在与这些及类似职能打交道时往往深感困扰，而借助足够强大的AI，这些职能都可能得到彻底改进并实现现代化。我们已与美国联邦政府、众多州政府以及美国盟友在儿童服务、社会保障管理、网络安全和情报收集等领域开展合作。在犹他州，十个州政府机构的开发人员正在使用Claude对公共服务背后的软件进行现代化改造；在加利福尼亚州，</span></div><div style=position:absolute;left:326.52pt;top:297.72pt;width:242.28pt;height:185.4pt;background:#fff></div><div class=zhimg style="position:absolute;left:328.68pt;top:299.88pt;width:237.96pt;height:181.08pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>Claude正在帮助缩短机动车管理局（DMV）的排队时间，并更好地为医疗补助（Medicaid）受益人提供服务。在英国，Claude正在帮助求职者顺利使用各项政府服务。同样，AI可以用于促进和巩固民主制度，让地缘政治历史的弧线弯向自由，方式是帮助民主政府兑现对公民的承诺，保护民主制度免受网络攻击和外国干预，并确保自由社会在全球最强大的技术领域保持领先。</span></div><div style=position:absolute;left:311.76pt;top:488.16pt;width:257.04pt;height:109.8pt;background:#fff></div><div class=zhimg style="position:absolute;left:313.92pt;top:490.32pt;width:252.72pt;height:105.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>这些远非AI的全部应用，但它们展现了这项技术在建设更美好世界方面的非凡潜力。我们拟与客户一道，运用我们的AI模型彻底变革上述领域以及人类事业的数十个其他领域。此举很可能代表着有史以来最大的经济机遇。</span></div><div style=position:absolute;left:312.48pt;top:609.12pt;width:78.12pt;height:17.64pt;background:#fff></div><div class=zhimg style="position:absolute;left:314.28pt;top:610.92pt;width:74.52pt;height:14.04pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:11.52pt;font-weight:600;color:#171717;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>AI的风险</span></div><div style=position:absolute;left:311.76pt;top:633.6pt;width:257.04pt;height:79.2pt;background:#fff></div><div class=zhimg style="position:absolute;left:313.92pt;top:635.76pt;width:252.72pt;height:74.88pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>构建AI就是驾驭认知本身，而任何如此强大的事物既可用于行善，也可用于作恶。Anthropic是一家高度以价值观为导向的组织，其创立在很大程度上是为了帮助世界实现AI的益处并规避其危险。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3989 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=a2026-10x25pg4a.jpg width=816 height=1056><div style=position:absolute;left:43.56pt;top:44.64pt;width:257.76pt;height:34.2pt;background:#fff></div><div class=zhimg style="position:absolute;left:45.36pt;top:46.44pt;width:254.16pt;height:30.6pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>风险大致分四类：滥用、失控、威权滥用和经济冲击。</span></div><div style=position:absolute;left:57.6pt;top:84.6pt;width:245.88pt;height:136.08pt;background:#fff></div><div class=zhimg style="position:absolute;left:59.4pt;top:86.4pt;width:242.28pt;height:132.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>AI可能被意图作恶者滥用，例如用于实施网络攻击或设计生物武器。我们设有严格的护栏和可信访问计划，旨在阻止我们的技术被滥用，同时仍支持有益的应用。我们经常阻断滥用我们模型的企图，在适当情况下向执法部门报告，并努力以透明的方式向公众披露。</span></div><div style=position:absolute;left:57.6pt;top:229.32pt;width:245.88pt;height:271.44pt;background:#fff></div><div class=zhimg style="position:absolute;left:59.4pt;top:231.12pt;width:242.28pt;height:267.84pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>AI还可能以并非我们（及我们的用户）本意的方式自主行事——近期多起引人注目的网络安全事件即为例证。对足够强大的AI系统失去控制，可能构成最高级别的全球安全威胁。Anthropic首创了多种加强对我们AI系统控制的方法，其中包括机制可解释性和宪法训练：前者使我们能够深入AI模型内部，尝试理解其行为方式；后者使我们能够训练AI模型按照一份具体的成文文件——Claude的宪法——行事。我们还发布长达数百页的模型系统卡，旨在让公众了解我们在模型安全方面的进展。长期以来，我们一贯披露相关事件并发布研究成果，以帮助在全行业范围内缓解这一风险。</span></div><div style=position:absolute;left:57.6pt;top:509.76pt;width:245.88pt;height:91.08pt;background:#fff></div><div class=zhimg style="position:absolute;left:59.4pt;top:511.56pt;width:242.28pt;height:87.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>威权政府可能利用AI打造高科技监控国家、加剧压迫，并使自身被推翻的难度大大增加。我们致力于与自由社会合作，以制衡威权滥用，并促进自由与民主。</span></div><div style=position:absolute;left:57.6pt;top:609.84pt;width:245.88pt;height:120.96pt;background:#fff></div><div class=zhimg style="position:absolute;left:59.4pt;top:611.64pt;width:242.28pt;height:117.36pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>最后，AI惊人的经济价值可能伴随着经济冲击，与以往技术所带来的冲击类似，但规模更大。我们致力于研究这种冲击——我们维护一项经济指数，提供有关Claude在整个经济中使用情况的汇总信息；我们的研究人员还构建宏观经济模型，以预测AI未来可能产生的影响。我们还认为可能需要采取更为激进的行动，并已承诺投入2亿美元，</span></div><div style=position:absolute;left:327.6pt;top:44.64pt;width:247.32pt;height:181.08pt;background:#fff></div><div class=zhimg style="position:absolute;left:329.4pt;top:46.44pt;width:243.72pt;height:177.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>与各国政府合作开展研究，探索应对经济变化的不同方式。我们这样做是为了找到证据，判断哪些类型的干预措施是有效的，从而一旦社会确实遭遇经济冲击，我们届时将已协助打造出可用于应对的合适工具，并已降低其风险。我们预计未来将大幅扩大这项资金投入。</span></div><div style=position:absolute;left:313.2pt;top:234.36pt;width:261.72pt;height:74.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:315pt;top:236.16pt;width:258.12pt;height:70.56pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>我们认为，帮助世界理解这些风险、在这些风险源自我们的AI模型时加以防范或缓解，并与各国政府及业内其他各方合作在社会层面应对这些风险，是我们个人的责任。</span></div><div style=position:absolute;left:313.2pt;top:323.64pt;width:192.6pt;height:18.72pt;background:#fff></div><div class=zhimg style="position:absolute;left:315pt;top:325.44pt;width:189pt;height:15.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:11.52pt;font-weight:700;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>Anthropic的独特方法</span></div><div style=position:absolute;left:313.2pt;top:350.64pt;width:261.72pt;height:226.08pt;background:#fff></div><div class=zhimg style="position:absolute;left:315pt;top:352.44pt;width:258.12pt;height:222.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>驾驭一项具有上述特性的技术，需要采取与一般公司截然不同的方法。经济学家用“外部性”一词指代发生在公司与其客户之间的交易之外、因而市场无法充分奖励或惩罚的社会影响：例如，工厂造成的污染成本，或一家公司取得的研究突破被其他公司自由借鉴所产生的价值。AI具有异常巨大的外部性，既有正面的，也有负面的。培育正外部性并防范负外部性，在一定程度上与营利性公司的天然激励机制以及上市公司的标准治理结构存在张力。</span></div><div style=position:absolute;left:313.2pt;top:585.72pt;width:261.72pt;height:151.2pt;background:#fff></div><div class=zhimg style="position:absolute;left:315pt;top:587.52pt;width:258.12pt;height:147.6pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#141414;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.49;font-style:normal"><span>作为创始人和企业领导者，我们深信创业型资本主义能够为人类带来巨大福祉。但我们也相信，对于AI这样影响深远的技术，创业型资本主义必须由保护公共利益并尽可能广泛地分享收益的机制加以平衡和增强。我们构建Anthropic的方方面面，从我们的文化到公司结构，都旨在确保我们能够在形势需要时为公共利益行事。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3984 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=a2026-10x25pg5a.jpg width=816 height=1056><div style=position:absolute;left:41.76pt;top:43.92pt;width:259.2pt;height:122.04pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.92pt;top:46.08pt;width:254.88pt;height:117.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.48;font-style:normal"><span>这一切始于Anthropic的文化。我们的文化建立在公共利益、诚实与信任、谦逊低调的协作，以及坚持不懈地专注于做简单而有效之事的基础之上。每一位到Anthropic参加面试的人都要经过旨在评估上述特质的面试流程；对于未能展现这些特质的候选人，即使其技术实力极强，我们也愿意拒绝。</span></div><div style=position:absolute;left:41.76pt;top:173.88pt;width:259.2pt;height:122.76pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.92pt;top:176.04pt;width:254.88pt;height:118.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.48;font-style:normal"><span>相对于其影响范围，Anthropic的规模依然很小。截至2026年9月30日，每名Anthropic员工支撑的过去十二个月收入超过660万美元，明显高于美国最大型上市公司的平均水平。我们相信，一支拥有共同使命、紧密团结的团队所能取得的成就，可以远超其规模所预示的水平；在发展壮大的过程中，我们打算保持这一特质。</span></div><div style=position:absolute;left:41.76pt;top:303.84pt;width:259.2pt;height:136.44pt;background:#fff></div><div class=zhimg style="position:absolute;left:43.92pt;top:306pt;width:254.88pt;height:132.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.48;font-style:normal"><span>所有员工入职时均可享受捐赠匹配：员工每承诺将一股股权捐赠给慈善事业，Anthropic便额外创设一股与之匹配，该股同样以相同方式承诺捐出。截至本文撰写之时，略多于半数的员工已承诺捐出至少部分股权。²我们七人亦均已承诺将各自在Anthropic所持个人股权的80%捐赠给慈善事业。</span></div><div style=position:absolute;left:311.76pt;top:43.92pt;width:257.76pt;height:316.8pt;background:#fff></div><div class=zhimg style="position:absolute;left:313.92pt;top:46.08pt;width:253.44pt;height:312.48pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.48;font-style:normal"><span>作为联合创始人和领导者，我们力求在内部做到彻底坦诚，并形成了不同职级人员之间活跃、公开辩论的文化。我们的首席执行官Dario通常每两周会在全公司面前公开讲述他正在考虑的决策以及行业现状；其他联合创始人和领导者也经常在各自负责的领域这样做。员工们在面向全公司开放的讨论论坛中，就我们使命的复杂性所带来的种种权衡展开辩论。这种开放的文化是我们人才密度高、人才保留率依然位居行业前列的原因之一。我们七人仍全部在公司任职，这使Anthropic成为唯一一家保留了整个创始团队的主要AI公司。我们最早的100名员工中，超过四分之三仍在这里工作；即便是离开的员工，也常常会向他人推荐Anthropic，或重返公司。我们的统计数据显示，在我们本希望挽留的离职员工中，有19%后来重返Anthropic工作。</span></div><div style=position:absolute;left:311.76pt;top:369.36pt;width:257.76pt;height:271.44pt;background:#fff></div><div class=zhimg style="position:absolute;left:313.92pt;top:371.52pt;width:253.44pt;height:267.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.08pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.48;font-style:normal"><span>但仅有文化是不够的：正式的治理承诺同样重要。我们设计的治理结构旨在平衡商业成功与公共利益。Anthropic是一家公益公司，这意味着我们的董事会负责在股东的财务利益与我们的公益使命以及受我们行为重大影响者的利益之间进行权衡。此外，我们的治理结构由三个群体分享权力：我们的联合创始人、我们的员工以及长期利益信托（“LTBT”）。LTBT是一个与Anthropic无任何财务利害关系的独立机构，负责督促公司坚守其长期公益使命。其成员在AI的正面和负面外部性最可能出现的领域拥有专业知识，包括国家安全、经济学、全球卫生和科学。</span></div><div style=position:absolute;left:312.12pt;top:679.68pt;width:257.04pt;height:56.52pt;background:#fff></div><div class=zhimg style="position:absolute;left:313.92pt;top:681.48pt;width:253.44pt;height:52.92pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:7.2pt;font-weight:400;color:#111;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.38;font-style:normal"><span>² 对于2024年5月之前入职的员工，我们提供最高为其股份50%的捐赠匹配。其中超过70%作出了承诺，超过25%承诺捐出全部50%。对于2024年5月之后入职的员工，我们提供最高为其股份25%的捐赠匹配；近50%已参与，近30%承诺捐出全部25%。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3979 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src=data:image/jpeg;base64, alt=a2026-10x25pg6a.jpg width=816 height=1056><div style=position:absolute;left:40.32pt;top:43.2pt;width:258.84pt;height:152.64pt;background:#fff></div><div class=zhimg style="position:absolute;left:42.48pt;top:45.36pt;width:254.52pt;height:148.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>LTBT选举我们七名董事中的四名，其中一个席位的提名和罢免受保障措施约束（包括在公司与LTBT意见分歧时由员工投票）。我们这些联合创始人有权选举其余三名董事。我们增强的投票权并非永久，一旦我们当中留在投票实体内的人少于三名，投票权即转移至我们的普通股股东。本招股说明书对该结构有更详细的描述。</span></div><div style=position:absolute;left:40.32pt;top:203.04pt;width:258.84pt;height:242.64pt;background:#fff></div><div class=zhimg style="position:absolute;left:42.48pt;top:205.2pt;width:254.52pt;height:238.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>除个人慈善捐赠外，我们还将可衡量的一部分资源专门用于推进AI的非市场效益并降低其风险，超出市场逻辑本身所激励的范围。在首次公开发行之前，我们将公司5%的股权划拨给一只致力于公共利益的基金。股价较上一次出资时（以首次公开发行价格为起点）每持续上涨50%，我们将由董事会酌情决定另行划拨2%。这5%（或更高比例）的承诺可能用于广泛的举措，涵盖科学与医学、生物安全、全球健康、经济研究项目，以及在美国境内或全球范围内广泛分配Anthropic股权所产生的经济价值。³</span></div><div style=position:absolute;left:40.32pt;top:453.96pt;width:258.84pt;height:122.04pt;background:#fff></div><div class=zhimg style="position:absolute;left:42.48pt;top:456.12pt;width:254.52pt;height:117.72pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>对于关注股权稀释的投资者，我们指出，该计划的规模和结构并未超出过去部分上市公司所提供的高管薪酬方案的范围。我们期望Anthropic的领导团队和员工受到该结构激励的程度，与其他公司领导者受到高管薪酬激励的程度相当。</span></div><div style=position:absolute;left:40.32pt;top:583.56pt;width:258.84pt;height:153.72pt;background:#fff></div><div class=zhimg style="position:absolute;left:42.48pt;top:585.72pt;width:254.52pt;height:149.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>尽管如此，Anthropic的员工和领导者都明白，我们的公共利益目标依靠商业成功以及客户的成功来推动。兼顾业务增长与公共影响，是我们自公司创立以来一直在把握的平衡，我们拥有良好的过往记录，证明两者可以兼得。我们对世界产生积极影响的能力，随我们作为一家成功公司的影响范围和地位而相应扩大。</span></div><div style=position:absolute;left:310.32pt;top:43.56pt;width:260.64pt;height:122.76pt;background:#fff></div><div class=zhimg style="position:absolute;left:312.48pt;top:45.72pt;width:256.32pt;height:118.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>我们的变革理论一直是我们所称的“向上竞争”：通过证明在以符合公共利益的方式行事的同时也能够在商业上取得成功，我们希望说服其他公司效仿。我们将会犯错，我们期望向他人学到的，与他人向我们学到的一样多。如果我们的竞争对手采纳并改进我们的做法，我们会将其视为一种成功。</span></div><div style=position:absolute;left:312.12pt;top:178.92pt;width:157.68pt;height:18pt;background:#fff></div><div class=zhimg style="position:absolute;left:313.92pt;top:180.72pt;width:154.08pt;height:14.4pt;display:flex;flex-direction:column;justify-content:center;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:11.52pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.2;font-style:normal"><span>关于投资者预期</span></div><div style=position:absolute;left:310.32pt;top:204.48pt;width:260.64pt;height:242.64pt;background:#fff></div><div class=zhimg style="position:absolute;left:312.48pt;top:206.64pt;width:256.32pt;height:238.32pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>在启动首次公开发行流程之前，我们与许多曾经历类似流程的企业领导者进行了交流。其中一条建议我们从多人口中以略有不同的形式听到，并一直铭记于心：“永远不要让您公司的估值比其实际价值高出哪怕一美元。”他们的意思是，如果人们基于您无法实现的预期，或基于对您将如何行事的错误预测而购买您公司的股票，将是非常危险的。这实际上与Anthropic的指导原则之一非常相似：“少承诺，多兑现”。这也类似于我们在招聘时的做法：我们向候选人进行“反向推销”，即一种刻意设计的说辞，使其对不适合Anthropic的人缺乏吸引力，同时对我们希望招聘的那类人具有吸引力。</span></div><div style=position:absolute;left:310.32pt;top:453.96pt;width:260.64pt;height:153.72pt;background:#fff></div><div class=zhimg style="position:absolute;left:312.48pt;top:456.12pt;width:256.32pt;height:149.4pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>本着这一精神，尽管我们相信AI作为一个领域（尤其是Anthropic）代表着历史上最重大的经济机遇之一，我们也认为，清楚说明我们的决策可能在哪些方面与投资者预期相悖十分重要。这些方面分为两类：源于AI迅猛的指数级发展轨迹、但孤立来看似乎奇怪或不合常规的商业押注，以及为恰当平衡公共利益而偏离利润最大化的决策。</span></div><div style=position:absolute;left:311.04pt;top:679.68pt;width:256.32pt;height:56.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:312.48pt;top:681.12pt;width:253.44pt;height:53.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:7.56pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.4;font-style:normal"><span>³ 该承诺是在前述两项承诺之外的额外承诺：Anthropic全体联合创始人承诺捐出我们个人股权的80%，以及接受我们捐赠匹配提议的员工所作的承诺；截至2026年6月30日，上述承诺分别相当于完全摊薄股份的9%和8%。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3974 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=a2026-10x25pg7a.jpg width=816 height=1056><div style=position:absolute;left:56.16pt;top:41.4pt;width:246.96pt;height:259.56pt;background:#fff></div><div class=zhimg style="position:absolute;left:58.32pt;top:43.56pt;width:242.64pt;height:255.24pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.8pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>在第一类情形中，Anthropic经常会进行前瞻性投资（尤其是在算力方面），这些投资乍看之下规模可能大得近乎不负责任。这源于我们基于规模定律所形成的判断：AI的经济价值正处于一条指数曲线上，因此我们产品在近期的预期经济价值将远高于其当前价值。为充分把握眼前的机遇，我们需要比身处技术变化较慢环境中的企业更积极地进行投资。制药公司是一个恰当的类比：研发往往需要非常大规模的前期投入，而这些投入要待日后成功药物带来回报时才显现其合理性。在Anthropic，类似的过程正以快得多的速度、大得多的规模发生。</span></div><div style=position:absolute;left:56.16pt;top:309.24pt;width:246.96pt;height:181.08pt;background:#fff></div><div class=zhimg style="position:absolute;left:58.32pt;top:311.4pt;width:242.64pt;height:176.76pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.8pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>我们始终愿意放弃部分上行收益，以换取下行保护，例如：在高估需求时设法转出多余算力；努力提高算力效率和运营效率，以增强我们的容错能力；或在必要时筹集资本，使我们免受需求暂时放缓的影响。但AI指数级增长带来的巨大上行可能性本身即伴随一定程度的风险。总体而言，我们将力求大胆而不失理智，以成功押注的往绩赢得信任。</span></div><div style=position:absolute;left:56.16pt;top:497.88pt;width:246.96pt;height:244.44pt;background:#fff></div><div class=zhimg style="position:absolute;left:58.32pt;top:500.04pt;width:242.64pt;height:240.12pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.8pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>与此相关，我们将不断寻求重塑自身业务，推出新类别的产品，目标是使现有产品的经济价值相形见绌。AI认知能力的进步正不断开辟新的产品类别，而这些产品即便在仅仅数月之前的模型上也尚不可行。例如，AI聊天机器人约在2022年变得可行，AI编程智能体约在2025年变得可行；面向通用知识工作和科学发现的AI智能体正于2026年逐步变得可行。与一般企业相比，我们通常会将较少精力投入于巩固现有产品和商业模式，而将更多精力投入于开创新的产品和商业模式，因为这正是该技术最大潜力之所在。</span></div><div style=position:absolute;left:325.44pt;top:41.4pt;width:244.8pt;height:65.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:327.6pt;top:43.56pt;width:240.48pt;height:60.84pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.8pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>在第二类情形中（偏离利润最大化），我们承诺在关键时刻坚守我们的价值观，即使这会令我们付出商业代价。</span></div><div style=position:absolute;left:325.44pt;top:114.12pt;width:244.8pt;height:228.6pt;background:#fff></div><div class=zhimg style="position:absolute;left:327.6pt;top:116.28pt;width:240.48pt;height:224.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.8pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>例如，在训练Claude Mythos Preview（我们当时构建的能力最强的模型）时，我们判断其能力（尤其是在网络安全方面）已发展到这样的程度：若在没有新安全保障措施的情况下广泛发布，将会带来重大风险。因此，我们选择不将其全面开放，而是在构建了额外的安全保障措施之后，才以Claude Fable 5的形式向公众提供其能力。这一延迟意味着放弃可观的收入并将市场让与竞争对手（我们还向网络防御者赠送了约1亿美元的Claude额度），但我们认为这是正确的决定，并预计随着我们的模型能力不断增强，我们还将再次面临类似的抉择。</span></div><div style=position:absolute;left:325.44pt;top:348.84pt;width:244.8pt;height:167.76pt;background:#fff></div><div class=zhimg style="position:absolute;left:327.6pt;top:351pt;width:240.48pt;height:163.44pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.8pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>我们还承诺让Claude不含广告。广告为现代互联网的大部分内容提供资金，并且很可能会成为我们的一大收入来源。但人们会把一些最重要的工作和最私人的问题交给Claude，我们希望Claude唯一的激励就是为他们提供有帮助的回答。一旦广告成为公司收入目标的一部分，针对用户参与度进行优化的压力往往会随之增大。我们已选择不将这种压力引入Claude。</span></div><div style=position:absolute;left:310.32pt;top:524.16pt;width:259.92pt;height:213.12pt;background:#fff></div><div class=zhimg style="position:absolute;left:312.48pt;top:526.32pt;width:255.6pt;height:208.8pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.8pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.5;font-style:normal"><span>在权衡公共利益时，AI进步的速度是一个尤为重要的方面。快速推进能让AI的益处更早到来，但推进过快可能会超出世界确保AI系统安全的能力。安全地构建AI可能需要Anthropic（理想情况下还有业内其他公司）调节AI能力复合增长的极快速度，尤其是在这种增长由AI系统自我构建所驱动时。尽管从绝对意义上看，进步仍将非常迅速——可能比现在快得多——但有时我们可能会选择以低于自身能力所及的速度推进，以使我们的系统更加安全，即使这会令我们处于竞争劣势。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:792pt><div style=width:612pt></div></div><div style=position:absolute><div style=width:612pt></div></div><div><div id=ica694c859b8e458dbf6a73f56dde9d42_3969 style=position:absolute;top:0></div><div style=position:absolute;width:612pt><div style=position:absolute><div style=position:absolute><div style=position:relative;width:612pt;height:792pt;overflow:hidden><img style=display:block;height:792pt;width:612pt src="data:image/jpeg;base64," alt=a2026-10x25pg8a.jpg width=816 height=1056><div style=position:absolute;left:41.04pt;top:44.64pt;width:260.64pt;height:226.8pt;background:#fff></div><div class=zhimg style="position:absolute;left:42.48pt;top:46.08pt;width:257.76pt;height:223.92pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.44;font-style:normal"><span>我们所有人都真诚地相信，AI的指数级发展将创造巨大的价值，从长远来看，这些价值将远远超过我们为践行使命而作出的任何短期经济牺牲。我们也认为，我们出于公共利益而作出的部分决策，可能通过增进客户、政府、员工及广大公众对我们的信任和公信力，从长期来看有利于业务发展——尽管这并非我们作出这些决策的根本原因。尽管如此，我们认为有必要坦诚说明我们的决策方式，并合理设定预期。如果所有相关方都对我们的运营方式达成共识，且不会对我们的选择感到意外，我们和我们的投资者将走得更加顺畅。</span></div><div style=position:absolute;left:311.04pt;top:43.92pt;width:258.48pt;height:122.4pt;background:#fff></div><div class=zhimg style="position:absolute;left:312.48pt;top:45.36pt;width:255.6pt;height:119.52pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.44;font-style:normal"><span>作为身处这一时刻最核心位置的公司之一，我们拥有一个难得的机会，推动其朝着更好的方向发展。我们的目标是帮助人类在这场技术演进中走出一条安全的道路，开拓新的探索前沿，并开创一个奇迹的时代。每一位持有我们股票的人，无论是机构还是个人，都由此成为这一努力的一部分。我们希望您与我们怀有共同的抱负，将这一事业进行到底。</span></div><div style=position:absolute;left:41.04pt;top:283.68pt;width:108pt;height:19.44pt;background:#fff></div><div class=zhimg style="position:absolute;left:42.48pt;top:285.12pt;width:105.12pt;height:16.56pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:pingfang sc,noto sans sc,noto sans cjk sc,microsoft yahei,sans-serif;font-size:11.52pt;font-weight:700;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.3;font-style:normal"><span>结语</span></div><div style=position:absolute;left:40.68pt;top:309.6pt;width:257.4pt;height:92.16pt;background:#fff></div><div class=zhimg style="position:absolute;left:42.12pt;top:311.04pt;width:254.52pt;height:89.28pt;display:flex;flex-direction:column;justify-content:flex-start;white-space:pre-wrap;word-break:break-word;font-family:songti sc,stsong,noto serif sc,noto serif cjk sc,serif;font-size:10.44pt;font-weight:400;color:#141413;text-align:left;text-align-last:auto;text-indent:0;letter-spacing:normal;word-spacing:normal;line-height:1.44;font-style:normal"><span>然而，从更广泛的意义上说，我们鼓励作为我们股票潜在持有人的您，不要纯粹从交易的角度看待这次购买。我们希望您将其视为参与一项更宏大事业的机会。机器智能的到来是人类历史上具有划时代意义的时刻之一。</span></div></div></div></div></div></div></div><div class=s1-sheet style="--justify:justify;--position:absolute;background-color:#fff;border:1px solid #cccc;content-visibility:auto;float:none;font-size:0;height:792pt;margin:10px auto;overflow:hidden;padding:0;position:relative;width:612pt"><div style=position:absolute;top:720pt><div style=width:468pt><div style=font-size:12pt;line-height:7.18pt;position:absolute;top:22.27pt;width:612pt><div class=zh style="position:absolute;top:-2.35pt;left:0;width:612pt;line-height:11.88pt;font-family:georgia,songti sc,stsong,noto serif cjk sc,source han serif sc,simsun,serif;font-size:9.5pt;font-style:normal;font-weight:400;text-decoration:none;text-indent:0;text-align:center;text-align-last:center;white-space:normal;word-break:break-word;line-break:strict">i</div></div></div></div><div style=position:absolute><div style=width:468pt><div style=font-size:12pt;line-height:6.46pt;position:absolute;top:13.5pt;width:612pt><div class=zh style="position:absolute;top:-2.4pt;left:72pt;width:468pt;line-height:11.25pt;font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f;text-indent:0;text-align:left;text-align-last:left;white-space:normal;word-break:break-word;line-break:strict"><span style="font-family:helvetica,pingfang sc,hiragino sans gb,noto sans cjk sc,microsoft yahei,sans-serif;font-size:9pt;font-style:normal;font-weight:700;text-decoration:underline;color:#00f"><a href=#if79d5262bb1f4e24ac84b67b9de9b345_12633 style=color:in